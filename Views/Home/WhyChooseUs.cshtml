<style>
    :root {
        --brt-gold: #D4AF37;
        --brt-gold-dark: #AA820A;
        --brt-gold-light: #FBF5E8;
        --dark-bg: #0F172A;
        --card-bg: #FFFFFF;
        --text-main: #1E293B;
        --text-muted: #64748B;
        --border-color: #E2E8F0;
        --glow-shadow: 0 20px 40px -15px rgba(212, 175, 55, 0.25);
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: var(--text-main);
        background-color: #FAFAFA;
        overflow-x: hidden;
    }

    /* Hero Section */
    .premium-hero {
        padding: 70px 20px 50px;
        background: radial-gradient(circle at 50% 0%, rgba(212, 175, 55, 0.15) 0%, transparent 60%),
                    radial-gradient(circle at 90% 80%, rgba(15, 23, 42, 0.05) 0%, transparent 50%);
        position: relative;
    }

    .hero-badge {
        background: linear-gradient(135deg, rgba(212, 175, 55, 0.15) 0%, rgba(170, 130, 10, 0.1) 100%);
        border: 1px solid rgba(212, 175, 55, 0.3);
        color: var(--brt-gold-dark);
        padding: 8px 20px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.85rem;
        display: inline-block;
        margin-bottom: 1.2rem;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        box-shadow: 0 4px 15px rgba(212, 175, 55, 0.1);
    }

    .premium-hero h1 {
        font-weight: 800;
        color: var(--dark-bg);
        font-size: clamp(2.2rem, 5vw, 3.2rem);
        letter-spacing: -0.8px;
        line-height: 1.2;
    }

    /* Feature Cards Design */
    .innovative-grid .category-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 24px;
        padding: 2.2rem 1.8rem;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        overflow: hidden;
        z-index: 1;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.03);
    }

    .innovative-grid .category-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
        z-index: -1;
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    .innovative-grid .category-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.25);
        border-color: transparent;
    }

    .innovative-grid .category-card:hover::before {
        opacity: 1;
    }

    /* Category Icons */
    .category-icon {
        width: 64px;
        height: 64px;
        background: var(--brt-gold-light);
        border: 1px solid rgba(212, 175, 55, 0.3);
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.5rem;
        transition: all 0.4s ease;
    }

    .category-icon span {
        font-size: 2rem;
        color: var(--brt-gold-dark);
        transition: all 0.4s ease;
    }

    .category-card:hover .category-icon {
        background: rgba(212, 175, 55, 0.25);
        border-color: var(--brt-gold);
        transform: scale(1.08) rotate(-3deg);
    }

    .category-card:hover .category-icon span {
        color: var(--brt-gold);
    }

    .category-card h5 {
        font-weight: 700;
        font-size: 1.25rem;
        margin-bottom: 0.8rem;
        color: var(--dark-bg);
        transition: color 0.3s ease;
    }

    .category-card p {
        color: var(--text-muted);
        font-size: 0.95rem;
        line-height: 1.6;
        transition: color 0.3s ease;
    }

    .category-card:hover h5 {
        color: #FFFFFF;
    }

    .category-card:hover p {
        color: #94A3B8;
    }

    /* Pipeline Desktop Layout */
    .qa-section-title {
        font-weight: 800;
        font-size: clamp(1.8rem, 4vw, 2.4rem);
        color: var(--dark-bg);
        margin-bottom: 3rem;
    }

    .pipeline-wrapper {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1.5rem;
        position: relative;
    }

    .pipeline-node {
        flex: 1;
        min-width: 200px;
        max-width: 240px;
        text-align: center;
        position: relative;
        background: #FFFFFF;
        border: 1px solid var(--border-color);
        padding: 1.8rem 1.2rem;
        border-radius: 20px;
        transition: all 0.3s ease;
    }

    .pipeline-node:hover {
        border-color: var(--brt-gold);
        box-shadow: var(--glow-shadow);
        transform: translateY(-5px);
    }

    .info-icon-circle {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #FBF5E8 0%, #FFFFFF 100%);
        border: 2px dashed var(--brt-gold);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.2rem;
        position: relative;
        transition: all 0.4s ease;
    }

    .info-icon-circle span {
        font-size: 2.2rem;
        color: var(--brt-gold-dark);
    }

    .pipeline-node:hover .info-icon-circle {
        background: var(--dark-bg);
        border-style: solid;
        transform: rotate(360deg);
    }

    .pipeline-node:hover .info-icon-circle span {
        color: var(--brt-gold);
    }

    .pipeline-node h5 {
        font-weight: 700;
        font-size: 1.1rem;
        color: var(--dark-bg);
        margin-bottom: 0.5rem;
    }

    .pipeline-node p {
        font-size: 0.88rem;
        color: var(--text-muted);
        line-height: 1.5;
        margin: 0;
    }

    /* CTA Button Design */
    .btn-brt-gold {
        background: linear-gradient(135deg, var(--brt-gold) 0%, var(--brt-gold-dark) 100%);
        color: #FFFFFF !important;
        font-weight: 800;
        padding: 16px 42px;
        border-radius: 50px;
        border: none;
        letter-spacing: 0.5px;
        box-shadow: 0 12px 25px rgba(212, 175, 55, 0.3);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        display: inline-block;
        text-decoration: none;
    }

    .btn-brt-gold:hover {
        transform: translateY(-4px) scale(1.02);
        box-shadow: 0 18px 35px rgba(212, 175, 55, 0.45);
    }

    /* ==========================================================
       📱 MOBILE APP HORIZONTAL SCROLL ENGINE (100% FIXED)
       ========================================================== */
    @@media (max-width: 991.98px) {
        .premium-hero {
            padding: 50px 15px 35px;
        }

        /* Mobile Scroll Engine Container Override */
        .brt-mobile-scroll {
            display: flex !important;
            flex-direction: row !important;
            flex-wrap: nowrap !important;
            overflow-x: auto !important;
            overflow-y: hidden !important;
            -webkit-overflow-scrolling: touch !important;
            scroll-snap-type: x mandatory !important;
            padding: 15px 15px 25px 15px !important;
            gap: 16px !important;
            width: 100% !important;
            margin-left: 0 !important;
            margin-right: 0 !important;
            box-sizing: border-box !important;
        }

        /* Hide Scrollbar */
        .brt-mobile-scroll::-webkit-scrollbar {
            display: none !important;
        }

        /* Mobile Slide Card Engine Override */
        .brt-mobile-card {
            flex: 0 0 82% !important;
            max-width: 82% !important;
            width: 82% !important;
            scroll-snap-align: start !important;
            box-sizing: border-box !important;
        }

        .pipeline-node {
            max-width: 82% !important;
        }

        .btn-brt-gold {
            width: 100%;
            text-align: center;
        }
    }
</style>

