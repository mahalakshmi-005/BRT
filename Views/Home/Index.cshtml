                </span>
            </a>
        </div>

        <div class="col-12 col-md-6">
            <a asp-controller="Order" asp-action="Request" class="portfolio-box" style="background: linear-gradient(135deg, #1C2638 0%, #141C2B 100%); border-color: rgba(197,155,39,0.3);">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="material-symbols-outlined text-warning fs-3">local_shipping</span>
                    <span class="badge bg-warning text-dark fw-bold extra-small">Direct Mandi</span>
                </div>
