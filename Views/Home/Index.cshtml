                        <img src="~/images/hero.png" alt="Garlic Wholesale Mandi" class="img-fluid rounded-3 object-fit-cover" style="max-height: 260px; width: 100%;" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1618160702438-9b02ab6515c9?auto=format&fit=crop&w=800&q=80';" />
                    </div>
