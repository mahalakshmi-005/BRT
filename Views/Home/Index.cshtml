@{
    ViewData["Title"] = "B RAJ TRADERS | Premium Wholesale Mandi";
}

<style>
    :root {
        /* Premium Color Palette */
        --brt-navy: #0D131F;
        --brt-navy-light: #182232;
        --brt-gold: #D4AF37;
        --brt-gold-light: #F3E5AB;
        --brt-gold-glow: rgba(212, 175, 55, 0.35);
        --brt-card-bg: #FFFFFF;
        
        /* Native App & Modern Variables */
        --brt-app-radius: 20px;
        --brt-glass-border: rgba(212, 175, 55, 0.25);
        --brt-glass-bg: rgba(13, 19, 31, 0.92);
    }

    /* Keyframe Animations */
    @@keyframes floatIcon {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-4px); }
    }
    @@keyframes pulseGlow {
        0% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.6); }
        70% { box-shadow: 0 0 0 8px rgba(220, 53, 69, 0); }
        100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
    }

    /* Base Styling */
    body {
        overflow-x: hidden;
        background-color: #F8FAFC;
        padding-bottom: 70px;
        -webkit-tap-highlight-color: transparent;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    /* Quick Category Horizontal Chips */
    .app-chip-bar {
        display: flex;
        overflow-x: auto;
        white-space: nowrap;
        gap: 8px;
        padding: 10px 16px;
        scrollbar-width: none;
    }
    .app-chip-bar::-webkit-scrollbar { display: none; }
    .app-chip {
        background: #FFFFFF;
        border: 1px solid rgba(13,19,31,0.08);
        border-radius: 50px;
        padding: 6px 14px;
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--brt-navy);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.03);
        transition: all 0.2s ease;
    }
    .app-chip:active {
        transform: scale(0.95);
        background: var(--brt-gold);
        color: var(--brt-navy);
    }

    /* ===================================================
       1. INNOVATIVE APP-STYLE LIVE MARKET BOARD
    =================================================== */
    .live-market-container {
        background: radial-gradient(circle at 50% 0%, #182232 0%, #0D131F 100%);
        border-radius: 24px;
        border: 1px solid var(--brt-glass-border);
        position: relative;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(13, 19, 31, 0.2);
    }
    .live-rate-card-app {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        padding: 12px 14px;
        transition: all 0.25 ease;
        height: 100%;
    }
    .live-rate-card-app:hover {
        background: rgba(255, 255, 255, 0.09);
        border-color: var(--brt-gold);
    }

    /* ===================================================
       2. INNOVATIVE CATALOG (APP & DESKTOP DUAL VIEW)
    =================================================== */
    .app-catalog-card {
        background: #FFFFFF;
        border-radius: 20px;
        border: 1px solid rgba(13, 19, 31, 0.08);
        transition: all 0.25s cubic-bezier(0.165, 0.84, 0.44, 1);
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
    }
    .app-catalog-card:hover {
        transform: translateY(-4px);
        border-color: var(--brt-gold);
        box-shadow: 0 12px 28px rgba(13, 19, 31, 0.08), 0 0 15px var(--brt-gold-glow);
    }
    .app-catalog-card .img-box {
        background: linear-gradient(135deg, #F8FAFC 0%, #F1F5F9 100%);
        border-radius: 16px;
        position: relative;
        height: 140px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* ===================================================
       3. INNOVATIVE SUPPLY PORTFOLIO (APP TILES)
    =================================================== */
    .portfolio-app-tile {
        background: #0D131F;
        border-radius: 20px;
        border: 1px solid var(--brt-glass-border);
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
        min-height: 180px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 1.25rem;
    }
    .portfolio-app-tile::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(13, 19, 31, 0.1) 0%, rgba(13, 19, 31, 0.95) 100%);
        z-index: 1;
    }
    .portfolio-app-tile:hover {
        transform: translateY(-4px);
        border-color: var(--brt-gold);
        box-shadow: 0 12px 25px rgba(13, 19, 31, 0.25);
    }

    /* ===================================================
       4. PARTNERS & INDUSTRIES CARD (CLEAN APP GRID)
    =================================================== */
    .partner-app-card {
        background: #FFFFFF;
        border: 1px solid rgba(13, 19, 31, 0.08);
        border-radius: 18px;
        padding: 14px 10px;
        transition: all 0.25s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 100%;
    }
    .partner-app-card:hover {
        border-color: var(--brt-gold);
        transform: translateY(-3px);
        box-shadow: 0 8px 18px rgba(13, 19, 31, 0.05);
    }
    .partner-app-card .icon-circle {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: rgba(212, 175, 55, 0.12);
        color: var(--brt-gold);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Helpers */
    .anim-float-icon { animation: floatIcon 3s ease-in-out infinite; display: inline-block; }
    .pulse-dot { width: 8px; height: 8px; background-color: #DC3545; border-radius: 50%; animation: pulseGlow 1.8s infinite; }
    .text-navy { color: var(--brt-navy) !important; }
    .text-gold { color: var(--brt-gold) !important; }
    .bg-navy { background-color: var(--brt-navy) !important; }
    .bg-gold { background-color: var(--brt-gold) !important; }
    .extra-small { font-size: 0.78rem; letter-spacing: 0.02em; }
    .btn-brt-gold {
        background: linear-gradient(135deg, #D4AF37 0%, #C59B27 100%);
        color: #0D131F !important;
        font-weight: 700;
        border: none;
        border-radius: 50px;
        box-shadow: 0 4px 14px rgba(212, 175, 55, 0.25);
        transition: all 0.2s ease;
    }
    .btn-brt-gold:active { transform: scale(0.96); }
    .btn-brt-outline {
        border: 1.5px solid var(--brt-navy);
        color: var(--brt-navy) !important;
        font-weight: 600;
        border-radius: 50px;
        transition: all 0.2s ease;
    }
</style>

<!-- ===== ANNOUNCEMENT BAR ===== -->
<div class="top-announcement-bar text-white py-2 px-3" style="background: linear-gradient(90deg, #0D131F 0%, #182232 50%, #0D131F 100%); border-bottom: 1px solid var(--brt-glass-border);">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2 overflow-hidden me-2">
            <div class="text-truncate extra-small text-gold-light fw-bold">
                <span class="lang-en-text">✨ For Dealership &amp; Wholesale:</span>
                <span class="lang-ta-text">✨ டீலர்ஷிப் &amp; மொத்த விற்பனைக்கு:</span>
            </div>
        </div>
        <div class="flex-shrink-0">
            <a href="tel:9865680694" class="btn btn-sm btn-brt-gold py-1 px-3 d-inline-flex align-items-center gap-1.5 extra-small fw-bold rounded-pill shadow-sm">
                <span class="material-symbols-outlined fs-6">call</span>
                <span class="lang-en-text">Call</span>
                <span class="lang-ta-text">தொடர்புக்கு</span>
            </a>
        </div>
    </div>
</div>

<!-- ===== Quick Navigation Chips ===== -->
<div class="bg-white border-bottom shadow-sm">
    <div class="app-chip-bar">
        <a href="#live-rates" class="app-chip">
            <span class="material-symbols-outlined fs-6 text-gold">monitoring</span> Live Rates
        </a>
        <a href="#products" class="app-chip">
            <span class="material-symbols-outlined fs-6 text-gold">inventory_2</span> Catalog
        </a>
        <a href="#portfolio" class="app-chip">
            <span class="material-symbols-outlined fs-6 text-gold">grid_view</span> Categories
        </a>
        <a href="#partners" class="app-chip">
            <span class="material-symbols-outlined fs-6 text-gold">domain</span> Clients
        </a>
        <a href="#why-us" class="app-chip">
            <span class="material-symbols-outlined fs-6 text-gold">verified</span> Why Us
        </a>
    </div>
</div>

<!-- ===== Hero Section ===== -->
