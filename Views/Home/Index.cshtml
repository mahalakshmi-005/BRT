@{
    ViewData["Title"] = "B RAJ TRADERS | Premium Wholesale Mandi";
}

<!-- ===== Ultra-Luxury Modern Executive UI (Mobile-First Engineered) ===== -->
<style>
    :root {
        /* Color Palette */
        --brt-navy: #0D131F;
        --brt-navy-light: #182232;
        --brt-gold: #D4AF37;
        --brt-gold-light: #F3E5AB;
        --brt-gold-glow: rgba(212, 175, 55, 0.25);
        --brt-card-bg: #FFFFFF;
        
        /* Glassmorphism Variables */
        --brt-glass-border: rgba(212, 175, 55, 0.2);
        --brt-glass-bg: rgba(13, 19, 31, 0.85);
    }

    /* Keyframe Animations (Razor Escaped @@) */
    @@keyframes floatIcon {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-5px) rotate(1deg); }
    }
    @@keyframes pulseGlow {
        0% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.4); }
        70% { box-shadow: 0 0 0 10px rgba(212, 175, 55, 0); }
        100% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0); }
    }

    /* Base Layout Hacks */
    body {
        overflow-x: hidden;
    }
    .row-equal-height {
        display: flex;
        flex-wrap: wrap;
    }
    .row-equal-height > [class*='col-'] {
        display: flex;
        flex-direction: column;
    }

    /* Mobile Horizontal Snap Carousel */
    .mobile-scroll-container {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        gap: 1rem;
        padding-bottom: 1rem;
        padding-left: 0.25rem;
        padding-right: 0.25rem;
    }
    .mobile-scroll-container::-webkit-scrollbar {
        height: 4px;
    }
    .mobile-scroll-container::-webkit-scrollbar-thumb {
        background: var(--brt-gold);
        border-radius: 10px;
    }
    .mobile-scroll-item {
        flex: 0 0 82%;
        scroll-snap-align: center;
    }
    @@media (min-width: 768px) {
        .mobile-scroll-container {
            display: flex;
            flex-wrap: wrap;
            overflow-x: visible;
            padding-bottom: 0;
            gap: 0;
        }
        .mobile-scroll-item {
            flex: 0 0 auto;
        }
    }

    /* High-End Innovative Card */
    .innovative-card {
        background: var(--brt-card-bg);
        border: 1px solid rgba(13, 19, 31, 0.08);
        border-radius: 20px;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        position: relative;
        overflow: hidden;
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .innovative-card:hover {
        transform: translateY(-6px);
        border-color: var(--brt-gold) !important;
        box-shadow: 0 15px 30px -10px rgba(13, 19, 31, 0.08), 0 0 20px var(--brt-gold-glow) !important;
    }

    /* Bento Hero Cards */
    .portfolio-card-hero {
        background: var(--brt-navy);
        border-radius: 22px;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        position: relative;
        overflow: hidden;
        z-index: 1;
        width: 100%;
        min-height: 260px;
        border: 1px solid var(--brt-glass-border);
    }
    .portfolio-card-hero::after {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at top right, rgba(212, 175, 55, 0.15), transparent 60%);
        z-index: 0;
    }
    .portfolio-card-hero:hover {
        transform: translateY(-5px);
        border-color: var(--brt-gold);
        box-shadow: 0 20px 40px -12px rgba(13, 19, 31, 0.35);
    }

    /* Image Zoom Box */
    .img-zoom-container {
        overflow: hidden;
        border-radius: 16px;
        position: relative;
    }
    .img-zoom-container img {
        transition: transform 0.6s ease;
        width: 100%;
        object-fit: cover;
    }
    .innovative-card:hover .img-zoom-container img {
        transform: scale(1.06);
    }

    /* Utility Helpers */
    .anim-float-icon { animation: floatIcon 4s ease-in-out infinite; display: inline-block; }
    .pulse-badge { animation: pulseGlow 2.5s infinite; }
    .text-navy { color: var(--brt-navy) !important; }
    .text-gold { color: var(--brt-gold) !important; }
    .bg-navy { background-color: var(--brt-navy) !important; }
    .bg-gold { background-color: var(--brt-gold) !important; }
    .extra-small { font-size: 0.78rem; letter-spacing: 0.03em; }

    /* Custom Glass Effect */
    .bg-glass {
        background: var(--brt-glass-bg);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--brt-glass-border);
    }

    /* Premium Button Styles */
    .btn-brt-gold {
        background: linear-gradient(135deg, #D4AF37 0%, #C59B27 100%);
        color: #0D131F !important;
        font-weight: 700;
        border: none;
        border-radius: 50px;
        transition: all 0.3s ease;
        box-shadow: 0 6px 18px rgba(212, 175, 55, 0.25);
    }
    .btn-brt-gold:hover {
        background: linear-gradient(135deg, #E2BD45 0%, #D4AF37 100%);
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(212, 175, 55, 0.35);
    }
    .btn-brt-outline {
        border: 1.5px solid var(--brt-navy);
        color: var(--brt-navy) !important;
        font-weight: 600;
        border-radius: 50px;
        transition: all 0.3s ease;
    }
    .btn-brt-outline:hover {
        background: var(--brt-navy);
        color: #FFFFFF !important;
    }

    /* Mobile Responsive Specific Adjustments */
    @@media (max-width: 576px) {
        .display-4 { font-size: 2.3rem !important; }
        .hero-cta .btn { width: 100%; text-align: center; justify-content: center; }
        .hero-inline-stats { justify-content: space-between; }
        .hero-inline-stats .fs-2 { font-size: 1.5rem !important; }
        .mobile-badge-stack {
            position: relative !important;
            transform: none !important;
            margin-top: 10px !important;
        }
    }
</style>

