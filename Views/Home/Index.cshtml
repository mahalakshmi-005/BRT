        <div class="row g-2">
            <div class="col-6"><div class="p-2 border rounded text-center"><span class="fs-5">✨</span><h6 class="fw-bold text-navy extra-small mb-0">Strict Grading</h6></div></div>
            <div class="col-6"><div class="p-2 border rounded text-center"><span class="fs-5">🚚</span><h6 class="fw-bold text-navy extra-small mb-0">Safe Transport</h6></div></div>
        </div>
    </div>
</section>
