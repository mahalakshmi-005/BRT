            <p class="text-muted mx-auto mb-0 extra-small fs-md-6" style="max-width:550px">Real-time daily rates synchronized directly with primary mandi auctions.</p>
        </div>

        <div class="row g-2 g-md-3 row-equal-height">
            @if (dashboard != null && dashboard.Any())
            {
                foreach (var m in dashboard)
                {
