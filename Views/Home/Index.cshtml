                    <div class="position-absolute top-0 start-0 translate-middle-y p-2.5 p-md-3 rounded-4 shadow-sm d-flex align-items-center gap-2.5 mobile-badge-stack" style="background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(12px); border: 1px solid rgba(212, 175, 55, 0.25); z-index: 2;">
                        <span class="material-symbols-outlined fs-4 text-gold">workspace_premium</span>
                        <div class="text-start">
                            <span class="d-block fw-bold text-dark extra-small">100% Quality Assurance</span>
                            <span class="d-block text-muted" style="font-size:0.7rem;">Direct Mandi Fresh</span>
                        </div>
