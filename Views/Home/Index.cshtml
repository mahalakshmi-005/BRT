<!-- ===== Featured Products Showcase (Mobile Touch Swipe) ===== -->
@{
    var featured = ViewBag.FeaturedProducts as List<BRT.Models.Product>;
}
@if (featured != null && featured.Any())
{
    <section class="container my-4 my-md-5 py-2">
        <div class="text-center mb-4 mb-md-5">
            <span class="hero-eyebrow fw-semibold text-uppercase tracking-wider small d-inline-flex align-items-center gap-1.5 text-gold">
                <span class="material-symbols-outlined fs-6 anim-float-icon">workspace_premium</span> OUR PRODUCTS
            </span>
            <h2 class="fw-bold mt-1 text-navy fs-3 fs-md-2">Premium Wholesale Selection</h2>
            <p class="text-muted mx-auto extra-small fs-md-6" style="max-width:550px">Top-tier mandi produce direct to distributors, hotels, and bulk retailers.</p>
        </div>

        <div class="mobile-scroll-container row-equal-height">
            @foreach (var p in featured)
            {
                <div class="mobile-scroll-item col-lg-4 col-md-6">
                    <div class="innovative-card p-3 d-flex flex-column justify-content-between h-100">
                        <div>
                            <div class="img-zoom-container bg-light text-center py-3 px-2 position-relative d-flex align-items-center justify-content-center" style="min-height: 180px; background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);">
                                @if (!string.IsNullOrEmpty(p.ImageUrl))
                                {
                                    <img src="@p.ImageUrl" alt="@p.Name" class="img-fluid object-fit-contain" style="max-height: 150px;" />
                                }
                                else
                                {
                                    <div class="rounded-circle p-3 bg-white shadow-sm text-navy anim-float-icon">
                                        <span class="material-symbols-outlined display-5">
                                            @(p.SubCategory?.Category?.Type == BRT.Models.CategoryType.Garlic ? "eco" : "shopping_cart_checkout")
                                        </span>
                                    </div>
                                }
                                <span class="badge position-absolute top-0 start-0 m-2.5 px-2.5 py-1.5 rounded-pill shadow-sm bg-navy text-white" style="font-size: 0.7rem; border: 1px solid rgba(212,175,55,0.3);">
                                    @(p.SubCategory?.Name ?? "General")
                                </span>
                            </div>
                            <div class="pt-3 px-1">
                                <h4 class="card-title h6 fw-bold mb-1 text-navy">
                                    <span>@p.Name</span>
                                </h4>
                                @if (!string.IsNullOrEmpty(p.NameTamil))
                                {
                                    <span class="d-block text-muted extra-small fw-medium mb-1">@p.NameTamil</span>
                                }
                                <p class="card-text text-muted extra-small lh-base">
                                    @(string.IsNullOrEmpty(p.Description) ? "Standard commercial bulk packaging with fresh mandi stock." : p.Description)
                                </p>
                            </div>
                        </div>
                        <div class="pt-2 px-1 mt-2 border-top d-flex justify-content-between align-items-center">
                            <span class="badge bg-light text-dark border px-2 py-1 rounded-pill extra-small fw-semibold">
                                Fresh Stock
                            </span>
                            <a asp-controller="Catalog" asp-action="Product" asp-route-slug="@p.Slug" class="btn btn-sm btn-outline-dark rounded-pill px-3 extra-small fw-semibold d-inline-flex align-items-center gap-1">
                                Details <span class="material-symbols-outlined fs-6">arrow_forward</span>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-brt-outline px-4 py-2 shadow-sm extra-small fw-bold">View Full Catalog</a>
        </div>
    </section>
}

<!-- ===== Live Market Dashboard (Adaptive Matrix Grid) ===== -->
@{
    var dashboard = ViewBag.MarketDashboard as List<BRT.Models.MarketPrice>;
}
<section class="container my-4 my-md-5 py-2">
    <div class="p-3 p-md-5 rounded-4 shadow-sm border" style="background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%); border-color: rgba(212, 175, 55, 0.15) !important;">
        <div class="text-center mb-4">
            <span class="hero-eyebrow fw-semibold text-uppercase tracking-wider small d-inline-flex align-items-center gap-1.5 text-gold">
                <span class="material-symbols-outlined fs-6 anim-float-icon">trending_up</span> LIVE MARKET
            </span>
