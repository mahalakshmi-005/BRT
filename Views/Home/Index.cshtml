</section>

<!-- ===== 2. ULTRA INNOVATIVE: LIVE MARKET BOARD ===== -->
@{
    var dashboard = ViewBag.MarketDashboard as List<BRT.Models.MarketPrice>;
}
<section id="live-rates" class="container my-4 my-md-5 py-2">
    <div class="live-market-container p-3 p-md-4 text-white">
        <!-- Live Header -->
        <div class="d-flex flex-row justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-25">
            <div class="d-flex align-items-center gap-2">
                <span class="pulse-dot"></span>
                <h2 class="fw-bold mb-0 text-white fs-5 fs-md-3" style="font-family: 'Playfair Display', serif;">
                    Today's Live Mandi Rates
                </h2>
            </div>
            <span class="badge bg-gold text-dark extra-small fw-bold d-inline-flex align-items-center gap-1">
                <span class="material-symbols-outlined fs-6">sync</span> REALTIME
            </span>
        </div>

        <!-- Mobile & Laptop Responsive Grid -->
        <div class="row g-2.5">
            @if (dashboard != null && dashboard.Any())
            {
                foreach (var m in dashboard)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="live-rate-card-app">
                            <div class="d-flex align-items-center justify-content-between mb-1.5">
                                <span class="p-1 rounded-circle bg-gold bg-opacity-20 text-gold d-inline-flex">
                                    <span class="material-symbols-outlined fs-6">
                                        @(m.Product?.SubCategory?.Category?.Type == BRT.Models.CategoryType.Garlic ? "eco" : "shopping_bag")
                                    </span>
                                </span>
                                <span class="extra-small text-gold fw-bold" style="font-size:0.65rem;">
                                    <span class="material-symbols-outlined fs-6 align-middle">verified</span> Verified
                                </span>
                            </div>
                            <h6 class="fw-bold text-white text-truncate mb-0 extra-small">@m.Product?.Name</h6>
                            <span class="text-muted d-block extra-small text-truncate mb-2" style="font-size:0.65rem;">@m.Product?.NameTamil</span>

                            <div class="pt-1 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-baseline">
                                <span class="fw-bold text-gold fs-6">₹@m.TodayPrice.ToString("N0")</span>
                                <span class="text-muted extra-small" style="font-size:0.65rem;">/ Bag</span>
                            </div>
                        </div>
                    </div>
                }
            }
            <div class="col-12 col-md-4 col-lg-3">
                <div class="live-rate-card-app d-flex flex-row flex-md-column align-items-center justify-content-between text-start text-md-center p-2.5" style="background: linear-gradient(135deg, rgba(212,175,55,0.2) 0%, rgba(13,19,31,0.6) 100%);">
                    <div class="d-flex align-items-center gap-2 mb-md-1">
                        <span class="material-symbols-outlined text-gold fs-4 anim-float-icon">request_quote</span>
                        <div>
                            <h6 class="fw-bold text-white extra-small mb-0">Custom Bulk Quote?</h6>
                            <span class="text-muted extra-small d-md-block" style="font-size:0.65rem;">Direct Mandi Price</span>
                        </div>
                    </div>
                    <a asp-controller="Order" asp-action="Request" class="btn btn-sm btn-brt-gold px-3 py-1 extra-small fw-bold">Get Price</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== 3. INNOVATIVE APP CATALOG (PRODUCTS) ===== -->
@{
    var featured = ViewBag.FeaturedProducts as List<BRT.Models.Product>;
}
@if (featured != null && featured.Any())
{
    <section id="products" class="container my-4 my-md-5 py-2">
        <div class="d-flex justify-content-between align-items-end mb-3">
            <div>
                <span class="fw-bold text-uppercase tracking-wider extra-small text-gold d-inline-flex align-items-center gap-1">
                    <span class="material-symbols-outlined fs-6 anim-float-icon">workspace_premium</span>
                    <span>WHOLESALE CATALOG</span>
                </span>
                <h2 class="fw-bold text-navy fs-4 fs-md-2 mb-0">Featured Stock Produce</h2>
            </div>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-sm btn-brt-outline px-3 py-1 extra-small fw-bold">
                View All
            </a>
        </div>

        <div class="row g-2.5 g-md-3">
            @foreach (var p in featured)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="app-catalog-card p-2.5 p-md-3">
                        <div>
                            <div class="img-box mb-2">
                                @if (!string.IsNullOrEmpty(p.ImageUrl))
                                {
                                    <img src="@p.ImageUrl" alt="@p.Name" class="img-fluid object-fit-contain p-2" style="max-height: 110px;" />
                                }
                                else
                                {
                                    <span class="material-symbols-outlined fs-1 text-gold">
                                        @(p.SubCategory?.Category?.Type == BRT.Models.CategoryType.Garlic ? "eco" : "inventory")
                                    </span>
                                }
                                <span class="badge position-absolute top-0 start-0 m-1.5 px-2 py-0.5 rounded-pill bg-navy text-gold fw-bold extra-small" style="font-size:0.6rem;">
                                    @(p.SubCategory?.Name ?? "Stock")
                                </span>
                            </div>

                            <h6 class="fw-bold text-navy mb-0 text-truncate extra-small">@p.Name</h6>
                            <span class="text-muted d-block text-truncate extra-small mb-2" style="font-size:0.68rem;">@p.NameTamil</span>
                        </div>

                        <div class="pt-2 border-top d-flex align-items-center justify-content-between mt-auto">
                            <span class="badge bg-success bg-opacity-10 text-success extra-small rounded-pill px-2" style="font-size:0.65rem;">In Stock</span>
                            <a asp-controller="Catalog" asp-action="Product" asp-route-slug="@p.Slug" class="btn btn-sm btn-brt-gold px-2.5 py-1 extra-small fw-bold d-inline-flex align-items-center">
                                <span>Inquire</span>
                                <span class="material-symbols-outlined fs-6">chevron_right</span>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

<!-- ===== 4. INNOVATIVE SUPPLY PORTFOLIO TILES ===== -->
<section id="portfolio" class="container my-4 my-md-5 py-2">
    <div class="text-center mb-3">
        <span class="fw-bold text-uppercase tracking-wider extra-small text-gold d-inline-flex align-items-center gap-1">
            <span class="material-symbols-outlined fs-6 anim-float-icon">grid_view</span>
            <span>PORTFOLIO CATEGORIES</span>
        </span>
        <h2 class="fw-bold text-navy fs-4 fs-md-2 mb-0">Explore Supply Sections</h2>
    </div>

    <div class="row g-2.5 g-md-3">
        <!-- Garlic Mandi -->
        <div class="col-12 col-md-6">
            <a asp-controller="Catalog" asp-action="Garlic" class="portfolio-app-tile text-decoration-none">
                <div class="d-flex justify-content-between align-items-start position-relative z-2">
                    <span class="p-2 rounded-3 bg-white bg-opacity-10 text-gold backdrop-blur">
                        <span class="material-symbols-outlined fs-3">eco</span>
                    </span>
                    <span class="badge bg-gold text-navy fw-bold px-2.5 py-1 rounded-pill extra-small">Core Specialty</span>
                </div>
                <div class="position-relative z-2 mt-3">
                    <h3 class="fw-bold text-white fs-4 mb-1" style="font-family: 'Playfair Display', serif;">Garlic Mandi Supply</h3>
                    <p class="extra-small text-light opacity-75 mb-2">Raw, Ooty, Desi, and processed garlic cloves directly from farm roots.</p>
                    <span class="text-gold fw-bold extra-small d-inline-flex align-items-center gap-1">
                        View Garlic Section <span class="material-symbols-outlined fs-6">arrow_forward</span>
                    </span>
                </div>
            </a>
        </div>

        <!-- Grocery Essentials -->
        <div class="col-12 col-md-6">
            <a asp-controller="Catalog" asp-action="Grocery" class="portfolio-app-tile text-decoration-none">
                <div class="d-flex justify-content-between align-items-start position-relative z-2">
                    <span class="p-2 rounded-3 bg-white bg-opacity-10 text-gold backdrop-blur">
                        <span class="material-symbols-outlined fs-3">shopping_cart</span>
                    </span>
                    <span class="badge bg-white text-navy fw-bold px-2.5 py-1 rounded-pill extra-small">Bulk Staples</span>
                </div>
