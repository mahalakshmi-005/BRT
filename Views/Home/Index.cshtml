        <div class="col-4 col-md-3"><div class="partner-app-card"><span class="fs-4">🏨</span><h6 class="fw-bold text-navy mb-0 extra-small">Hotels &amp; Resorts</h6></div></div>
        <div class="col-4 col-md-3"><div class="partner-app-card"><span class="fs-4">🌐</span><h6 class="fw-bold text-navy mb-0 extra-small">Exporters</h6></div></div>
        <div class="col-4 col-md-4"><div class="partner-app-card"><span class="fs-4">🏭</span><h6 class="fw-bold text-navy mb-0 extra-small">Food Processors</h6></div></div>
        <div class="col-4 col-md-4"><div class="partner-app-card"><span class="fs-4">🍽️</span><h6 class="fw-bold text-navy mb-0 extra-small">Catering &amp; Mess</h6></div></div>
        <div class="col-4 col-md-4"><div class="partner-app-card"><span class="fs-4">🏫</span><h6 class="fw-bold text-navy mb-0 extra-small">Hostel Canteens</h6></div></div>
    </div>
</section>

<!-- ===== WHY CHOOSE US ===== -->
<section id="why-us" class="container my-4">
    <div class="p-3.5 bg-white border rounded-4 shadow-sm">
        <span class="fw-bold extra-small text-gold">WHY BRT TRADERS</span>
        <h2 class="fw-bold text-navy fs-4 mb-2">Trusted Wholesale Partner Since 2000</h2>
