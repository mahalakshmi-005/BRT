                        <div class="innovative-card p-2.5 p-md-3 h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-1.5">
                                    <span class="p-1.5 rounded-circle bg-light text-gold d-inline-flex align-items-center anim-float-icon">
                                        <span class="material-symbols-outlined fs-6">
                                            @(m.Product?.SubCategory?.Category?.Type == BRT.Models.CategoryType.Garlic ? "eco" : "shopping_cart_checkout")
                                        </span>
                                    </span>
                                    <span class="badge bg-danger text-white extra-small fw-semibold pulse-badge" style="font-size:0.65rem;">LIVE</span>
                                </div>
                                <h6 class="fw-bold mb-0 text-navy text-truncate extra-small fs-md-6">@m.Product?.Name</h6>
                                <span class="text-muted extra-small d-block mb-1" style="font-size: 0.7rem;">@m.Product?.NameTamil</span>
                            </div>
