                    <h6 class="fw-bold mb-1">Need Custom Quotation?</h6>
                    <p class="extra-small mb-3 opacity-75">Connect directly with our desk for custom orders.</p>
                    <a asp-controller="Order" asp-action="Request" class="btn btn-sm btn-brt-amber px-3 rounded-pill fw-semibold">Get Quotation</a>
                </div>
            </div>
        </div>
    </div>
</section>

