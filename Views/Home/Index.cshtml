    <div class="hero-inner container py-2 position-relative z-1">
        <div class="row align-items-center g-3 g-lg-5">
            <div class="col-lg-6 text-center text-lg-start">
                <div class="d-inline-flex align-items-center gap-1.5 px-3 py-1 rounded-pill mb-2.5 border bg-white shadow-sm" style="border-color: rgba(212, 175, 55, 0.3) !important;">
                    <span class="material-symbols-outlined fs-6 text-gold">verified_user</span> 
                    <span class="fw-bold extra-small text-uppercase tracking-wider text-navy" style="font-size: 0.68rem;">
                        <span class="lang-en-text">Trusted Wholesale Mandi Since 2000</span>
                        <span class="lang-ta-text">2000 முதல் நம்பகமான கமிஷன் மண்டி</span>
                    </span>
                </div>

                <h1 class="display-4 fw-bold mb-1 text-navy" style="font-family: 'Playfair Display', serif; letter-spacing: -0.5px;">
                    B RAJ <span class="text-gold" style="font-style: italic;">TRADERS</span>
                </h1>

                <p class="hero-tagline fs-6 text-muted mb-3 fw-normal" style="line-height: 1.5;">
                    <span class="lang-en-text">
                        Garlic &amp; Grocery Commission Mandi<br class="d-none d-md-block" />
                        <span class="fw-semibold text-dark">Premium Dealer Wholesale Supplier</span>
                    </span>
                    <span class="lang-ta-text">
                        பூண்டு &amp; மளிகை கமிஷன் மண்டி<br class="d-none d-md-block" />
                        <span class="fw-semibold text-dark">உயர்தர டீலர் மொத்த விற்பனை</span>
                    </span>
                </p>

                <div class="p-2.5 rounded-3 shadow-sm my-2.5 text-start" style="font-family: 'Playfair Display', serif; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(8px); border-left: 4px solid var(--brt-gold) !important;">
                    <p class="m-0 extra-small fs-md-6 text-secondary fst-italic">
                        <span class="text-gold fs-5 align-middle me-1">&ldquo;</span>
                        <span class="lang-en-text">Purity in every clove, trust in every deal.</span>
                        <span class="lang-ta-text">ஒவ்வொரு பல்லிலும் தூய்மை, ஒவ்வொரு ஒப்பந்தத்திலும் நம்பிக்கை.</span>
                        <span class="text-gold fs-5 align-middle ms-1">&rdquo;</span>
                    </p>
                </div>

                <div class="hero-cta d-flex flex-column flex-sm-row gap-2 mb-3 mt-3">
                    <a asp-controller="Order" asp-action="Request" class="btn btn-brt-gold px-4 py-2.5 shadow-sm d-inline-flex align-items-center justify-content-center gap-2">
                        <span class="lang-en-text">Secure Bulk Supply</span>
                        <span class="lang-ta-text">மொத்த விநியோகம் ஆர்டர் செய்ய</span>
                        <span class="material-symbols-outlined fs-6">arrow_forward</span>
                    </a>
                    <a asp-controller="Catalog" asp-action="Index" class="btn btn-brt-outline px-4 py-2.5 d-inline-flex align-items-center justify-content-center">
                        <span class="lang-en-text">Explore Catalog</span>
                        <span class="lang-ta-text">கேட்டலாக் பார்க்க</span>
                    </a>
                </div>

                <div class="hero-inline-stats d-flex align-items-center gap-2 gap-md-5 pt-3 border-top border-secondary border-opacity-10">
                    <div>
                        <div class="fw-bold fs-3 text-navy" style="font-family: 'Playfair Display', serif;">25+</div>
                        <div class="stat-label text-muted extra-small text-uppercase" style="font-size:0.65rem;">Years Legacy</div>
                    </div>
                    <div class="border-end opacity-25 border-dark" style="height: 25px;"></div>
                    <div>
                        <div class="fw-bold fs-3 text-navy" style="font-family: 'Playfair Display', serif;">500+</div>
                        <div class="stat-label text-muted extra-small text-uppercase" style="font-size:0.65rem;">Dealers</div>
                    </div>
                    <div class="border-end opacity-25 border-dark" style="height: 25px;"></div>
                    <div>
                        <div class="fw-bold fs-3 text-navy" style="font-family: 'Playfair Display', serif;">30+</div>
                        <div class="stat-label text-muted extra-small text-uppercase" style="font-size:0.65rem;">Varieties</div>
