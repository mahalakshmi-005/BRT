@{
    ViewData["Title"] = "Home";
}

<!-- Custom Styles for Home Page Sections -->
<style>
    /* Hero Section Styles */
    .brt-hero-section {
        background: linear-gradient(135deg, var(--brt-dark-navy) 0%, #1A2332 100%);
        color: #FFFFFF;
        padding: 60px 0 80px 0;
        position: relative;
        overflow: hidden;
    }

    .brt-hero-section::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, var(--brt-gold-glow) 0%, transparent 70%);
        pointer-events: none;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(212, 175, 55, 0.15);
        border: 1px solid rgba(212, 175, 55, 0.4);
        color: var(--brt-gold-pure);
        padding: 6px 16px;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .hero-title {
        font-family: 'Playfair Display', serif;
        font-size: 2.8rem;
        font-weight: 800;
        line-height: 1.2;
        margin-bottom: 20px;
    }

    .hero-subtitle {
        color: #9CA3AF;
        font-size: 1.1rem;
        line-height: 1.6;
        margin-bottom: 30px;
        max-width: 600px;
    }

    /* Custom Buttons */
    .btn-gold-primary {
        background: linear-gradient(135deg, #D4AF37 0%, #C59B27 100%);
        color: #0D131F !important;
        font-weight: 700;
        padding: 12px 28px;
        border-radius: 12px;
        border: none;
        box-shadow: 0 6px 20px rgba(212, 175, 55, 0.3);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .btn-gold-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
    }

    .btn-outline-custom {
        background: transparent;
        color: #FFFFFF !important;
        border: 1px solid rgba(255, 255, 255, 0.3);
        font-weight: 600;
        padding: 12px 28px;
        border-radius: 12px;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .btn-outline-custom:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: #FFFFFF;
    }

    /* Feature Cards Section */
    .feature-card {
        background: #FFFFFF;
        border: 1px solid rgba(0, 0, 0, 0.06);
        border-radius: 20px;
        padding: 30px 24px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        transition: all 0.3s ease;
        height: 100%;
    }

    .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
        border-color: var(--brt-gold-pure);
    }

    .feature-icon-wrap {
        width: 55px;
        height: 55px;
        border-radius: 14px;
        background: rgba(212, 175, 55, 0.12);
        color: var(--brt-gold-pure);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
    }

    /* Category Cards */
    .category-card {
        background: var(--brt-navy-card);
        border-radius: 20px;
        padding: 35px 25px;
        border: 1px solid rgba(212, 175, 55, 0.2);
        color: #FFFFFF;
        text-decoration: none;
        display: block;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .category-card:hover {
        border-color: var(--brt-gold-pure);
        transform: translateY(-4px);
    }

    /* Responsive Spacing for Mobile View */
    @@media (max-width: 991.98px) {
        .hero-title {
            font-size: 2rem;
        }
        .brt-hero-section {
            padding: 40px 0 50px 0;
            text-align: center;
        }
        .hero-subtitle {
            margin-left: auto;
            margin-right: auto;
        }
        .hero-btns {
            justify-content: center;
        }
    }
</style>

<!-- ==========================================
     1. HERO SECTION
     ========================================== -->
<section class="brt-hero-section">
    <div class="container-xl">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <div class="hero-badge">
                    <span class="material-symbols-outlined fs-6">verified</span>
                    <span class="lang-en-text">Trusted Trading Partner Since 2000</span>
                    <span class="lang-ta-text">2000 முதல் நம்பகமான வணிக பங்குதாரர்</span>
                </div>
                <h1 class="hero-title">
                    <span class="lang-en-text">Premium Quality Wholesale & Retail Supply Solutions</span>
                    <span class="lang-ta-text">உயர்தர மொத்த மற்றும் சில்லறை விநியோக சேவைகள்</span>
                </h1>
                <p class="hero-subtitle">
                    <span class="lang-en-text">Directly connecting top suppliers to markets with efficient logistics across Tamil Nadu & Pondicherry.</span>
                    <span class="lang-ta-text">தமிழ்நாடு மற்றும் புதுச்சேரி முழுவதும் வேகமான விநியோகத்துடன் சிறந்த பொருட்களை வழங்கி வருகிறோம்.</span>
                </p>
                <div class="d-flex flex-wrap gap-3 hero-btns">
                    <a asp-controller="Catalog" asp-action="Index" class="btn-gold-primary">
                        <span class="material-symbols-outlined">storefront</span>
                        <span class="lang-en-text">Explore Wholesale</span>
                        <span class="lang-ta-text">மொத்த விற்பனை</span>
                    </a>
                    <a asp-controller="Order" asp-action="Request" class="btn-outline-custom">
                        <span class="material-symbols-outlined">shopping_bag</span>
                        <span class="lang-en-text">Request Bulk Order</span>
                        <span class="lang-ta-text">மொத்த ஆர்டர் செய்ய</span>
                    </a>
                </div>
            </div>
            
            <div class="col-lg-5 text-center d-none d-lg-block">
                <img src="~/images/brt-logo.jpeg" alt="B Raj Traders" class="img-fluid rounded-4 shadow-lg border border-warning border-opacity-25" style="max-height: 380px; object-fit: cover;" />
            </div>
        </div>
    </div>
</section>

<!-- ==========================================
     2. PRODUCT CATEGORIES (Wholesale & Retail)
     ========================================== -->
<section class="py-5">
    <div class="container-xl">
        <div class="text-center mb-5">
            <h2 class="fw-bold" style="font-family: 'Space Grotesk', sans-serif;">
                <span class="lang-en-text">Our Supply Categories</span>
                <span class="lang-ta-text">எங்கள் விற்பனை பிரிவுகள்</span>
            </h2>
            <p class="text-muted">
                <span class="lang-en-text">Select your preferred purchasing mode below</span>
                <span class="lang-ta-text">உங்களுக்கு தேவையான பிரிவை தேர்வு செய்யவும்</span>
            </p>
        </div>

        <div class="row g-4">
            <!-- Wholesale Card -->
            <div class="col-md-6">
                <a asp-controller="Catalog" asp-action="Index" class="category-card">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="material-symbols-outlined fs-1 text-warning">grid_view</span>
                        <div>
                            <h3 class="h4 fw-bold mb-1">
                                <span class="lang-en-text">Wholesale Supply</span>
                                <span class="lang-ta-text">மொத்த விற்பனை</span>
                            </h3>
                            <span class="badge bg-warning text-dark">Bulk Volume</span>
                        </div>
                    </div>
                    <p class="text-secondary mb-0">
                        <span class="lang-en-text">Best pricing for commercial buyers, businesses, and large distributors.</span>
                        <span class="lang-ta-text">வியாபாரிகள் மற்றும் பெரிய நிறுவனங்களுக்கான சிறந்த மொத்த விலை பட்டியல்.</span>
                    </p>
                </a>
            </div>

            <!-- Retail Card -->
            <div class="col-md-6">
                <a asp-controller="Catalog" asp-action="Loose" class="category-card">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="material-symbols-outlined fs-1 text-warning">package_2</span>
                        <div>
                            <h3 class="h4 fw-bold mb-1">
                                <span class="lang-en-text">Retail / Loose Quantities</span>
                                <span class="lang-ta-text">சில்லறை விற்பனை</span>
                            </h3>
                            <span class="badge bg-secondary">Flexible Packs</span>
                        </div>
                    </div>
                    <p class="text-secondary mb-0">
                        <span class="lang-en-text">Flexible quantity options tailored for smaller orders and individual requirements.</span>
                        <span class="lang-ta-text">சிறிய அளவிலான தேவைகள் மற்றும் தனிநபர் ஆர்டர்களுக்கான வசதியான சேவைகள்.</span>
                    </p>
                </a>
            </div>
        </div>
    </div>
</section>

