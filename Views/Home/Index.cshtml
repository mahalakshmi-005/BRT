@{
    ViewData["Title"] = "B RAJ TRADERS | Premium Wholesale Mandi";
}

<!-- ===== Original Native Mobile App UI & UX Layer ===== -->
<style>
    :root {
        /* Premium Color Palette */
        --brt-navy: #0D131F;
        --brt-navy-light: #182232;
        --brt-gold: #D4AF37;
        --brt-gold-light: #F3E5AB;
        --brt-gold-glow: rgba(212, 175, 55, 0.25);
        --brt-card-bg: #FFFFFF;
        
        /* Native App Variables */
        --brt-app-radius: 20px;
        --brt-glass-border: rgba(212, 175, 55, 0.2);
        --brt-glass-bg: rgba(13, 19, 31, 0.88);
    }

    /* Keyframe Animations */
    @@keyframes floatIcon {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-4px) rotate(1deg); }
    }
    @@keyframes pulseGlow {
        0% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.5); }
        70% { box-shadow: 0 0 0 8px rgba(212, 175, 55, 0); }
        100% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0); }
    }

    /* Reset & Base UI Setup */
    body {
        overflow-x: hidden;
        background-color: #F8FAFC;
        padding-bottom: 70px; /* Space for Mobile App Bottom Bar */
        -webkit-tap-highlight-color: transparent;
    }

    /* Native App Bar / Sticky Top Bar */
    .app-top-header {
        position: sticky;
        top: 0;
        z-index: 1040;
        background: rgba(13, 19, 31, 0.92);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--brt-glass-border);
    }

    /* Native Horizontal App Chip Tabs */
    .app-chip-bar {
        display: flex;
        overflow-x: auto;
        white-space: nowrap;
        gap: 8px;
        padding: 8px 16px;
        scrollbar-width: none; /* Hide Scrollbar Firefox */
    }
    .app-chip-bar::-webkit-scrollbar {
        display: none; /* Hide Scrollbar Chrome/Safari */
    }
    .app-chip {
        background: #FFFFFF;
        border: 1px solid rgba(0,0,0,0.08);
        border-radius: 50px;
        padding: 6px 14px;
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--brt-navy);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.03);
        transition: all 0.2s ease;
    }
    .app-chip:active {
        transform: scale(0.95);
        background: var(--brt-gold);
        color: var(--brt-navy);
    }

    /* Equal Height Helper Layout */
    .row-equal-height {
        display: flex;
        flex-wrap: wrap;
    }
    .row-equal-height > [class*='col-'] {
        display: flex;
        flex-direction: column;
    }

    /* Native App Horizontal Carousel */
    .mobile-scroll-container {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        gap: 12px;
        padding: 4px 16px 12px 16px;
        scrollbar-width: none;
    }
    .mobile-scroll-container::-webkit-scrollbar {
        display: none;
    }
    .mobile-scroll-item {
        flex: 0 0 85%;
        scroll-snap-align: center;
    }
    @@media (min-width: 768px) {
        .mobile-scroll-container {
            display: flex;
            flex-wrap: wrap;
            overflow-x: visible;
            padding: 0;
            gap: 0;
        }
        .mobile-scroll-item {
            flex: 0 0 auto;
        }
    }

    /* High-End Touch Native Card */
    .innovative-card {
        background: var(--brt-card-bg);
        border: 1px solid rgba(13, 19, 31, 0.08);
        border-radius: var(--brt-app-radius);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        position: relative;
        overflow: hidden;
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .innovative-card:active {
        transform: scale(0.98);
    }
    @@media (min-width: 992px) {
        .innovative-card:hover {
            transform: translateY(-5px);
            border-color: var(--brt-gold) !important;
            box-shadow: 0 15px 30px -10px rgba(13, 19, 31, 0.08), 0 0 20px var(--brt-gold-glow) !important;
        }
    }

    /* Bento Hero Card */
    .portfolio-card-hero {
        background: var(--brt-navy);
        border-radius: 22px;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        z-index: 1;
        width: 100%;
        min-height: 220px;
        border: 1px solid var(--brt-glass-border);
    }
    .portfolio-card-hero::after {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at top right, rgba(212, 175, 55, 0.18), transparent 60%);
        z-index: 0;
    }
    .portfolio-card-hero:active {
        transform: scale(0.98);
    }

    /* Image Zoom Box */
    .img-zoom-container {
        overflow: hidden;
        border-radius: 16px;
        position: relative;
    }
    .img-zoom-container img {
        transition: transform 0.5s ease;
        width: 100%;
        object-fit: cover;
    }

    /* Utility Helpers */
    .anim-float-icon { animation: floatIcon 4s ease-in-out infinite; display: inline-block; }
    .pulse-badge { animation: pulseGlow 2.5s infinite; }
    .text-navy { color: var(--brt-navy) !important; }
    .text-gold { color: var(--brt-gold) !important; }
    .bg-navy { background-color: var(--brt-navy) !important; }
    .bg-gold { background-color: var(--brt-gold) !important; }
    .extra-small { font-size: 0.78rem; letter-spacing: 0.02em; }

    /* Custom Glass Effect */
    .bg-glass {
        background: var(--brt-glass-bg);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--brt-glass-border);
    }

    /* Mobile Buttons */
    .btn-brt-gold {
        background: linear-gradient(135deg, #D4AF37 0%, #C59B27 100%);
        color: #0D131F !important;
        font-weight: 700;
        border: none;
        border-radius: 50px;
        transition: all 0.2s ease;
        box-shadow: 0 4px 14px rgba(212, 175, 55, 0.3);
    }
    .btn-brt-gold:active {
        transform: scale(0.96);
    }
    .btn-brt-outline {
        border: 1.5px solid var(--brt-navy);
        color: var(--brt-navy) !important;
        font-weight: 600;
        border-radius: 50px;
        transition: all 0.2s ease;
    }
    .btn-brt-outline:active {
        transform: scale(0.96);
        background: var(--brt-navy);
        color: #FFFFFF !important;
    }

    /* Mobile App Responsive Specifics */
    @@media (max-width: 576px) {
        .display-4 { font-size: 2.1rem !important; }
        .hero-cta .btn { width: 100%; text-align: center; justify-content: center; }
        .hero-inline-stats { justify-content: space-around; }
        .hero-inline-stats .fs-2 { font-size: 1.4rem !important; }
    }
</style>

