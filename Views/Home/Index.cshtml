                    <span class="material-symbols-outlined text-warning fs-3">shopping_cart</span>
                    <span class="badge bg-secondary text-white fw-bold extra-small">Bulk Staples</span>
                </div>
                <h3 class="fw-bold fs-5 mb-1">Grocery &amp; Staples</h3>
                <p class="extra-small text-muted mb-2">High-grade pulses, whole spices, grains, and kitchen wholesale supplies.</p>
                <span class="text-warning fw-bold extra-small d-inline-flex align-items-center gap-1">
                    View Grocery Staples <span class="material-symbols-outlined fs-6">arrow_forward</span>
                </span>
            </a>
        </div>

        <div class="col-12 col-md-6">
