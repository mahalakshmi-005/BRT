<!-- ===== PRODUCTS SECTION ===== -->
@{
    var featured = ViewBag.FeaturedProducts as List<BRT.Models.Product>;
}
@if (featured != null && featured.Any())
{
    <section id="products" class="container my-4 my-md-5 py-2">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-3">
            <div class="text-center text-md-start mb-2 mb-md-0">
                <span class="fw-bold text-uppercase tracking-wider extra-small text-gold d-inline-flex align-items-center gap-1">
                    <span class="material-symbols-outlined fs-6 anim-float-icon">workspace_premium</span>
                    <span class="lang-en-text">PREMIUM WHOLESALE CATALOG</span>
                    <span class="lang-ta-text">மொத்த விற்பனைத் தயாரிப்புகள்</span>
                </span>
                <h2 class="fw-bold mt-1 text-navy fs-4 fs-md-2">
                    <span class="lang-en-text">Featured Produce &amp; Stock</span>
                    <span class="lang-ta-text">சிறப்பு இருப்புப் பொருட்கள்</span>
                </h2>
            </div>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-brt-outline px-3.5 py-1.5 extra-small fw-bold">
                <span class="lang-en-text">View Full Catalog</span>
                <span class="lang-ta-text">முழு கேட்டலாக் பார்க்க</span>
            </a>
        </div>

        <div class="mobile-scroll-container row-equal-height">
            @foreach (var p in featured)
            {
                <div class="mobile-scroll-item p-1">
                    <div class="pro-product-card p-3 d-flex flex-column justify-content-between h-100">
                        <div>
                            <div class="bg-light rounded-3 p-3 text-center d-flex align-items-center justify-content-center position-relative" style="height: 150px;">
                                @if (!string.IsNullOrEmpty(p.ImageUrl))
                                {
                                    <img src="@p.ImageUrl" alt="@p.Name" class="img-fluid object-fit-contain" style="max-height: 120px;" />
                                }
                                else
                                {
                                    <span class="material-symbols-outlined fs-1 text-gold">inventory_2</span>
                                }
                                <span class="badge position-absolute top-0 start-0 m-2 px-2.5 py-1 rounded-pill bg-navy text-gold fw-bold extra-small">
                                    @(p.SubCategory?.Name ?? "General")
                                </span>
                            </div>

                            <div class="pt-3">
                                <h5 class="fw-bold text-navy mb-0 fs-6 text-truncate">@p.Name</h5>
                                @if (!string.IsNullOrEmpty(p.NameTamil))
                                {
                                    <span class="text-muted extra-small d-block fw-medium mb-2 text-truncate">@p.NameTamil</span>
                                }
                                <p class="text-muted extra-small lh-sm mb-0 text-truncate" style="font-size:0.75rem;">
                                    @(string.IsNullOrEmpty(p.Description) ? "Commercial bulk packaging directly sourced from verified Mandi roots." : p.Description)
                                </p>
                            </div>
                        </div>

                        <div class="pt-3 mt-3 border-top d-flex justify-content-between align-items-center">
                            <span class="badge bg-success bg-opacity-10 text-success fw-bold extra-small rounded-pill px-2">Ready Bulk</span>
                            <a asp-controller="Catalog" asp-action="Product" asp-route-slug="@p.Slug" class="btn btn-sm btn-brt-gold px-3 py-1.5 extra-small fw-bold d-inline-flex align-items-center gap-1">
                                <span>Inquire</span>
                                <span class="material-symbols-outlined fs-6">arrow_forward</span>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

<!-- ===== LIVE MARKET DASHBOARD ===== -->
@{
    var dashboard = ViewBag.MarketDashboard as List<BRT.Models.MarketPrice>;
}
<section id="live-rates" class="container my-4 my-md-5 py-2">
    <div class="live-market-container p-3 p-md-4 text-white">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-3 pb-3 border-bottom border-secondary border-opacity-25">
            <div class="text-center text-md-start mb-2 mb-md-0">
                <div class="d-inline-flex align-items-center gap-2 bg-danger bg-opacity-25 border border-danger border-opacity-50 px-2.5 py-0.5 rounded-pill mb-1">
                    <span class="pulse-dot"></span>
                    <span class="extra-small fw-bold text-danger text-uppercase tracking-wider" style="font-size:0.68rem;">LIVE MANDI BOARD</span>
                </div>
                <h2 class="fw-bold mb-0 text-white fs-4 fs-md-2" style="font-family: 'Playfair Display', serif;">
                    Today's Wholesale Market Rates
                </h2>
            </div>
            <div class="text-center text-md-end">
                <span class="extra-small text-gold d-block"><span class="material-symbols-outlined fs-6 align-middle me-1">update</span> Real-Time Updates</span>
            </div>
        </div>

        <div class="row g-2.5 row-equal-height">
            @if (dashboard != null && dashboard.Any())
            {
                foreach (var m in dashboard)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="live-rate-card p-3 h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="p-1.5 rounded-circle bg-gold bg-opacity-10 text-gold d-inline-flex">
                                        <span class="material-symbols-outlined fs-6">
                                            @(m.Product?.SubCategory?.Category?.Type == BRT.Models.CategoryType.Garlic ? "eco" : "shopping_cart")
                                        </span>
                                    </span>
                                    <span class="badge bg-gold text-dark extra-small fw-bold">DAILY</span>
                                </div>
                                <h6 class="fw-bold mb-0 text-white text-truncate extra-small">@m.Product?.Name</h6>
                                <span class="text-muted extra-small d-block text-truncate" style="font-size:0.65rem;">@m.Product?.NameTamil</span>
                            </div>

                            <div class="mt-3 pt-2 border-top border-secondary border-opacity-25">
                                <div class="fw-bold text-gold fs-5">
                                    ₹@m.TodayPrice.ToString("N2")
                                    <span class="extra-small text-muted fw-normal" style="font-size:0.65rem;">/ Unit</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-1 text-muted extra-small" style="font-size:0.65rem;">
                                    <span>Verified Mandi</span>
                                    <span class="material-symbols-outlined text-gold fs-6">verified</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            <div class="col-12 col-md-4 col-lg-3 mt-2 mt-md-0">
                <div class="live-rate-card p-3 h-100 d-flex flex-column align-items-center justify-content-center text-center" style="background: rgba(212,175,55,0.15);">
                    <span class="material-symbols-outlined text-gold fs-2 mb-1 anim-float-icon">request_quote</span>
                    <h6 class="fw-bold text-white extra-small mb-1">Custom Rate Inquiry?</h6>
                    <a asp-controller="Order" asp-action="Request" class="btn btn-sm btn-brt-gold px-3 py-1 extra-small fw-bold mt-1">Get Instant Quote</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== LIGHT PORTFOLIO SECTION ===== -->
<section id="portfolio" class="container my-4 my-md-5 py-2">
    <div class="text-center mb-3 mb-md-4">
        <span class="fw-bold text-uppercase tracking-wider extra-small text-gold d-inline-flex align-items-center gap-1">
            <span class="material-symbols-outlined fs-6 anim-float-icon">grid_view</span>
            <span class="lang-en-text">PRODUCT CATEGORIES</span>
            <span class="lang-ta-text">தயாரிப்பு வகைகள்</span>
        </span>
        <h2 class="fw-bold mt-1 text-navy fs-4 fs-md-2">
            <span class="lang-en-text">Explore Our Supply Portfolio</span>
            <span class="lang-ta-text">எங்கள் விநியோகப் பிரிவுகள்</span>
        </h2>
    </div>

    <div class="row g-3 row-equal-height">
        <!-- Garlic Tile -->
        <div class="col-12 col-md-6">
            <a asp-controller="Catalog" asp-action="Garlic" class="portfolio-light-card">
                <div>
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="p-2.5 rounded-3 bg-warning bg-opacity-10 text-gold anim-float-icon">
                            <span class="material-symbols-outlined fs-3">eco</span>
                        </span>
                        <span class="badge bg-gold text-navy fw-bold px-3 py-1 rounded-pill extra-small">Primary Mandi</span>
                    </div>
                    <h3 class="fw-bold text-navy fs-4 mb-1" style="font-family: 'Playfair Display', serif;">Garlic Mandi</h3>
                    <p class="extra-small text-muted mb-3">Raw, processed, and bulk cloves directly from major farm origins.</p>
