                <p class="extra-small text-muted mb-2">Special rates for bulk transport loading &amp; major regional dealers.</p>
                <span class="text-warning fw-bold extra-small d-inline-flex align-items-center gap-1">
                    Book Lorry Load <span class="material-symbols-outlined fs-6">arrow_forward</span>
                </span>
            </a>
        </div>
    </div>
</section>

