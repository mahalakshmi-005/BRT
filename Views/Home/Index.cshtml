                                <div class="d-flex justify-content-between align-items-center mt-1 text-muted" style="font-size:0.68rem;">
                                    <span>Updated Today</span>
                                    <span class="material-symbols-outlined text-gold" style="font-size: 0.8rem">verified</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            <div class="col-12 col-md-4 col-lg-3 mt-2 mt-md-0">
                <div class="portfolio-card-hero p-3 text-center d-flex flex-column align-items-center justify-content-center text-white bg-navy h-100">
                    <span class="material-symbols-outlined fs-2 mb-1 text-gold anim-float-icon">forum</span>
                    <h6 class="fw-bold mb-1 extra-small fs-md-6">Custom Quotation?</h6>
                    <p class="extra-small mb-2 opacity-75" style="font-size: 0.72rem;">Direct bulk quotes for customized weights.</p>
                    <a asp-controller="Order" asp-action="Request" class="btn btn-sm btn-brt-gold px-3 py-1.5 extra-small fw-bold">Get Quotation</a>
                </div>
            </div>
        </div>
    </div>
</section>

