<!-- ===== Live Mandi Market Dashboard (App Horizontal Feed) ===== -->
@{
    var dashboard = ViewBag.MarketDashboard as List<BRT.Models.MarketPrice>;
}
<section class="my-3">
    <div class="container px-3 mb-2 d-flex justify-content-between align-items-center">
        <div>
            <span class="fw-bold text-dark fs-6 d-flex align-items-center gap-1">
                <span class="pulse-live-dot"></span>
                <span class="lang-en-text">Today's Mandi Rates</span>
                <span class="lang-ta-text">இன்றைய மண்டி விலைகள்</span>
            </span>
        </div>
        <span class="badge bg-light text-muted border" style="font-size: 0.65rem;">Updated Live</span>
    </div>

    <div class="app-horizontal-feed">
        @if (dashboard != null && dashboard.Any())
        {
            foreach (var m in dashboard)
            {
                <div class="app-feed-card p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="badge bg-danger-subtle text-danger fw-bold rounded-pill px-2 py-0.5" style="font-size: 0.6rem;">LIVE</span>
                            <h6 class="fw-bold mb-0 text-dark mt-1" style="font-size: 0.88rem;">@m.Product?.Name</h6>
                            <span class="text-muted d-block" style="font-size: 0.72rem;">@m.Product?.NameTamil</span>
                        </div>
                        <span class="p-2 rounded-circle bg-light text-warning">
                            <span class="material-symbols-outlined fs-5">
                                @(m.Product?.SubCategory?.Category?.Type == BRT.Models.CategoryType.Garlic ? "eco" : "shopping_cart_checkout")
                            </span>
                        </span>
                    </div>
                    <div class="pt-2 border-top d-flex justify-content-between align-items-end">
                        <div>
                            <span class="text-muted d-block" style="font-size: 0.65rem;">Mandi Price</span>
                            <span class="fw-bold text-dark fs-5">₹@m.TodayPrice.ToString("N2")</span>
                        </div>
                        <a asp-controller="Order" asp-action="Request" class="btn btn-sm btn-outline-dark rounded-pill px-2.5 py-1" style="font-size:0.7rem;">
                            <span class="lang-en-text">Book</span>
                            <span class="lang-ta-text">பதிவு</span>
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="app-feed-card p-3 text-center">
                <p class="text-muted m-0 extra-small">Loading live mandi rates...</p>
            </div>
        }
    </div>
</section>

<!-- ===== Featured Products Showcase (App Card Layout) ===== -->
@{
    var featured = ViewBag.FeaturedProducts as List<BRT.Models.Product>;
}
@if (featured != null && featured.Any())
{
    <section class="my-4">
        <div class="container px-3 mb-2 d-flex justify-content-between align-items-center">
            <h3 class="fw-bold text-dark fs-6 m-0">
                <span class="lang-en-text">Featured Mandi Produce</span>
                <span class="lang-ta-text">சிறப்பு மண்டி பொருட்கள்</span>
            </h3>
            <a asp-controller="Catalog" asp-action="Index" class="text-decoration-none fw-semibold text-warning" style="font-size: 0.75rem;">
                <span class="lang-en-text">View All</span>
                <span class="lang-ta-text">அனைத்தும்</span>
            </a>
        </div>

        <div class="app-horizontal-feed">
            @foreach (var p in featured)
            {
                <div class="app-feed-card p-3">
                    <div class="text-center bg-light rounded-3 p-2 mb-2 position-relative" style="height: 140px; display: flex; align-items: center; justify-content: center;">
                        @if (!string.IsNullOrEmpty(p.ImageUrl))
                        {
                            <img src="@p.ImageUrl" alt="@p.Name" class="img-fluid object-fit-contain" style="max-height: 120px;" />
                        }
                        else
                        {
                            <span class="material-symbols-outlined text-warning" style="font-size: 50px;">eco</span>
                        }
                        <span class="badge bg-dark text-white position-absolute top-0 start-0 m-2 px-2 py-1" style="font-size:0.6rem;">
                            @(p.SubCategory?.Name ?? "Fresh Stock")
                        </span>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0 text-dark" style="font-size: 0.88rem;">@p.Name</h6>
                        <span class="text-muted d-block mb-2" style="font-size: 0.72rem;">@p.NameTamil</span>
                    </div>
                    <div class="pt-2 border-top d-flex justify-content-between align-items-center">
                        <span class="badge bg-success-subtle text-success extra-small">Available</span>
                        <a asp-controller="Catalog" asp-action="Product" asp-route-slug="@p.Slug" class="btn btn-sm btn-app-gold px-3 py-1" style="font-size: 0.7rem;">
                            <span class="lang-en-text">View Item</span>
                            <span class="lang-ta-text">விவரம்</span>
                        </a>
                    </div>
                </div>
            }
        </div>
    </section>
}

