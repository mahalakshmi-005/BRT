                    <div>
                        <div class="fw-bold fs-2 text-navy" style="font-family: 'Playfair Display', serif;">25+</div>
                        <div class="stat-label text-muted extra-small text-uppercase tracking-wider">Years Legacy</div>
                    </div>
                    <div class="border-end opacity-25 border-dark" style="height: 30px;"></div>
                    <div>
                        <div class="fw-bold fs-2 text-navy" style="font-family: 'Playfair Display', serif;">500+</div>
                        <div class="stat-label text-muted extra-small text-uppercase tracking-wider">Dealers</div>
