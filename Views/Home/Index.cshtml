@{
    ViewData["Title"] = "B RAJ TRADERS | Premium Wholesale Mandi";
}

<style>
    :root {
        /* Premium Color Palette */
        --brt-navy: #0D131F;
        --brt-navy-light: #182232;
        --brt-gold: #D4AF37;
        --brt-gold-light: #F3E5AB;
        --brt-gold-glow: rgba(212, 175, 55, 0.35);
        --brt-card-bg: #FFFFFF;
        
        /* Native App & Modern Variables */
        --brt-app-radius: 20px;
        --brt-glass-border: rgba(212, 175, 55, 0.25);
        --brt-glass-bg: rgba(13, 19, 31, 0.92);
    }

    /* Keyframe Animations */
    @@keyframes floatIcon {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-5px) rotate(2deg); }
    }
    @@keyframes pulseGlow {
        0% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.6); }
        70% { box-shadow: 0 0 0 8px rgba(220, 53, 69, 0); }
        100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
    }
    @@keyframes shimmer {
        0% { background-position: -200% 0; }
        100% { background-position: 200% 0; }
    }

    /* Base Styling */
    body {
        overflow-x: hidden;
        background-color: #F8FAFC;
        padding-bottom: 70px;
        -webkit-tap-highlight-color: transparent;
    }

    /* Equal Height Flex Helper */
    .row-equal-height {
        display: flex;
        flex-wrap: wrap;
    }
    .row-equal-height > [class*='col-'] {
        display: flex;
        flex-direction: column;
    }

    /* Quick Category Horizontal Chips */
    .app-chip-bar {
        display: flex;
        overflow-x: auto;
        white-space: nowrap;
        gap: 8px;
        padding: 10px 16px;
        scrollbar-width: none;
    }
    .app-chip-bar::-webkit-scrollbar { display: none; }
    .app-chip {
        background: #FFFFFF;
        border: 1px solid rgba(13,19,31,0.08);
        border-radius: 50px;
        padding: 6px 14px;
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--brt-navy);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.03);
        transition: all 0.2s ease;
    }
    .app-chip:active {
        transform: scale(0.95);
        background: var(--brt-gold);
        color: var(--brt-navy);
    }

    /* ===================================================
       ULTRA PRO MAX: LIVE MARKET STYLES
    =================================================== */
    .live-market-container {
        background: radial-gradient(circle at 50% 0%, #182232 0%, #0D131F 100%);
        border-radius: 28px;
        border: 1px solid var(--brt-glass-border);
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(13, 19, 31, 0.25);
    }
    .live-market-container::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(212, 175, 55, 0.08) 0%, transparent 60%);
        pointer-events: none;
    }
    .live-rate-card {
        background: rgba(255, 255, 255, 0.04);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    .live-rate-card:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: var(--brt-gold);
        transform: translateY(-4px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3), 0 0 15px var(--brt-gold-glow);
    }

    /* ===================================================
       ULTRA PRO MAX: PRODUCTS CAROUSEL & CARDS
    =================================================== */
    .mobile-scroll-container {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        gap: 14px;
        padding: 8px 16px 16px 16px;
        scrollbar-width: none;
    }
    .mobile-scroll-container::-webkit-scrollbar { display: none; }
    .mobile-scroll-item {
        flex: 0 0 85%;
        scroll-snap-align: center;
    }
    @@media (min-width: 768px) {
        .mobile-scroll-container {
            display: flex;
            flex-wrap: wrap;
            overflow-x: visible;
            padding: 0;
            gap: 0;
        }
        .mobile-scroll-item { flex: 0 0 auto; }
    }

    .pro-product-card {
        background: #FFFFFF;
        border-radius: 22px;
        border: 1px solid rgba(13, 19, 31, 0.08);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }
    .pro-product-card:hover {
        transform: translateY(-6px);
        border-color: var(--brt-gold);
        box-shadow: 0 16px 32px rgba(13, 19, 31, 0.08), 0 0 20px var(--brt-gold-glow);
    }
    .pro-product-card .img-wrapper {
        background: linear-gradient(135deg, #F8FAFC 0%, #EDF2F7 100%);
        border-radius: 18px;
        overflow: hidden;
        position: relative;
    }

    /* ===================================================
       ULTRA PRO MAX: PORTFOLIO TILES
    =================================================== */
    .portfolio-pro-tile {
        background: #0D131F;
        border-radius: 24px;
        border: 1px solid var(--brt-glass-border);
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
        min-height: 200px;
    }
    .portfolio-pro-tile::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(13, 19, 31, 0.2) 0%, rgba(13, 19, 31, 0.95) 100%);
        z-index: 1;
    }
    .portfolio-pro-tile:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(13, 19, 31, 0.3), 0 0 20px var(--brt-gold-glow);
        border-color: var(--brt-gold);
    }

    /* ===================================================
       INNOVATIVE: INDUSTRIES WE SERVE
    =================================================== */
    .industry-card {
        background: #FFFFFF;
        border: 1px solid rgba(13, 19, 31, 0.08);
        border-radius: 20px;
        padding: 1.25rem 1rem;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }
    .industry-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 3px;
        background: transparent;
        transition: background 0.3s ease;
    }
    .industry-card:hover {
        transform: translateY(-4px);
        border-color: var(--brt-gold);
        box-shadow: 0 12px 24px rgba(13, 19, 31, 0.06);
    }
    .industry-card:hover::before {
        background: var(--brt-gold);
    }

    /* Helpers */
    .anim-float-icon { animation: floatIcon 3.5s ease-in-out infinite; display: inline-block; }
    .pulse-dot { width: 8px; height: 8px; background-color: #DC3545; border-radius: 50%; animation: pulseGlow 1.8s infinite; }
    .text-navy { color: var(--brt-navy) !important; }
    .text-gold { color: var(--brt-gold) !important; }
    .bg-navy { background-color: var(--brt-navy) !important; }
    .bg-gold { background-color: var(--brt-gold) !important; }
    .extra-small { font-size: 0.78rem; letter-spacing: 0.02em; }
    .btn-brt-gold {
        background: linear-gradient(135deg, #D4AF37 0%, #C59B27 100%);
        color: #0D131F !important;
        font-weight: 700;
        border: none;
        border-radius: 50px;
        box-shadow: 0 4px 14px rgba(212, 175, 55, 0.3);
        transition: all 0.2s ease;
    }
    .btn-brt-gold:active { transform: scale(0.96); }
    .btn-brt-outline {
        border: 1.5px solid var(--brt-navy);
        color: var(--brt-navy) !important;
        font-weight: 600;
        border-radius: 50px;
        transition: all 0.2s ease;
    }
    .btn-brt-outline:active {
        transform: scale(0.96);
        background: var(--brt-navy);
        color: #FFFFFF !important;
    }
</style>

<!-- ===== FINAL INNOVATIVE ANNOUNCEMENT BAR ===== -->
<div class="top-announcement-bar text-white py-2 px-3" style="background: linear-gradient(90deg, #0D131F 0%, #182232 50%, #0D131F 100%); border-bottom: 1px solid var(--brt-glass-border);">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        
        <!-- Trust Badge & Selected Headline -->
        <div class="d-flex align-items-center gap-2.5 overflow-hidden me-2">
            <!-- Single Premium Badge -->
            <span class="badge bg-gold text-navy fw-bold px-2.5 py-1 extra-small rounded-pill flex-shrink-0 d-inline-flex align-items-center gap-1 shadow-sm">
                <span class="material-symbols-outlined fs-6 align-middle">verified</span>
                <span>DIRECT MANDI</span>
            </span>

            <!-- Selected Trusted Line -->
            <div class="text-truncate extra-small text-gold-light fw-medium">
