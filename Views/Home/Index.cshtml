                    <span class="fw-bold extra-small text-uppercase text-navy">
                        <span class="lang-en-text">Trusted Wholesale Mandi Since 2000</span>
                        <span class="lang-ta-text">2000 முதல் நம்பகமான கமிஷன் மண்டி</span>
                    </span>
                </div>

                <h1 class="display-5 fw-bold mb-1 text-navy" style="font-family: 'Playfair Display', serif;">
                    B RAJ <span class="text-gold" style="font-style: italic;">TRADERS</span>
                </h1>

                <p class="hero-tagline fs-6 text-muted mb-3 fw-normal">
                    <span class="lang-en-text">Garlic &amp; Grocery Commission Mandi Supplier</span>
                    <span class="lang-ta-text">பூண்டு &amp; மளிகை கமிஷன் மண்டி</span>
                </p>

                <div class="hero-cta d-flex flex-column flex-sm-row gap-2 mb-3">
                    <a asp-controller="Order" asp-action="Request" class="btn btn-brt-gold px-4 py-2.5 shadow-sm d-inline-flex align-items-center justify-content-center gap-2">
                        <span>Secure Bulk Supply</span>
                        <span class="material-symbols-outlined fs-6">arrow_forward</span>
                    </a>
                    <a asp-controller="Catalog" asp-action="Index" class="btn btn-brt-outline px-4 py-2.5 d-inline-flex align-items-center justify-content-center">
                        <span>Explore Catalog</span>
                    </a>
                </div>

                <div class="d-flex align-items-center gap-4 pt-3 border-top justify-content-center justify-content-lg-start">
                    <div>
                        <div class="fw-bold fs-4 text-navy">25+</div>
                        <div class="text-muted extra-small">Years Legacy</div>
                    </div>
                    <div class="border-end opacity-25" style="height: 20px;"></div>
                    <div>
                        <div class="fw-bold fs-4 text-navy">500+</div>
                        <div class="text-muted extra-small">Dealers</div>
                    </div>
                    <div class="border-end opacity-25" style="height: 20px;"></div>
                    <div>
                        <div class="fw-bold fs-4 text-navy">30+</div>
                        <div class="text-muted extra-small">Varieties</div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 text-center">
                <div class="p-1 rounded-4 shadow-sm bg-white border">
                    <img src="~/images/hero.png" alt="Garlic Wholesale Mandi" class="img-fluid rounded-3 object-fit-cover" style="max-height: 250px; width: 100%;" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1618160702438-9b02ab6515c9?auto=format&fit=crop&w=800&q=80';" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== 1. TODAY'S LIVE MANDI RATES (CORRECTED) ===== -->
@{
    var dashboard = ViewBag.MarketDashboard as List<BRT.Models.MarketPrice>;
}
<section id="live-rates" class="container my-4">
    <div class="live-market-container">
        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom border-secondary border-opacity-25">
            <div class="d-flex align-items-center gap-2">
                <span class="live-dot"></span>
                <h2 class="fw-bold text-white fs-5 mb-0" style="font-family: 'Playfair Display', serif;">
                    Today's Live Mandi Rates
                </h2>
            </div>
            <span class="badge bg-warning text-dark extra-small fw-bold d-inline-flex align-items-center gap-1">
                <span class="material-symbols-outlined fs-6">sync</span> REALTIME
            </span>
        </div>

        <div class="row g-2.5">
            @if (dashboard != null && dashboard.Any())
            {
                foreach (var m in dashboard)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="live-item-card">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <span class="text-warning extra-small d-inline-flex align-items-center gap-1" style="font-size:0.68rem;">
                                        <span class="material-symbols-outlined fs-6">verified</span> Verified
                                    </span>
                                </div>
                                <h6 class="fw-bold text-white text-truncate mb-0 extra-small">@m.Product?.Name</h6>
                                <span class="text-muted d-block text-truncate extra-small mb-2" style="font-size:0.65rem;">@m.Product?.NameTamil</span>
                            </div>

                            <div class="pt-1 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-baseline">
                                <span class="fw-bold text-warning fs-6">₹@m.TodayPrice.ToString("N0")</span>
                                <span class="text-muted extra-small" style="font-size:0.65rem;">/ Bag</span>
                            </div>
                        </div>
                    </div>
                }
            }
            <div class="col-12 col-md-4 col-lg-3">
                <div class="live-item-card d-flex flex-row flex-md-column align-items-center justify-content-between p-2.5" style="background: rgba(197, 155, 39, 0.15);">
                    <div class="text-start text-md-center">
                        <h6 class="fw-bold text-white extra-small mb-0 d-inline-flex align-items-center gap-1">
                            <span class="material-symbols-outlined text-warning fs-6">request_quote</span> Custom Bulk Quote?
                        </h6>
                    </div>
                    <a asp-controller="Order" asp-action="Request" class="btn btn-sm btn-brt-gold px-3 py-1 extra-small fw-bold">Get Price</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== 2. WHOLESALE CATALOG (HORIZONTAL SLIDE) ===== -->
@{
    var featured = ViewBag.FeaturedProducts as List<BRT.Models.Product>;
}
@if (featured != null && featured.Any())
{
    <section id="products" class="container my-4">
        <div class="d-flex justify-content-between align-items-end mb-3">
            <div>
                <span class="fw-bold extra-small text-gold d-inline-flex align-items-center gap-1">
                    <span class="material-symbols-outlined fs-6">workspace_premium</span> WHOLESALE CATALOG
                </span>
                <h2 class="fw-bold text-navy fs-4 mb-0">Featured Stock Produce</h2>
            </div>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-sm btn-brt-outline px-3 py-1 extra-small fw-bold">View All</a>
        </div>

        <!-- Horizontal Slide Container -->
        <div class="catalog-scroll-wrapper">
            @foreach (var p in featured)
            {
                <div class="catalog-scroll-item">
                    <div class="app-catalog-card">
                        <div>
                            <div class="bg-light rounded-3 p-2 text-center mb-2" style="height: 100px; display: flex; align-items: center; justify-content: center;">
                                @if (!string.IsNullOrEmpty(p.ImageUrl))
                                {
                                    <img src="@p.ImageUrl" alt="@p.Name" class="img-fluid object-fit-contain" style="max-height: 85px;" />
                                }
                                else
                                {
                                    <span class="material-symbols-outlined fs-1 text-muted">inventory_2</span>
                                }
                            </div>
                            <h6 class="fw-bold text-navy mb-0 text-truncate extra-small">@p.Name</h6>
                            <span class="text-muted d-block text-truncate extra-small mb-2" style="font-size:0.68rem;">@p.NameTamil</span>
                        </div>

                        <div class="pt-2 border-top d-flex align-items-center justify-content-between">
                            <span class="badge bg-success bg-opacity-10 text-success extra-small rounded-pill px-2" style="font-size:0.65rem;">In Stock</span>
                            <a asp-controller="Catalog" asp-action="Product" asp-route-slug="@p.Slug" class="btn btn-sm btn-brt-gold px-2 py-0.5 extra-small fw-bold">Inquire</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

