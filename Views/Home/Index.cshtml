                    <!-- Bottom Right Dark Floating Badge -->
                    <div class="position-absolute bottom-0 end-0 translate-middle-y p-2.5 p-md-3 rounded-4 shadow-lg d-flex align-items-center gap-2.5 d-none d-sm-flex" style="background: rgba(13, 19, 31, 0.92); backdrop-filter: blur(12px); border: 1px solid rgba(212, 175, 55, 0.3); z-index: 2;">
