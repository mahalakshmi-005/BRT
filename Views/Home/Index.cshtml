<!-- ===== Featured Products Showcase ===== -->
@{
    var featured = ViewBag.FeaturedProducts as List<BRT.Models.Product>;
}
@if (featured != null && featured.Any())
{
    <section id="products" class="container my-3 my-md-5 py-2">
        <div class="text-center mb-3 mb-md-4">
            <span class="hero-eyebrow fw-semibold text-uppercase tracking-wider small d-inline-flex align-items-center gap-1 text-gold">
                <span class="material-symbols-outlined fs-6 anim-float-icon">workspace_premium</span>
                <span class="lang-en-text">OUR PRODUCTS</span>
                <span class="lang-ta-text">எங்கள் தயாரிப்புகள்</span>
            </span>
            <h2 class="fw-bold mt-1 text-navy fs-4 fs-md-2">
                <span class="lang-en-text">Premium Wholesale Selection</span>
                <span class="lang-ta-text">மொத்த விற்பனை தேர்வு</span>
            </h2>
        </div>

        <div class="mobile-scroll-container row-equal-height">
            @foreach (var p in featured)
            {
                <div class="mobile-scroll-item col-lg-4 col-md-6">
                    <div class="innovative-card p-3 d-flex flex-column justify-content-between h-100">
                        <div>
                            <div class="img-zoom-container bg-light text-center py-2 px-2 position-relative d-flex align-items-center justify-content-center" style="min-height: 150px; background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);">
                                @if (!string.IsNullOrEmpty(p.ImageUrl))
                                {
                                    <img src="@p.ImageUrl" alt="@p.Name" class="img-fluid object-fit-contain" style="max-height: 130px;" />
                                }
                                else
                                {
                                    <div class="rounded-circle p-2.5 bg-white shadow-sm text-navy anim-float-icon">
                                        <span class="material-symbols-outlined fs-2">
                                            @(p.SubCategory?.Category?.Type == BRT.Models.CategoryType.Garlic ? "eco" : "shopping_cart_checkout")
                                        </span>
                                    </div>
                                }
                                <span class="badge position-absolute top-0 start-0 m-2 px-2 py-1 rounded-pill shadow-sm bg-navy text-white" style="font-size: 0.65rem; border: 1px solid rgba(212,175,55,0.3);">
                                    @(p.SubCategory?.Name ?? "General")
                                </span>
                            </div>
                            <div class="pt-2 px-1">
                                <h4 class="card-title h6 fw-bold mb-0.5 text-navy">
                                    <span>@p.Name</span>
                                </h4>
                                @if (!string.IsNullOrEmpty(p.NameTamil))
                                {
                                    <span class="d-block text-muted extra-small fw-medium mb-1">@p.NameTamil</span>
                                }
                                <p class="card-text text-muted extra-small lh-sm" style="font-size: 0.73rem;">
                                    @if (string.IsNullOrEmpty(p.Description))
                                    {
                                        <span class="lang-en-text">Standard commercial bulk packaging with fresh stock.</span>
                                        <span class="lang-ta-text">புத்தம்புதிய மண்டி இருப்புடன் கூடிய மொத்த பேக்கிங்.</span>
                                    }
                                    else
                                    {
                                        @p.Description
                                    }
                                </p>
                            </div>
                        </div>
                        <div class="pt-2 px-1 mt-2 border-top d-flex justify-content-between align-items-center">
                            <span class="badge bg-light text-dark border px-2 py-1 rounded-pill extra-small fw-semibold" style="font-size: 0.68rem;">
                                <span class="lang-en-text">Fresh Stock</span>
                                <span class="lang-ta-text">புதிய இருப்பு</span>
                            </span>
                            <a asp-controller="Catalog" asp-action="Product" asp-route-slug="@p.Slug" class="btn btn-sm btn-outline-dark rounded-pill px-2.5 py-1 extra-small fw-semibold d-inline-flex align-items-center gap-1">
                                <span class="lang-en-text">Details</span>
                                <span class="lang-ta-text">விவரங்கள்</span>
                                <span class="material-symbols-outlined fs-6">arrow_forward</span>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-3">
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-brt-outline px-4 py-2 shadow-sm extra-small fw-bold">
                <span class="lang-en-text">View Full Catalog</span>
                <span class="lang-ta-text">முழு கேட்டலாகைப் பார்க்க</span>
            </a>
        </div>
    </section>
}

<!-- ===== Live Market Dashboard ===== -->
@{
    var dashboard = ViewBag.MarketDashboard as List<BRT.Models.MarketPrice>;
}
<section id="live-rates" class="container my-3 my-md-5 py-2">
    <div class="p-3 p-md-4 rounded-4 shadow-sm border" style="background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%); border-color: rgba(212, 175, 55, 0.15) !important;">
        <div class="text-center mb-3">
            <span class="hero-eyebrow fw-semibold text-uppercase tracking-wider small d-inline-flex align-items-center gap-1 text-gold">
                <span class="material-symbols-outlined fs-6 anim-float-icon">trending_up</span>
                <span class="lang-en-text">LIVE MARKET</span>
                <span class="lang-ta-text">நேரடி சந்தை</span>
            </span>
            <h2 class="fw-bold mt-1 text-navy fs-4 fs-md-2">
                <span class="lang-en-text">Today's Mandi Wholesale Rates</span>
                <span class="lang-ta-text">இன்றைய மண்டி மொத்த விற்பனை விலைகள்</span>
            </h2>
        </div>

        <div class="row g-2 row-equal-height">
            @if (dashboard != null && dashboard.Any())
            {
                foreach (var m in dashboard)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="innovative-card p-2.5 h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <span class="p-1 rounded-circle bg-light text-gold d-inline-flex align-items-center">
                                        <span class="material-symbols-outlined fs-6">
                                            @(m.Product?.SubCategory?.Category?.Type == BRT.Models.CategoryType.Garlic ? "eco" : "shopping_cart_checkout")
                                        </span>
                                    </span>
                                    <span class="badge bg-danger text-white extra-small fw-semibold pulse-badge" style="font-size:0.6rem;">LIVE</span>
                                </div>
                                <h6 class="fw-bold mb-0 text-navy text-truncate extra-small">@m.Product?.Name</h6>
