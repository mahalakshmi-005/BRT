@{
    ViewData["Title"] = "About Us";
}

<!-- Fonts & Material Icons CDN -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Cinzel:wght@700;800;900&display=swap" rel="stylesheet">

<style>
    :root {
        --brt-gold: #D4AF37;
        --brt-gold-dark: #AA820A;
        --brt-gold-light: #FBF5E8;
        --dark-bg: #0F172A;
        --border-color: #E2E8F0;
        --text-main: #1E293B;
        --text-muted: #64748B;
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: var(--text-main);
        background-color: #FAFAFA;
        overflow-x: hidden;
    }

    /* Sacred Symbol Wrapper */
    .sacred-band-wrapper {
        background: linear-gradient(180deg, rgba(212, 175, 55, 0.08) 0%, #FFFFFF 100%);
        padding: 24px 16px 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-bottom: 1px solid rgba(212, 175, 55, 0.12);
    }

    .sacred-symbol-large {
        width: 42px;
        height: 42px;
        object-fit: contain;
    }

    .sacred-text-below {
        font-family: 'Cinzel', serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--brt-gold-dark);
        letter-spacing: 3px;
        margin: 0;
        text-transform: uppercase;
    }

    /* About Hero Layout */
    .about-hero {
        padding: 40px 16px;
        background: radial-gradient(circle at center, rgba(212, 175, 55, 0.08) 0%, transparent 70%);
        position: relative;
    }

    .about-logo-badge-giant {
        max-width: 170px;
        width: 100%;
        border-radius: 28px;
        box-shadow: 0 20px 40px -10px rgba(15, 23, 42, 0.15);
        border: 4px solid #FFFFFF;
        margin-bottom: 1rem;
    }

    /* Royal Branding Font Style for B Raj Traders */
    .about-hero-tagline {
        font-family: 'Cinzel', serif;
        font-weight: 900;
        font-size: 2.8rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        background: linear-gradient(135deg, #0F172A 0%, #AA820A 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 0.5rem;
    }

    /* Motto Ribbon */
    .luxury-motto-ribbon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        margin: 1.2rem auto;
        padding: 12px 28px;
        background: #FFFFFF;
        border: 1px solid rgba(212, 175, 55, 0.3);
        border-radius: 100px;
        box-shadow: 0 10px 25px rgba(15, 23, 42, 0.04);
    }

    .luxury-motto-text {
        font-family: 'Cinzel', serif;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 1px;
        color: #1E293B;
        text-transform: uppercase;
    }

    .luxury-motto-divider {
        color: var(--brt-gold);
    }

    /* Headings */
    .hero-eyebrow {
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-transform: uppercase;
    }

    .section-title-premium {
        font-weight: 800;
        font-size: 2.2rem;
        color: var(--dark-bg);
    }

    /* Stat Cards */
    .stat-card-stack {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .stat-premium-box {
        background: #FFFFFF;
        border-radius: 20px;
        padding: 1.5rem;
        border: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .stat-premium-box .stat-num {
        font-size: 2.2rem;
        font-weight: 800;
        color: var(--dark-bg);
    }

    .stat-premium-box .stat-label {
        font-weight: 600;
        color: var(--text-muted);
        text-align: right;
    }

    /* Cards Styling */
    .timeline-node-premium, .process-card {
        background: #FFFFFF;
        border: 1px solid var(--border-color);
        border-radius: 20px;
        padding: 1.5rem;
        height: 100%;
        box-sizing: border-box;
    }

    .node-year {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--brt-gold-dark);
    }

    .node-dot {
        width: 10px;
        height: 10px;
        background: var(--dark-bg);
        border-radius: 50%;
        margin: 8px auto;
    }

    .process-card {
        position: relative;
    }

    .process-badge {
        position: absolute;
        top: -12px;
        left: 20px;
        background: var(--dark-bg);
        color: #FFFFFF;
        font-weight: 800;
        padding: 2px 10px;
        border-radius: 50px;
        font-size: 0.75rem;
    }

    .process-card h4 {
        font-size: 1.1rem;
        font-weight: 700;
        margin: 1rem 0 0.4rem;
    }

    /* Trust & Mission Cards */
    .mv-card-new, .trust-box-premium {
        background: #FFFFFF;
        border-radius: 20px;
        padding: 1.8rem;
        border: 1px solid var(--border-color);
        height: 100%;
    }

    .trust-box-premium {
        display: flex;
        gap: 1.2rem;
    }

    .trust-icon-wrapper {
        width: 50px;
        height: 50px;
        background: rgba(212, 175, 55, 0.1);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .trust-icon-wrapper span {
        font-size: 1.6rem;
        color: var(--brt-gold-dark);
    }

    /* Buttons */
    .btn-brt-gold {
        background: linear-gradient(135deg, var(--brt-gold) 0%, var(--brt-gold-dark) 100%);
        color: #FFFFFF !important;
        font-weight: 700;
        padding: 12px 32px;
        border-radius: 50px;
        display: inline-block;
        text-decoration: none;
    }

    .btn-brt-outline-dark {
        background: transparent;
        color: var(--dark-bg) !important;
        font-weight: 700;
        padding: 12px 32px;
        border-radius: 50px;
        border: 2px solid var(--dark-bg);
        display: inline-block;
        text-decoration: none;
    }

    /* ==========================================================
       🔥 FIXED HORIZONTAL SCROLL FOR MOBILE (GUARANTEED WORKING)
       ========================================================== */
    @@media (max-width: 991.98px) {
        .about-hero-tagline {
            font-size: 2rem;
        }

        .luxury-motto-ribbon {
            flex-direction: column;
            gap: 6px;
            border-radius: 16px;
            padding: 12px;
        }

        .luxury-motto-divider {
            display: none;
        }

        /* 100% Working Mobile Horizontal Scroll Engine */
        .brt-mobile-scroll {
            display: flex !important;
            flex-direction: row !important;
            flex-wrap: nowrap !important;
            overflow-x: auto !important;
            overflow-y: hidden !important;
            -webkit-overflow-scrolling: touch !important;
            scroll-snap-type: x mandatory !important;
            padding: 10px 5px 20px 5px !important;
            gap: 15px !important;
            width: 100% !important;
            box-sizing: border-box !important;
        }

        /* Hide scrollbar visually but keep functionality */
        .brt-mobile-scroll::-webkit-scrollbar {
            display: none !important;
        }

        .brt-mobile-card {
            flex: 0 0 82% !important; /* Screen-ல் 82% Card தெரியும், மீதி அடுத்த கார்டை காட்டும் */
            max-width: 82% !important;
            width: 82% !important;
            scroll-snap-align: start !important;
            box-sizing: border-box !important;
        }

        .btn-brt-gold, .btn-brt-outline-dark {
            width: 100%;
            text-align: center;
            margin-bottom: 8px;
        }
    }
</style>

