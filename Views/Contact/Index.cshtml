@{
    var settings = (Dictionary<string, string>)ViewBag.Settings;
}

<!-- Premium Typography & Icons -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

<style>
    /* ==========================================================================
       THEME DESIGN SYSTEM (WHITE & GOLD ELEGANCE)
       ========================================================================== */
    :root {
        --theme-bg: #FAF9F6;
        --card-bg: #FFFFFF;
        --border-color: #E2E8F0;
        --gold-primary: #B8860B;
        --gold-light: #DFB15B;
        --gold-bg: rgba(184, 134, 11, 0.05);
        --text-dark: #1E293B;
        --text-muted: #64748B;
        --whatsapp-green: #25D366;
        --radius-lg: 16px;
        --radius-md: 10px;
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--theme-bg);
        color: var(--text-dark);
        overflow-x: hidden;
    }

    /* LANGUAGE SWITCH LOGIC */
    html[lang="en"] .lang-en-node { display: block !important; }
    html[lang="en"] .lang-ta-node { display: none !important; }
    html[lang="ta"] .lang-en-node { display: none !important; }
    html[lang="ta"] .lang-ta-node { display: block !important; }

    html[lang="en"] .lang-en-inline { display: inline-block !important; }
    html[lang="en"] .lang-ta-inline { display: none !important; }
    html[lang="ta"] .lang-en-inline { display: none !important; }
    html[lang="ta"] .lang-ta-inline { display: inline-block !important; }

    /* ==========================================================================
       HERO HEADER SECTION
       ========================================================================== */
    .hero-section {
        padding: 50px 20px 30px;
        text-align: center;
        background: radial-gradient(circle at 50% 0%, rgba(184, 134, 11, 0.08) 0%, rgba(250, 249, 246, 0) 70%);
    }

    .sub-tag {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 2px;
        color: var(--gold-primary);
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .hero-title {
        font-family: 'Cinzel', serif;
        font-weight: 700;
        font-size: clamp(2rem, 4vw, 3rem);
        color: var(--text-dark);
        margin-bottom: 12px;
        letter-spacing: -0.5px;
    }

    .hero-divider {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-bottom: 16px;
    }

    .hero-divider .line {
        width: 40px;
        height: 1px;
        background: var(--gold-light);
    }

    .hero-divider .sub-text {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        color: var(--gold-primary);
        text-transform: uppercase;
    }

    .hero-desc {
        color: var(--text-muted);
        max-width: 550px;
        margin: 0 auto;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    /* ==========================================================================
       WHITE & GOLD CARDS
       ========================================================================== */
    .theme-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        padding: clamp(20px, 3vw, 32px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
        height: 100%;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .theme-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 35px rgba(184, 134, 11, 0.08);
        border-color: rgba(184, 134, 11, 0.3);
    }

    .card-title {
        font-family: 'Cinzel', serif;
        font-weight: 700;
        font-size: 1.35rem;
        color: var(--text-dark);
        margin-bottom: 24px;
        text-align: center;
    }

    /* INFO TILE */
    .info-tile {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 14px;
        background: var(--theme-bg);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        margin-bottom: 14px;
    }

    .info-tile .tile-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--gold-bg);
        border: 1px solid rgba(184, 134, 11, 0.2);
        color: var(--gold-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .tile-label {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 1px;
        color: var(--gold-primary);
        text-transform: uppercase;
        margin-bottom: 2px;
    }

    .tile-value {
        font-size: 0.92rem;
        font-weight: 600;
        color: var(--text-dark);
        line-height: 1.4;
    }

    /* ACTION BUTTONS */
    .action-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
        gap: 10px;
        margin: 20px 0;
    }

    .btn-action {
        padding: 10px 14px;
        border-radius: var(--radius-md);
        font-weight: 600;
        font-size: 0.85rem;
        text-decoration: none !important;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all 0.3s ease;
    }

    .btn-outline-gold {
        border: 1px solid var(--gold-primary);
        color: var(--gold-primary);
        background: transparent;
    }

    .btn-outline-gold:hover {
        background: var(--gold-primary);
        color: #FFF;
    }

    .btn-wa {
        background: var(--whatsapp-green);
        color: #FFF !important;
    }

    .btn-wa:hover {
        opacity: 0.9;
        transform: translateY(-2px);
    }

    /* FORM STYLING */
    .form-group {
        margin-bottom: 18px;
    }

    .form-group label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.8px;
        color: var(--text-dark);
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .form-group input, 
    .form-group textarea {
        width: 100%;
        background: var(--theme-bg);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        padding: 12px 14px;
        font-size: 0.9rem;
        color: var(--text-dark);
        transition: all 0.3s ease;
    }

    .form-group input:focus, 
    .form-group textarea:focus {
        outline: none;
        border-color: var(--gold-primary);
        background: #FFF;
        box-shadow: 0 0 0 3px rgba(184, 134, 11, 0.1);
    }

    .btn-submit {
        width: 100%;
        padding: 14px;
        background: linear-gradient(135deg, #DFB15B 0%, #B8860B 100%);
        border: none;
        border-radius: var(--radius-md);
        color: #FFF;
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 6px 18px rgba(184, 134, 11, 0.2);
    }

    .btn-submit:hover {
        opacity: 0.95;
        transform: translateY(-2px);
        box-shadow: 0 10px 22px rgba(184, 134, 11, 0.3);
    }

    /* MAP CONTAINER */
    .map-frame {
        border-radius: var(--radius-md);
        overflow: hidden;
        border: 1px solid var(--border-color);
    }

    /* MOBILE DOCK */
    .mobile-dock {
        display: none;
        position: fixed;
        bottom: 12px;
        left: 12px;
        right: 12px;
        z-index: 999;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);
        border: 1px solid var(--border-color);
        border-radius: 100px;
        padding: 8px 16px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        justify-content: space-around;
    }

    .dock-link {
        color: var(--text-dark);
        text-decoration: none !important;
        display: flex;
        flex-direction: column;
        align-items: center;
        font-size: 0.65rem;
        font-weight: 700;
    }

    .dock-link span.material-symbols-outlined {
        color: var(--gold-primary);
        font-size: 1.25rem;
    }

    @@media (max-width: 767px) {
        .mobile-dock { display: flex; }
        body { padding-bottom: 60px; }
    }
</style>

<!-- HERO HEADER -->
<section class="hero-section">
    <div class="container">
        <span class="sub-tag">Contact Us</span>
        <h1 class="hero-title">B RAJ TRADERS</h1>
        
        <div class="hero-divider">
            <div class="line"></div>
            <span class="sub-text">Honest Pricing • Premium Quality • Unmatched Legacy</span>
            <div class="line"></div>
        </div>

        <p class="hero-desc lang-en-node">Get in touch with us for bulk trade inquiries, real-time garlic pricing, and dependable supply schedules.</p>
        <p class="hero-desc lang-ta-node">மொத்த வியாபாரம், பூண்டு விலை நிலவரங்கள் மற்றும் விநியோக தகவல்களுக்கு எங்களை எளிதாக தொடர்பு கொள்ளவும்.</p>
    </div>
</section>

<!-- MAIN CONTENT CONTENT -->
<div class="container my-4">
    <div class="row g-4">

        <!-- LEFT CARD: CONTACT INFORMATION -->
        <div class="col-lg-5 col-md-12">
            <div class="theme-card">
                <h2 class="card-title">
                    <span class="lang-en-inline">Get In Touch</span>
                    <span class="lang-ta-inline">தொடர்பு கொள்ள</span>
                </h2>

                <!-- PROPRIETOR INFO -->
                <div class="info-tile">
                    <div class="tile-icon">
                        <span class="material-symbols-outlined">person</span>
                    </div>
                    <div>
                        <div class="tile-label">Proprietor</div>
                        <div class="tile-value">BR. Gopal B.A.</div>
                    </div>
                </div>

                <!-- ADDRESS INFO -->
                <div class="info-tile">
                    <div class="tile-icon">
                        <span class="material-symbols-outlined">location_on</span>
                    </div>
                    <div>
                        <div class="tile-label">
                            <span class="lang-en-inline">Address</span>
                            <span class="lang-ta-inline">முகவரி</span>
                        </div>
                        <div class="tile-value">
                            TCA Complex, Periyakulam Road, Vadugapatti, Tamil Nadu 625603
                        </div>
                    </div>
                </div>

                <!-- PHONE INFO -->
                <div class="info-tile">
                    <div class="tile-icon">
                        <span class="material-symbols-outlined">call</span>
                    </div>
                    <div>
                        <div class="tile-label">
                            <span class="lang-en-inline">Phone</span>
                            <span class="lang-ta-inline">தொலைபேசி</span>
                        </div>
                        <div class="tile-value" style="color: var(--gold-primary);">
                            +91 98656 80694
                        </div>
                    </div>
                </div>

                <!-- EMAIL INFO -->
                <div class="info-tile">
                    <div class="tile-icon">
                        <span class="material-symbols-outlined">mail</span>
                    </div>
                    <div>
                        <div class="tile-label">
                            <span class="lang-en-inline">Email</span>
                            <span class="lang-ta-inline">மின்னஞ்சல்</span>
                        </div>
                        <div class="tile-value">
                            brajtraders2000@gmail.com
                        </div>
                    </div>
                </div>

                <!-- ACTION BUTTONS -->
                <div class="action-grid">
                    <a href="tel:9865680694" class="btn-action btn-outline-gold">
                        <span class="material-symbols-outlined" style="font-size:16px;">call</span> Call
                    </a>
                    <a href="https://api.whatsapp.com/send?phone=919865680694" target="_blank" class="btn-action btn-wa">
                        <span class="material-symbols-outlined" style="font-size:16px;">chat</span> WhatsApp
                    </a>
                </div>

                <!-- MAP -->
                <div class="map-frame">
                    <iframe 
                        src="https://www.google.com/maps?q=10.106752,77.569917&z=17&output=embed" 
                        width="100%" 
                        height="180" 
                        style="border:0; display:block;" 
                        allowfullscreen="" 
                        loading="lazy">
                    </iframe>
                </div>
            </div>
        </div>

        <!-- RIGHT CARD: CONTACT FORM -->
        <div class="col-lg-7 col-md-12">
            <div class="theme-card">
                <h2 class="card-title">
                    <span class="lang-en-inline">Send A Message</span>
                    <span class="lang-ta-inline">செய்தி அனுப்ப</span>
                </h2>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success mb-4" style="border-radius: var(--radius-md); font-weight:600; background:#E8F5E9; color:#2E7D32; border:1px solid #C8E6C9; padding:12px 16px;">
                        @TempData["Success"]
                    </div>

                    @if (TempData["WhatsAppUrl"] != null)
                    {
                        var waUrl = TempData["WhatsAppUrl"]!.ToString();
                        <a href="@waUrl" target="_blank" class="btn-action btn-wa mb-4" style="padding:12px 20px;">
                            <span class="material-symbols-outlined">chat</span> Send via WhatsApp
                        </a>
                        <script>
                            setTimeout(function () {
                                window.open('@Html.Raw(waUrl)', '_blank');
                            }, 1000);
                        </script>
                    }
                }

                <form asp-controller="Contact" asp-action="Submit" method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label>
                            <span class="lang-en-inline">Your Name</span>
                            <span class="lang-ta-inline">உங்கள் பெயர்</span>
                        </label>
                        <input name="Name" required placeholder="e.g. John Doe" />
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>
                                    <span class="lang-en-inline">Phone Number</span>
                                    <span class="lang-ta-inline">தொலைபேசி எண்</span>
                                </label>
                                <input name="Phone" required type="tel" placeholder="+91..." />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>
                                    <span class="lang-en-inline">Email Address</span>
                                    <span class="lang-ta-inline">மின்னஞ்சல் முகவரி</span>
                                </label>
                                <input name="Email" type="email" placeholder="name@domain.com" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            <span class="lang-en-inline">Message</span>
                            <span class="lang-ta-inline">செய்தி</span>
                        </label>
                        <textarea name="Message" rows="5" required placeholder="How can we help you?"></textarea>
                    </div>

                    <button type="submit" class="btn-submit">
                        <span class="lang-en-inline">Submit Request</span>
                        <span class="lang-ta-inline">சமர்ப்பிக்கவும்</span>
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>

<!-- MOBILE QUICK DOCK -->
<div class="mobile-dock">
    <a href="tel:9865680694" class="dock-link">
        <span class="material-symbols-outlined">call</span>
        <span>Call</span>
    </a>
    <a href="https://api.whatsapp.com/send?phone=919865680694" target="_blank" class="dock-link">
        <span class="material-symbols-outlined" style="color:var(--whatsapp-green);">chat</span>
        <span>WhatsApp</span>
    </a>
    <a href="https://www.google.com/maps/dir/?api=1&destination=10.106752,77.569917" target="_blank" class="dock-link">
        <span class="material-symbols-outlined">near_me</span>
        <span>Route</span>
    </a>
</div>
