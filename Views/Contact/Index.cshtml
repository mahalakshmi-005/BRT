@{
    var settings = (Dictionary<string, string>)ViewBag.Settings;
}

<!-- High-Performance Modern Architecture Fonts & Icons -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=Playfair+Display:ital,wght@1,600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

<style>
    /* ==========================================================================
       DESIGN SYSTEM & CORE VARIABLES
       ========================================================================== */
    :root {
        --brt-bg: #07090E;
        --brt-surface: rgba(18, 24, 38, 0.75);
        --brt-surface-hover: rgba(28, 36, 56, 0.85);
        --brt-border: rgba(212, 175, 55, 0.18);
        --brt-border-glow: rgba(212, 175, 55, 0.45);
        
        --gold-primary: #D4AF37;
        --gold-light: #F3E7C4;
        --gold-dark: #8A6F27;
        --gold-gradient: linear-gradient(135deg, #F3E7C4 0%, #D4AF37 50%, #8A6F27 100%);
        --glass-gradient: linear-gradient(180deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.01) 100%);
        
        --text-heading: #F8FAFC;
        --text-sub: #94A3B8;
        --text-muted: #64748B;
        
        --whatsapp-color: #25D366;
        --email-color: #EA4335;
        --radius-xl: 28px;
        --radius-lg: 18px;
        --radius-md: 12px;
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--brt-bg);
        color: var(--text-heading);
        overflow-x: hidden;
    }

    /* LANGUAGE SWITCH LOGIC */
    html[lang="en"] .lang-en-node { display: block !important; }
    html[lang="en"] .lang-ta-node { display: none !important; }
    html[lang="ta"] .lang-en-node { display: none !important; }
    html[lang="ta"] .lang-ta-node { display: block !important; }

    html[lang="en"] .lang-en-inline { display: inline-block !important; }
    html[lang="en"] .lang-ta-inline { display: none !important; }
    html[lang="ta"] .lang-en-inline { display: none !important; }
    html[lang="ta"] .lang-ta-inline { display: inline-block !important; }

    /* ==========================================================================
       HERO CANOPY ARCHITECTURE
       ========================================================================== */
    .ultra-hero {
        position: relative;
        padding: 70px 20px 40px;
        text-align: center;
        background: radial-gradient(circle at 50% 0%, rgba(212, 175, 55, 0.12) 0%, rgba(7, 9, 14, 0) 70%);
    }

    .ultra-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 18px;
        background: rgba(212, 175, 55, 0.08);
        border: 1px solid var(--brt-border);
        border-radius: 100px;
        color: var(--gold-primary);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 24px;
        backdrop-filter: blur(10px);
    }

    .ultra-hero h1 {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: clamp(2.2rem, 5vw, 3.8rem);
        line-height: 1.1;
        letter-spacing: -0.03em;
        background: linear-gradient(180deg, #FFFFFF 0%, #CBD5E1 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 16px;
    }

    .ultra-hero p {
        color: var(--text-sub);
        font-size: clamp(0.98rem, 2vw, 1.15rem);
        max-width: 600px;
        margin: 0 auto 32px;
        line-height: 1.6;
    }

    /* HERO TRUST NODES */
    .trust-metrics-wrapper {
        display: flex;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .trust-node {
        background: var(--brt-surface);
        border: 1px solid var(--brt-border);
        padding: 10px 20px;
        border-radius: 100px;
        display: flex;
        align-items: center;
        gap: 10px;
        backdrop-filter: blur(12px);
        transition: all 0.3s ease;
    }

    .trust-node:hover {
        border-color: var(--gold-primary);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(212, 175, 55, 0.15);
    }

    .trust-node .icon {
        background: var(--gold-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-size: 1.25rem;
    }

    .trust-node span.text {
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: var(--text-heading);
        text-transform: uppercase;
    }

    /* ==========================================================================
       BENTO GRID GLASS CARDS
       ========================================================================== */
    .bento-card {
        background: var(--brt-surface);
        background-image: var(--glass-gradient);
        border: 1px solid var(--brt-border);
        border-radius: var(--radius-xl);
        padding: clamp(24px, 4vw, 40px);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.5);
        height: 100%;
        transition: border-color 0.4s ease, transform 0.4s ease;
    }

    .bento-card:hover {
        border-color: var(--brt-border-glow);
    }

    .card-head-title {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: clamp(1.4rem, 2.5vw, 1.8rem);
        color: var(--text-heading);
        margin-bottom: 24px;
        letter-spacing: -0.02em;
    }

    /* LIVE RADAR BAR */
    .radar-status {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 6px 14px;
        background: rgba(34, 197, 94, 0.08);
        border: 1px solid rgba(34, 197, 94, 0.25);
        border-radius: 100px;
        font-size: 0.78rem;
        font-weight: 700;
        color: #4ADE80;
        margin-bottom: 20px;
    }

    .radar-dot {
        width: 8px;
        height: 8px;
        background: #22C55E;
        border-radius: 50%;
        position: relative;
    }

    .radar-dot::after {
        content: '';
        position: absolute;
        inset: 0;
        background: #22C55E;
        border-radius: 50%;
        animation: pulseRadar 2s infinite ease-out;
    }

    /* EXECUTIVE BADGE */
    .exec-card-badge {
        background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.01) 100%);
        border: 1px solid rgba(255, 255, 255, 0.08);
        padding: 16px 20px;
        border-radius: var(--radius-lg);
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
    }

    .exec-role {
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: var(--gold-primary);
        font-weight: 800;
    }

    .exec-name-title {
        font-size: 1.2rem;
        font-weight: 700;
        font-family: 'Space Grotesk', sans-serif;
        color: var(--text-heading);
    }

    .exec-sign {
        font-family: 'Playfair Display', Georgia, serif;
        font-style: italic;
        color: var(--text-muted);
        font-size: 1.1rem;
        padding-left: 15px;
        border-left: 1px solid rgba(255,255,255,0.1);
    }

    /* HQ TILES */
    .hq-tile {
        display: flex;
        gap: 16px;
        padding: 18px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: var(--radius-lg);
        margin-bottom: 16px;
        transition: all 0.3s ease;
    }

    .hq-tile:hover {
        background: rgba(255, 255, 255, 0.04);
        border-color: var(--brt-border);
    }

    .tile-orb {
        width: 48px;
        height: 48px;
        border-radius: var(--radius-md);
        background: rgba(212, 175, 55, 0.1);
        border: 1px solid var(--brt-border);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .tile-orb span {
        background: var(--gold-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .tile-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--text-muted);
        font-weight: 700;
        margin-bottom: 2px;
    }

    .tile-val {
        font-size: 0.98rem;
        color: var(--text-heading);
        font-weight: 600;
        line-height: 1.5;
    }

    /* ACTION BUTTON DECK */
    .action-deck {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
        gap: 10px;
        margin: 24px 0;
    }

    .btn-act {
        padding: 12px 14px;
        border-radius: var(--radius-md);
        font-weight: 700;
        font-size: 0.85rem;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all 0.3s ease;
        text-align: center;
    }

    .btn-act-wire {
        background: transparent;
        border: 1px solid var(--text-sub);
        color: var(--text-heading);
    }

    .btn-act-wire:hover {
        background: var(--text-heading);
        color: var(--brt-bg);
    }

    .btn-act-wa {
        background: var(--whatsapp-color);
        color: #FFFFFF !important;
        box-shadow: 0 6px 16px rgba(37, 211, 102, 0.25);
    }

    .btn-act-wa:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(37, 211, 102, 0.4);
    }

    .btn-act-mail {
        background: var(--email-color);
        color: #FFFFFF !important;
        box-shadow: 0 6px 16px rgba(234, 67, 53, 0.25);
    }

    .btn-act-mail:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(234, 67, 53, 0.4);
    }

    /* MAP CONTAINER */
    .geo-map-card {
        border-radius: var(--radius-lg);
        overflow: hidden;
        border: 1px solid var(--brt-border);
        background: #000;
    }

    .geo-map-actions {
        padding: 14px;
        background: rgba(18, 24, 38, 0.95);
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .geo-map-actions .btn-act {
        flex: 1;
        min-width: 130px;
    }

    /* ==========================================================================
       HIGH-PERFORMANCE FORM STYLES
       ========================================================================== */
    .field-group {
        margin-bottom: 20px;
    }

    .field-group label {
        display: block;
        font-size: 0.72rem;
        font-weight: 800;
        color: var(--gold-primary);
        text-transform: uppercase;
        letter-spacing: 1.2px;
        margin-bottom: 8px;
    }

    .field-group input, 
    .field-group textarea {
        width: 100%;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--radius-md);
        padding: 14px 16px;
        font-size: 0.95rem;
        color: var(--text-heading);
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .field-group input:focus, 
    .field-group textarea:focus {
        outline: none;
        background: rgba(255, 255, 255, 0.07);
        border-color: var(--gold-primary);
        box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15);
    }

    .btn-dispatch {
        width: 100%;
        padding: 16px;
        background: var(--gold-gradient);
        border: none;
        border-radius: var(--radius-md);
        color: #07090E;
        font-weight: 800;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 10px 25px rgba(212, 175, 55, 0.25);
    }

    .btn-dispatch:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 30px rgba(212, 175, 55, 0.4);
    }

    /* ==========================================================================
       MOBILE FLOATING QUICK ACTION DOCK (INNOVATIVE MOBILE UI)
       ========================================================================== */
    .mobile-float-dock {
        display: none;
        position: fixed;
        bottom: 16px;
        left: 16px;
        right: 16px;
        z-index: 999;
        background: rgba(18, 24, 38, 0.85);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--brt-border);
        border-radius: 100px;
        padding: 8px 12px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.6);
        justify-content: space-around;
        align-items: center;
    }

    .dock-item {
        color: var(--text-heading);
        text-decoration: none !important;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        font-size: 0.65rem;
        font-weight: 700;
    }

    .dock-item .material-symbols-outlined {
        font-size: 1.3rem;
        color: var(--gold-primary);
    }

    /* ANIMATIONS & RESPONSIVE BREAKPOINTS */
    @keyframes pulseRadar {
        0% { transform: scale(1); opacity: 1; }
        100% { transform: scale(3.5); opacity: 0; }
    }

    @media (max-width: 991px) {
        .bento-card { padding: 28px 20px; }
    }

    @media (max-width: 767px) {
        .trust-metrics-wrapper { display: grid; grid-template-columns: 1fr; }
        .trust-node { justify-content: center; }
        .mobile-float-dock { display: flex; }
        body { padding-bottom: 70px; } /* Space for float dock */
    }
</style>

