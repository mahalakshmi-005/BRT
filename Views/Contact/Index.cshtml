                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success shadow-sm mb-4" style="border-radius: var(--radius-md); font-weight:700; background:rgba(34,197,94,0.15); border:1px solid rgba(34,197,94,0.3); color:#4ADE80; padding:16px 20px;">
                        @TempData["Success"]
                    </div>

                    @if (TempData["WhatsAppUrl"] != null)
                    {
                        var waUrl = TempData["WhatsAppUrl"]!.ToString();
                        <a href="@waUrl" target="_blank" id="contactWaBtn" class="btn-act btn-act-wa mb-4" style="padding: 14px 24px; display:inline-flex;">
                            <span class="material-symbols-outlined" style="font-size:1.2rem;">chat</span>
                            Send Details via WhatsApp
                        </a>
                        <script>
                            setTimeout(function () {
                                window.open('@Html.Raw(waUrl)', '_blank');
                            }, 1200);
                        </script>
                    }
                }

                <form asp-controller="Contact" asp-action="Submit" method="post">
                    @Html.AntiForgeryToken()

                    <div class="field-group">
                        <label>
                            <span class="lang-en-inline">Full Identity / Name</span>
                            <span class="lang-ta-inline">முழுப் பெயர்</span>
                        </label>
                        <input name="Name" required autocomplete="off" placeholder="e.g. John Doe / எ.கா. இராமன்" />
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="field-group">
                                <label>
                                    <span class="lang-en-inline">Comms Line / Phone</span>
                                    <span class="lang-ta-inline">தொலைபேசி எண்</span>
                                </label>
                                <input name="Phone" required type="tel" placeholder="+91..." />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="field-group">
                                <label>
                                    <span class="lang-en-inline">Digital Mail / Email</span>
                                    <span class="lang-ta-inline">மின்னஞ்சல் முகவரி</span>
                                </label>
                                <input name="Email" type="email" placeholder="name@domain.com" />
                            </div>
                        </div>
                    </div>

                    <div class="field-group">
                        <label>
                            <span class="lang-en-inline">Transmission / Message</span>
                            <span class="lang-ta-inline">செய்தி விவரம்</span>
                        </label>
                        <textarea name="Message" rows="6" required placeholder="Outline your logistics requirements or volume targets..."></textarea>
                    </div>

                    <button type="submit" class="btn-dispatch">
                        <span class="lang-en-inline">Dispatch Message</span>
                        <span class="lang-ta-inline">செய்தியை சமர்ப்பிக்க</span>
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>

