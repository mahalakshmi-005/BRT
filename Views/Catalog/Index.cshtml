@{
    // Layout Integration
    Layout = "_Layout";
}

<!-- Premium Corporate Fonts & Icons -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cinzel:wght@600;700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

<style>
    :root {
        --brt-gold: #D4AF37;
        --brt-gold-light: #FBF5E8;
        --brt-gold-glow: rgba(212, 175, 55, 0.25);
        --dark-corporate: #0F172A;
        --dark-surface: #1E293B;
        --text-main: #0F172A;
        --text-muted: #64748B;
        --border-refined: #E2E8F0;
        --bg-light: #F8FAFC;
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: #FAFAFC;
        color: var(--text-main);
        overflow-x: hidden;
    }

    /* Dynamic Language Switch Rules */
    html[lang="en"] .lang-ta, body[lang="en"] .lang-ta { display: none !important; }
    html[lang="en"] .lang-en, body[lang="en"] .lang-en { display: inline-block !important; }
    html[lang="ta"] .lang-en, body[lang="ta"] .lang-en { display: none !important; }
    html[lang="ta"] .lang-ta, body[lang="ta"] .lang-ta { display: inline-block !important; }

    /* Ultra Hero Section */
    .corporate-hero-block {
        background: radial-gradient(circle at 50% 0%, rgba(212, 175, 55, 0.12) 0%, rgba(248, 250, 252, 0) 70%), var(--bg-light);
        padding: 80px 20px 60px;
        position: relative;
        border-bottom: 1px solid var(--border-refined);
        text-align: center;
    }

    .hero-badge {
        background: linear-gradient(135deg, rgba(212, 175, 55, 0.15) 0%, rgba(170, 130, 10, 0.08) 100%);
        border: 1px solid rgba(212, 175, 55, 0.3);
        color: #AA820A;
        padding: 6px 18px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.78rem;
        display: inline-block;
        margin-bottom: 1.2rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    .hero-corporate-title {
        font-family: 'Cinzel', serif;
        font-weight: 900;
        font-size: clamp(2.2rem, 5vw, 3.6rem);
        color: var(--dark-corporate);
        letter-spacing: -0.5px;
        line-height: 1.2;
        margin-bottom: 14px;
    }

    .hero-corporate-subtitle {
        font-size: clamp(0.95rem, 2vw, 1.15rem);
        color: var(--text-muted);
        max-width: 620px;
        margin: 0 auto;
        font-weight: 500;
        line-height: 1.6;
    }

    /* Grid & Mobile Layout System */
    .b2b-grid-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 2rem;
        justify-content: center;
    }

    .wholesale-corporate-link {
        text-decoration: none !important;
        display: block;
        height: 100%;
    }

    /* Innovative B2B Card Design */
    .b2b-catalog-card {
        background: #FFFFFF;
        border: 1px solid var(--border-refined);
        border-radius: 28px;
        padding: 36px 32px;
        height: 100%;
        position: relative;
        box-shadow: 0 10px 30px -10px rgba(15, 23, 42, 0.04);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-sizing: border-box;
    }

    .card-meta-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    /* Live Ticker Pill */
    .live-ticker-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        background: rgba(16, 185, 129, 0.08);
        border: 1px solid rgba(16, 185, 129, 0.2);
        border-radius: 100px;
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #059669;
    }

    .live-ticker-pill span.blink-dot {
        width: 7px;
        height: 7px;
        background: #10B981;
        border-radius: 50%;
        animation: tickerBlink 1.5s infinite;
    }

    /* Avatar System */
    .b2b-avatar-holder {
        position: relative;
        width: 80px;
        height: 80px;
    }

    .b2b-avatar-glow-ring {
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--brt-gold), transparent);
        opacity: 0;
        transition: opacity 0.4s ease;
        z-index: 1;
    }

    .b2b-image-avatar-frame {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        overflow: hidden;
        border: 2px solid #FFFFFF;
        background: #FAFAFA;
        position: relative;
        z-index: 2;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 8px 20px -6px rgba(0,0,0,0.1);
    }

    .b2b-image-avatar-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    /* Card Hover States (Desktop) - Notice @@media below */
    @@media (min-width: 992px) {
        .wholesale-corporate-link:hover .b2b-catalog-card {
            transform: translateY(-8px);
            border-color: rgba(212, 175, 55, 0.5);
            box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.1), 0 0 30px var(--brt-gold-glow);
        }

        .wholesale-corporate-link:hover .b2b-avatar-glow-ring { opacity: 1; }
        .wholesale-corporate-link:hover .b2b-image-avatar-frame { transform: scale(1.05); }
        .wholesale-corporate-link:hover .b2b-image-avatar-frame img { transform: scale(1.15) rotate(3deg); }
        .wholesale-corporate-link:hover .b2b-card-title { color: #AA820A; }
        .wholesale-corporate-link:hover .b2b-action-trigger { color: #AA820A; }
        .wholesale-corporate-link:hover .btn-circle-arrow {
            background: var(--dark-corporate);
            color: #FFFFFF;
        }
        .wholesale-corporate-link:hover .btn-circle-arrow span {
            color: #FFFFFF;
            transform: rotate(-45deg);
        }
    }

    .b2b-card-title {
        font-family: 'Cinzel', serif;
        font-weight: 800;
        font-size: 1.75rem;
        color: var(--dark-corporate);
        margin-bottom: 12px;
        transition: color 0.3s ease;
    }

    .b2b-card-desc {
        font-size: 0.95rem;
        color: var(--text-muted);
        line-height: 1.6;
        margin-bottom: 28px;
        font-weight: 400;
    }

    /* Action Trigger Button */
    .b2b-action-trigger {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding-top: 20px;
        border-top: 1px dashed var(--border-refined);
        font-size: 0.85rem;
        font-weight: 800;
        color: var(--dark-corporate);
        text-transform: uppercase;
        letter-spacing: 1.2px;
        transition: all 0.3s ease;
    }

    .btn-circle-arrow {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #F1F5F9;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .btn-circle-arrow span {
        font-size: 1.2rem;
        color: var(--dark-corporate);
        transition: transform 0.3s ease;
    }

    /* Keyframes - Notice @@keyframes below */
    @@keyframes tickerBlink {
        0%, 100% { opacity: 0.3; }
        50% { opacity: 1; }
    }

    /* Mobile Responsive Optimizations - Notice @@media below */
    @@media (max-width: 767.98px) {
        .corporate-hero-block {
            padding: 50px 15px 40px;
        }

        .b2b-catalog-card {
            padding: 24px 20px;
            border-radius: 20px;
        }

        .b2b-avatar-holder {
            width: 68px;
            height: 68px;
        }

        .b2b-card-title {
            font-size: 1.45rem;
        }

        .b2b-card-desc {
            font-size: 0.88rem;
            margin-bottom: 20px;
        }
    }
</style>

<!-- Hero Section -->
<section class="corporate-hero-block">
    <div class="container">
        <div class="hero-badge">
            <span class="lang-en">B2B Trade Portal</span>
            <span class="lang-ta">B2B வர்த்தக தளம்</span>
        </div>
        <h1 class="hero-corporate-title lang-en">Wholesale Products</h1>
        <h1 class="hero-corporate-title lang-ta">மொத்த விற்பனை தயாரிப்புகள்</h1>

        <p class="hero-corporate-subtitle lang-en">Choose a category to browse live-priced dealer wholesale rates</p>
        <p class="hero-corporate-subtitle lang-ta">டீலர் மொத்த விற்பனை விலைகளை அறிய ஒரு வகையைத் தேர்ந்தெடுக்கவும்</p>
    </div>
</section>

