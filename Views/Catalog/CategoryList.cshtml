@model List<SubCategory>
@{
    ViewData["Title"] = ViewData["Title"] ?? "Live Market Rates";
    var todaysPrices = (ViewBag.TodaysPrices as Dictionary<int, MarketPrice>) ?? new Dictionary<int, MarketPrice>();
}

<!-- Premium Fonts & Icons -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cinzel:wght@700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

<style>
    :root {
        --primary-gold: #D4AF37;
        --primary-gold-dark: #AA820A;
        --bg-dark: #0F172A;
        --bg-body: #F8FAFC;
        --card-bg: #FFFFFF;
        --text-dark: #0F172A;
        --text-muted: #64748B;
        --up-green: #10B981;
        --up-bg: rgba(16, 185, 129, 0.1);
        --down-red: #EF4444;
        --down-bg: rgba(239, 68, 68, 0.1);
        --border-color: #E2E8F0;
        --app-shadow: 0 12px 28px rgba(15, 23, 42, 0.06);
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--bg-body);
        color: var(--text-dark);
        padding-bottom: 90px;
    }

    /* DYNAMIC LANGUAGE CONTROLLER */
    html[lang="en"] .lang-ta-text, body[lang="en"] .lang-ta-text { display: none !important; }
    html[lang="ta"] .lang-en-text, body[lang="ta"] .lang-en-text { display: none !important; }

    /* NATIVE APP HERO HEADER */
    .app-hero-header {
        background: radial-gradient(135deg, #1E293B 0%, #0F172A 100%);
        color: #FFFFFF;
        padding: 30px 20px 50px 20px;
        border-radius: 0 0 28px 28px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    }

   /* NATIVE APP HERO HEADER */
.app-hero-header .brand-title {
    font-family: 'Cinzel', serif;
    font-size: 2rem;
    font-weight: 900;
    color: #000000 !important; /* Text-ஐ சுத்தமான கறுப்பு நிறமாக மாற்றுகிறது */
    margin: 0;
}
    /* STICKY CONTROL DOCK (Search & Categories) */
    .app-control-dock {
        margin-top: -30px;
        z-index: 100;
        position: sticky;
        top: 10px;
    }

    .dock-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 20px;
        padding: 10px 14px;
        box-shadow: var(--app-shadow);
    }

    .search-input-group {
        position: relative;
        flex: 1;
    }

    .search-input-group input {
        border: none;
        background: #F1F5F9;
        border-radius: 12px;
        padding: 10px 14px 10px 42px;
        font-size: 0.9rem;
        width: 100%;
        outline: none;
        transition: all 0.3s;
    }

    .search-input-group input:focus {
        background: #FFFFFF;
        box-shadow: 0 0 0 2px var(--primary-gold);
    }

    .search-input-group .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
    }

    /* HORIZONTAL CATEGORY CHIPS SCROLLER */
    .category-pills-scroll {
        display: flex;
        gap: 8px;
        overflow-x: auto;
        padding: 10px 0 2px 0;
        scroll-behavior: smooth;
    }

    .category-pills-scroll::-webkit-scrollbar { display: none; }

    .cat-pill {
        white-space: nowrap;
        background: #FFFFFF;
        border: 1px solid var(--border-color);
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--text-dark);
        text-decoration: none !important;
        transition: all 0.2s;
        box-shadow: 0 2px 5px rgba(0,0,0,0.03);
    }

    .cat-pill:hover, .cat-pill.active {
        background: var(--text-dark);
        color: var(--primary-gold);
        border-color: var(--text-dark);
    }

    /* SECTION HEADER & NAV CONTROLS */
    .category-header-wrap {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
        padding: 0 4px;
    }

    .category-section-title {
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--text-dark);
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
    }

    .category-section-title::before {
        content: '';
        width: 5px;
        height: 22px;
        background: var(--primary-gold);
        border-radius: 4px;
    }

    .scroll-arrow-btn {
        border: none;
        background: #FFFFFF;
        border: 1px solid var(--border-color);
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        transition: all 0.2s;
    }

    .scroll-arrow-btn:hover {
        background: var(--text-dark);
        color: #FFFFFF;
    }

    /* HORIZONTAL PRODUCTS SCROLLER (MAIN FEATURE) */
    .products-horizontal-scroll {
        display: flex;
        gap: 16px;
        overflow-x: auto;
        padding: 6px 4px 16px 4px;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
    }

    .products-horizontal-scroll::-webkit-scrollbar {
        height: 6px;
    }

    .products-horizontal-scroll::-webkit-scrollbar-thumb {
        background: #CBD5E1;
        border-radius: 10px;
    }

    .horizontal-product-card-item {
        flex: 0 0 240px; /* Card Width in Horizontal Scroll */
    }

    @@media (max-width: 576px) {
        .horizontal-product-card-item {
            flex: 0 0 200px; /* Mobile Friendly Card Width */
        }
    }

    /* PRODUCT CARD STRUCTURE */
    .product-app-card {
        background: var(--card-bg);
        border-radius: 20px;
        border: 1px solid var(--border-color);
        padding: 12px;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
    }

    .product-app-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 28px rgba(0,0,0,0.08);
        border-color: var(--primary-gold);
    }

    /* MEDIA CONTAINER WITH BADGE */
    .card-media-wrapper {
        width: 100%;
        height: 140px;
        border-radius: 14px;
        overflow: hidden;
        background: #F8FAFC;
        position: relative;
    }

    .card-media-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .product-app-card:hover .card-media-wrapper img {
        transform: scale(1.06);
    }

    .hot-deal-tag {
        position: absolute;
        top: 8px;
        left: 8px;
        background: var(--down-red);
        color: #FFFFFF;
        font-size: 0.65rem;
        font-weight: 800;
        padding: 2px 6px;
        border-radius: 6px;
        text-transform: uppercase;
        box-shadow: 0 2px 6px rgba(239, 68, 68, 0.4);
    }

    .share-quick-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        background: rgba(255, 255, 255, 0.9);
        border: none;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: var(--text-dark);
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }

    .fallback-media-icon {
        font-size: 3rem;
        color: #CBD5E1;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
    }

    /* METADATA */
    .product-title {
        font-size: 0.95rem;
        font-weight: 800;
        color: var(--text-dark);
        margin: 10px 0 4px 0;
        line-height: 1.3;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .grade-chip {
        display: inline-block;
        background: rgba(212, 175, 55, 0.12);
        color: var(--primary-gold-dark);
        font-size: 0.65rem;
        font-weight: 800;
        padding: 2px 6px;
        border-radius: 6px;
        text-transform: uppercase;
    }

    /* PRICE TICKER BOX */
    .price-ticker-box {
        background: #F8FAFC;
        border-radius: 12px;
        padding: 8px 10px;
        margin: 10px 0;
        border: 1px solid var(--border-color);
    }

    .price-value {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--text-dark);
    }

    .price-unit {
        font-size: 0.7rem;
        color: var(--text-muted);
        font-weight: 600;
    }

    .price-badge {
        display: inline-flex;
        align-items: center;
        gap: 2px;
        font-size: 0.72rem;
        font-weight: 800;
        padding: 3px 6px;
        border-radius: 6px;
    }

    .price-badge.up { background: var(--up-bg); color: var(--up-green); }
    .price-badge.down { background: var(--down-bg); color: var(--down-red); }
    .price-badge.stable { background: #E2E8F0; color: var(--text-muted); }

    /* ACTION BUTTONS */
    .action-btn-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
    }

    .btn-app {
        border: none;
        padding: 8px 10px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        text-decoration: none !important;
        transition: all 0.2s ease;
    }

    .btn-app-outline { background: #F1F5F9; color: var(--text-dark); }
    .btn-app-outline:hover { background: #E2E8F0; }

    .btn-app-primary { background: var(--text-dark); color: #FFFFFF !important; }
    .btn-app-primary:hover { background: var(--primary-gold-dark); }

    /* MOBILE NATIVE BOTTOM BAR */
    .mobile-bottom-nav {
        display: none;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: #FFFFFF;
        border-top: 1px solid var(--border-color);
        padding: 8px 16px;
        box-shadow: 0 -5px 20px rgba(0,0,0,0.05);
        z-index: 1000;
    }

    .mobile-nav-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        color: var(--text-muted);
        text-decoration: none !important;
        font-size: 0.7rem;
        font-weight: 600;
    }

    .mobile-nav-item.active { color: var(--primary-gold-dark); }

    @@media (max-width: 767.98px) {
        .mobile-bottom-nav { display: flex; justify-content: space-around; }
        .app-hero-header { padding: 24px 16px 45px 16px; }
    }
</style>

<!-- Hero Section Header -->
<header class="app-hero-header text-center">
    <div class="container">
        <h1 class="brand-title">@ViewData["Title"]</h1>
        <p class="mb-0 text-white-50 small">Live Market Rates & Instant Bulk Order</p>
    </div>
</header>

<!-- Sticky Control Dock -->
<div class="container app-control-dock">
    <div class="dock-card">
        <!-- Search Field -->
        <div class="search-input-group">
            <span class="material-symbols-outlined search-icon">search</span>
            <input type="text" id="productSearchInput" placeholder="Search product / பொருளைத் தேடுக..." onkeyup="filterProducts()">
        </div>

        <!-- Dynamic Category Filter Chips -->
        <div class="category-pills-scroll mt-2">
            <a href="javascript:void(0)" class="cat-pill active" onclick="scrollToCategory('all')">All Products</a>
            @foreach (var sub in Model)
            {
                <a href="javascript:void(0)" class="cat-pill" onclick="scrollToCategory('cat-@sub.Id')">@sub.Name</a>
            }
        </div>
    </div>
</div>

<!-- Main Content Area -->
<main class="container my-4">
    <div id="productsContainer">
        @foreach (var sub in Model)
        {
            <div class="sub-category-block mb-4" id="cat-@sub.Id" data-category-name="@sub.Name @sub.NameTamil">
                
                <!-- Category Section Header with Carousel Navigation -->
                <div class="category-header-wrap">
                    <h2 class="category-section-title">
                        <span class="lang-en-text">@sub.Name</span>
                        <span class="lang-ta-text">@(!string.IsNullOrEmpty(sub.NameTamil) ? sub.NameTamil : sub.Name)</span>
                    </h2>
                    <div class="d-flex gap-1">
                        <button class="scroll-arrow-btn" onclick="scrollCarousel('scroll-@sub.Id', -260)" title="Scroll Left">
                            <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back_ios</span>
                        </button>
                        <button class="scroll-arrow-btn" onclick="scrollCarousel('scroll-@sub.Id', 260)" title="Scroll Right">
                            <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward_ios</span>
                        </button>
                    </div>
                </div>

                <!-- HORIZONTAL SCROLLING CONTAINER -->
                <div class="products-horizontal-scroll" id="scroll-@sub.Id">
                    @foreach (var p in sub.Products)
                    {
                        var hasPrice = todaysPrices.ContainsKey(p.Id);
                        var mp = hasPrice ? todaysPrices[p.Id] : null;

                        <div class="horizontal-product-card-item col-product" data-product-name="@p.Name @p.NameTamil">
                            <div class="product-app-card">
                                
                                <div>
                                    <!-- Media Container -->
                                    <div class="card-media-wrapper">
                                        @if (!string.IsNullOrEmpty(p.ImageUrl))
                                        {
                                            <img src="@p.ImageUrl" alt="@p.Name" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span class="material-symbols-outlined fallback-media-icon">eco</span>
                                        }

                                        <!-- Hot Deal Badge if price drop -->
                                        @if (mp != null && mp.PriceDifference < 0)
                                        {
                                            <span class="hot-deal-tag">Price Drop</span>
                                        }

                                        <!-- WhatsApp Share Button -->
                                        <button class="share-quick-btn" onclick="shareProduct('@p.Name', '@(mp != null ? mp.TodayPrice.ToString("F2") : "N/A")')" title="Share">
                                            <span class="material-symbols-outlined" style="font-size: 16px;">share</span>
                                        </button>
                                    </div>

                                    <!-- Title & Grade -->
                                    <h3 class="product-title lang-en-text">@p.Name</h3>
                                    <h3 class="product-title lang-ta-text">@(!string.IsNullOrEmpty(p.NameTamil) ? p.NameTamil : p.Name)</h3>

                                    @if (!string.IsNullOrEmpty(p.Grade))
                                    {
                                        <span class="grade-chip">@p.Grade</span>
                                    }

                                    <!-- Price Ticker Box -->
                                    @if (mp != null)
                                    {
                                        var diff = mp.PriceDifference;
                                        var diffClass = diff > 0 ? "up" : diff < 0 ? "down" : "stable";
                                        var diffIcon = diff > 0 ? "north_east" : diff < 0 ? "south_east" : "remove";

                                        <div class="price-ticker-box">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <div>
                                                    <span class="price-value">₹@mp.TodayPrice.ToString("F2")</span>
                                                    <span class="price-unit">/ KG</span>
                                                </div>
                                                <div class="price-badge @diffClass">
                                                    <span class="material-symbols-outlined" style="font-size: 12px;">@diffIcon</span>
                                                    <span>₹@Math.Abs(diff).ToString("F2")</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="price-ticker-box text-center py-2">
                                            <span class="text-muted small fw-bold lang-en-text">Price on Request</span>
                                            <span class="text-muted small fw-bold lang-ta-text">கேட்கப்படும் போது வழங்கப்படும்</span>
                                        </div>
                                    }
                                </div>

                                <!-- Action Buttons -->
                                <div class="action-btn-grid mt-2">
                                    <a asp-controller="Catalog" asp-action="Product" asp-route-slug="@p.Slug" class="btn-app btn-app-outline">
                                        <span class="material-symbols-outlined" style="font-size: 15px;">visibility</span>
                                        <span class="lang-en-text">View</span>
                                        <span class="lang-ta-text">விவரம்</span>
                                    </a>
                                    <a asp-controller="Order" asp-action="Request" asp-route-productId="@p.Id" class="btn-app btn-app-primary">
                                        <span class="material-symbols-outlined" style="font-size: 15px;">shopping_bag</span>
                                        <span class="lang-en-text">Order</span>
                                        <span class="lang-ta-text">ஆர்டர்</span>
                                    </a>
                                </div>

                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</main>

<!-- Mobile Bottom Navigation -->
<nav class="mobile-bottom-nav">
    <a href="#" class="mobile-nav-item active">
        <span class="material-symbols-outlined">storefront</span>
        <span>Market</span>
    </a>
    <a href="#" class="mobile-nav-item">
        <span class="material-symbols-outlined">trending_up</span>
        <span>Live Rates</span>
    </a>
    <a href="#" class="mobile-nav-item">
        <span class="material-symbols-outlined">shopping_cart</span>
        <span>Orders</span>
    </a>
    <a href="#" class="mobile-nav-item">
        <span class="material-symbols-outlined">person</span>
        <span>Account</span>
    </a>
</nav>

<!-- Interactive Scripts -->
<script>
    // Smooth Horizontal Scroll Action for Categories
    function scrollCarousel(containerId, distance) {
        const container = document.getElementById(containerId);
        container.scrollBy({ left: distance, behavior: 'smooth' });
    }

    // Smooth Scroll to Category from Pills
    function scrollToCategory(catId) {
        if (catId === 'all') {
            window.scrollTo({ top: 0, behavior: 'smooth' });
            return;
        }
        const target = document.getElementById(catId);
        if (target) {
            const offset = 120; // Dock spacing adjustment
            const bodyRect = document.body.getBoundingClientRect().top;
            const elementRect = target.getBoundingClientRect().top;
            const elementPosition = elementRect - bodyRect;
            const offsetPosition = elementPosition - offset;

            window.scrollTo({
                top: offsetPosition,
                behavior: 'smooth'
            });
        }
    }

    // Instant Search Filter across Horizontal Cards
    function filterProducts() {
        const query = document.getElementById('productSearchInput').value.toLowerCase().trim();
        const productCols = document.querySelectorAll('.col-product');
        const subBlocks = document.querySelectorAll('.sub-category-block');

        productCols.forEach(col => {
            const name = col.getAttribute('data-product-name').toLowerCase();
            if (name.includes(query)) {
                col.style.display = 'block';
            } else {
                col.style.display = 'none';
            }
        });

        // Hide Empty Categories automatically
        subBlocks.forEach(block => {
            const visibleProducts = block.querySelectorAll('.col-product[style="display: block;"], .col-product:not([style*="display: none"])');
            if (visibleProducts.length === 0 && query !== '') {
                block.style.display = 'none';
            } else {
                block.style.display = 'block';
            }
        });
    }

    // WhatsApp Native Share Integration
    function shareProduct(name, price) {
        const shareText = `*${name}*\nToday's Market Rate: ₹${price}/KG\nCheck out live rates here: ${window.location.href}`;
        if (navigator.share) {
            navigator.share({
                title: name,
                text: shareText,
                url: window.location.href,
            }).catch(() => {});
        } else {
            window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(shareText)}`, '_blank');
        }
    }
</script>
