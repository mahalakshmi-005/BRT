@model List<SubCategory>
@{
    ViewData["Title"] = ViewData["Title"] ?? "Live Market Rates";
    var todaysPrices = (ViewBag.TodaysPrices as Dictionary<int, MarketPrice>) ?? new Dictionary<int, MarketPrice>();
}

<!-- Premium Fonts & Material Symbols -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cinzel:wght@700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

<style>
    :root {
        --primary-gold: #D4AF37;
        --primary-gold-dark: #B8860B;
        --bg-dark: #0B132B;
        --bg-body: #F4F6F9;
        --card-bg: #FFFFFF;
        --text-dark: #0F172A;
        --text-muted: #64748B;
        --up-green: #10B981;
        --up-bg: rgba(16, 185, 129, 0.1);
        --down-red: #EF4444;
        --down-bg: rgba(239, 68, 68, 0.1);
        --border-color: #E2E8F0;
        --app-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--bg-body);
        color: var(--text-dark);
        padding-bottom: 80px; /* Space for Mobile Bottom Nav */
    }

    /* AUTOMATIC DYNAMIC LANGUAGE CONTROLLER */
    html[lang="en"] .lang-ta-text, body[lang="en"] .lang-ta-text { display: none !important; }
    html[lang="ta"] .lang-en-text, body[lang="ta"] .lang-en-text { display: none !important; }

    /* NATIVE APP HERO HEADER */
    .app-hero-header {
        background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
        color: #FFFFFF;
        padding: 40px 20px 60px 20px;
        border-radius: 0 0 28px 28px;
        position: relative;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    }

    .app-hero-header .brand-title {
        font-family: 'Cinzel', serif;
        font-size: 2.2rem;
        font-weight: 900;
        background: linear-gradient(180deg, #FFFFFF 0%, var(--primary-gold) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin: 0;
    }

    /* STICKY APP CONTROL DOCK (Search & Layout Toggle) */
    .app-control-dock {
        margin-top: -30px;
        z-index: 100;
        position: sticky;
        top: 15px;
    }

    .dock-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.6);
        border-radius: 20px;
        padding: 10px 16px;
        box-shadow: var(--app-shadow);
    }

    .search-input-group {
        position: relative;
        flex: 1;
    }

    .search-input-group input {
        border: none;
        background: #F1F5F9;
        border-radius: 12px;
        padding: 10px 14px 10px 42px;
        font-size: 0.9rem;
        width: 100%;
        outline: none;
        transition: all 0.3s;
    }

    .search-input-group input:focus {
        background: #FFFFFF;
        box-shadow: 0 0 0 2px var(--primary-gold);
    }

    .search-input-group .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
    }

    .view-btn {
        border: none;
        background: #F1F5F9;
        color: var(--text-dark);
        border-radius: 12px;
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
    }

    .view-btn.active {
        background: var(--text-dark);
        color: var(--primary-gold);
    }

    /* CATEGORY HEADER */
    .category-section-title {
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--text-dark);
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
    }

    .category-section-title::before {
        content: '';
        width: 6px;
        height: 24px;
        background: var(--primary-gold);
        border-radius: 4px;
    }

    /* MODERN PRODUCT CARD ARCHITECTURE */
    .product-app-card {
        background: var(--card-bg);
        border-radius: 20px;
        border: 1px solid var(--border-color);
        padding: 14px;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
    }

    .product-app-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.08);
        border-color: var(--primary-gold);
    }

    /* MEDIA CONTAINER */
    .card-media-wrapper {
        width: 100%;
        height: 160px;
        border-radius: 14px;
        overflow: hidden;
        background: #F8FAFC;
        position: relative;
    }

    .card-media-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .product-app-card:hover .card-media-wrapper img {
        transform: scale(1.06);
    }

    .fallback-media-icon {
        font-size: 3.5rem;
        color: #CBD5E1;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
    }

    /* PRODUCT METADATA */
    .product-title {
        font-size: 1.05rem;
        font-weight: 800;
        color: var(--text-dark);
        margin: 12px 0 4px 0;
        line-height: 1.3;
    }

    .grade-chip {
        display: inline-block;
        background: rgba(212, 175, 55, 0.12);
        color: var(--primary-gold-dark);
        font-size: 0.68rem;
        font-weight: 800;
        padding: 2px 8px;
        border-radius: 6px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    /* PRICE TICKER BOX */
    .price-ticker-box {
        background: #F8FAFC;
        border-radius: 12px;
        padding: 10px 12px;
        margin: 12px 0;
        border: 1px solid var(--border-color);
    }

    .price-value {
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--text-dark);
    }

    .price-unit {
        font-size: 0.75rem;
        color: var(--text-muted);
        font-weight: 600;
    }

    .price-badge {
        display: inline-flex;
        align-items: center;
        gap: 2px;
        font-size: 0.75rem;
        font-weight: 800;
        padding: 4px 8px;
        border-radius: 8px;
    }

    .price-badge.up { background: var(--up-bg); color: var(--up-green); }
    .price-badge.down { background: var(--down-bg); color: var(--down-red); }
    .price-badge.stable { background: #E2E8F0; color: var(--text-muted); }

    .price-timestamp {
        font-size: 0.68rem;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 4px;
        margin-top: 6px;
        padding-top: 6px;
        border-top: 1px dashed var(--border-color);
    }

    /* PACKAGING TAGS */
    .pack-tags-group {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-bottom: 12px;
    }

    .pack-tag {
        background: #F1F5F9;
        color: #475569;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 6px;
    }

    /* ACTION BUTTONS */
    .action-btn-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .btn-app {
        border: none;
        padding: 9px 12px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-decoration: none !important;
        transition: all 0.2s ease;
    }

    .btn-app-outline {
        background: #F1F5F9;
        color: var(--text-dark);
    }

    .btn-app-outline:hover {
        background: #E2E8F0;
    }

    .btn-app-primary {
        background: var(--text-dark);
        color: #FFFFFF !important;
    }

    .btn-app-primary:hover {
        background: var(--primary-gold-dark);
    }

    /* LIST VIEW OVERRIDES */
    .list-view .col-product {
        width: 100% !important;
    }

    .list-view .product-app-card {
        flex-direction: row;
        align-items: center;
        gap: 16px;
    }

    .list-view .card-media-wrapper {
        width: 110px;
        height: 110px;
        flex-shrink: 0;
    }

    .list-view .product-info-wrap {
        flex: 1;
    }

    /* MOBILE NATIVE BOTTOM BAR */
    .mobile-bottom-nav {
        display: none;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: #FFFFFF;
        border-top: 1px solid var(--border-color);
        padding: 8px 16px;
        box-shadow: 0 -5px 20px rgba(0,0,0,0.05);
        z-index: 1000;
    }

    .mobile-nav-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        color: var(--text-muted);
        text-decoration: none !important;
        font-size: 0.7rem;
        font-weight: 600;
    }

    .mobile-nav-item.active {
        color: var(--primary-gold-dark);
    }

    /* RESPONSIVE BREAKPOINTS */
    @@media (max-width: 767.98px) {
        .mobile-bottom-nav { display: flex; justify-content: space-around; }
        .app-hero-header { padding: 30px 16px 50px 16px; text-align: center; }
        .app-hero-header .brand-title { font-size: 1.8rem; }
        .card-media-wrapper { height: 130px; }
        .list-view .product-app-card { flex-direction: column; }
        .list-view .card-media-wrapper { width: 100%; height: 130px; }
    }
</style>

<!-- Hero Section Header -->
<header class="app-hero-header text-center">
    <div class="container">
        <h1 class="brand-title">@ViewData["Title"]</h1>
        <p class="mb-0 text-white-50 small">Live Market Analytics & Instant Ordering</p>
    </div>
</header>

<!-- Sticky App Control Dock -->
<div class="container app-control-dock">
    <div class="dock-card d-flex align-items-center gap-2">
        <div class="search-input-group">
            <span class="material-symbols-outlined search-icon">search</span>
            <input type="text" id="productSearchInput" placeholder="Search product / பொருளைத் தேடுக..." onkeyup="filterProducts()">
        </div>
        <button class="view-btn active" id="btnGridView" onclick="switchView('grid')" title="Grid View">
            <span class="material-symbols-outlined">grid_view</span>
        </button>
        <button class="view-btn" id="btnListView" onclick="switchView('list')" title="List View">
            <span class="material-symbols-outlined">view_list</span>
        </button>
    </div>
</div>

<!-- Main Content Area -->
<main class="container my-4">
    <div id="productsContainer">
        @foreach (var sub in Model)
        {
            <div class="sub-category-block mb-4" data-category-name="@sub.Name @sub.NameTamil">
                <!-- Category Section Header -->
                <div class="category-section-title">
                    <span class="lang-en-text">@sub.Name</span>
                    <span class="lang-ta-text">@(!string.IsNullOrEmpty(sub.NameTamil) ? sub.NameTamil : sub.Name)</span>
                </div>

                <!-- Products Grid Matrix -->
                <div class="row g-3 products-grid-row">
                    @foreach (var p in sub.Products)
                    {
                        var hasPrice = todaysPrices.ContainsKey(p.Id);
                        var mp = hasPrice ? todaysPrices[p.Id] : null;

                        <div class="col-6 col-md-4 col-lg-3 col-product" data-product-name="@p.Name @p.NameTamil">
                            <div class="product-app-card">
                                
                                <!-- Top Area / Media -->
                                <div class="product-info-wrap">
                                    <div class="card-media-wrapper">
                                        @if (!string.IsNullOrEmpty(p.ImageUrl))
                                        {
                                            <img src="@p.ImageUrl" alt="@p.Name" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span class="material-symbols-outlined fallback-media-icon">eco</span>
                                        }
                                    </div>

                                    <!-- Title & Grade -->
                                    <h3 class="product-title lang-en-text">@p.Name</h3>
                                    <h3 class="product-title lang-ta-text">@(!string.IsNullOrEmpty(p.NameTamil) ? p.NameTamil : p.Name)</h3>

                                    @if (!string.IsNullOrEmpty(p.Grade))
                                    {
                                        <span class="grade-chip">@p.Grade</span>
                                    }

                                    <!-- Price Ticker Box -->
                                    @if (mp != null)
                                    {
                                        var diff = mp.PriceDifference;
                                        var diffClass = diff > 0 ? "up" : diff < 0 ? "down" : "stable";
                                        var diffIcon = diff > 0 ? "north_east" : diff < 0 ? "south_east" : "remove";

                                        <div class="price-ticker-box">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <div>
                                                    <span class="price-value">₹@mp.TodayPrice.ToString("F2")</span>
                                                    <span class="price-unit">/ KG</span>
                                                </div>
                                                <div class="price-badge @diffClass">
                                                    <span class="material-symbols-outlined" style="font-size: 14px;">@diffIcon</span>
                                                    <span>₹@Math.Abs(diff).ToString("F2")</span>
                                                </div>
                                            </div>
                                            <div class="price-timestamp">
                                                <span class="material-symbols-outlined" style="font-size: 12px;">schedule</span>
                                                <span class="lang-en-text">Updated @mp.UpdatedAt.ToString("dd MMM HH:mm")</span>
                                                <span class="lang-ta-text">மாற்றி அமைக்கப்பட்டது @mp.UpdatedAt.ToString("dd MMM HH:mm")</span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="price-ticker-box text-center py-2">
                                            <span class="text-muted small fw-bold lang-en-text">Price on request</span>
                                            <span class="text-muted small fw-bold lang-ta-text">விலை விவரங்களுக்கு அணுகவும்</span>
                                        </div>
                                    }

                                    <!-- Packaging Chips -->
                                    <div class="pack-tags-group">
                                        @foreach (var pt in p.PackingTypes.Where(x => x.IsActive && x.IsWholesale))
                                        {
                                            <span class="pack-tag">@pt.PackSize</span>
                                        }
                                    </div>
                                </div>

                                <!-- Action Buttons Row -->
                                <div class="action-btn-grid mt-auto">
                                    <a asp-controller="Catalog" asp-action="Product" asp-route-slug="@p.Slug" class="btn-app btn-app-outline">
                                        <span class="material-symbols-outlined" style="font-size: 16px;">visibility</span>
                                        <span class="lang-en-text">View</span>
                                        <span class="lang-ta-text">விவரம்</span>
                                    </a>
                                    <a asp-controller="Order" asp-action="Request" asp-route-productId="@p.Id" class="btn-app btn-app-primary">
                                        <span class="material-symbols-outlined" style="font-size: 16px;">shopping_bag</span>
                                        <span class="lang-en-text">Order</span>
                                        <span class="lang-ta-text">ஆர்டர்</span>
                                    </a>
                                </div>

                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</main>

<!-- Mobile Native Bottom Navigation -->
<nav class="mobile-bottom-nav">
    <a href="#" class="mobile-nav-item active">
        <span class="material-symbols-outlined">storefront</span>
        <span>Market</span>
    </a>
    <a href="#" class="mobile-nav-item">
        <span class="material-symbols-outlined">trending_up</span>
        <span>Rates</span>
    </a>
    <a href="#" class="mobile-nav-item">
        <span class="material-symbols-outlined">receipt_long</span>
        <span>Orders</span>
    </a>
    <a href="#" class="mobile-nav-item">
        <span class="material-symbols-outlined">person</span>
        <span>Account</span>
    </a>
</nav>

<!-- Interactive Scripts -->
<script>
    // Grid vs List Layout Switcher
    function switchView(mode) {
        const container = document.getElementById('productsContainer');
        const btnGrid = document.getElementById('btnGridView');
        const btnList = document.getElementById('btnListView');

        if (mode === 'list') {
            container.classList.add('list-view');
            btnList.classList.add('active');
            btnGrid.classList.remove('active');
        } else {
            container.classList.remove('list-view');
            btnGrid.classList.add('active');
            btnList.classList.remove('active');
        }
    }

    // Instant Client-Side Search Engine
    function filterProducts() {
        const query = document.getElementById('productSearchInput').value.toLowerCase().trim();
        const productCols = document.querySelectorAll('.col-product');
        const subBlocks = document.querySelectorAll('.sub-category-block');

        productCols.forEach(col => {
            const name = col.getAttribute('data-product-name').toLowerCase();
            if (name.includes(query)) {
                col.style.display = 'block';
            } else {
                col.style.display = 'none';
            }
        });

        // Hide empty sub-category sections dynamically
        subBlocks.forEach(block => {
            const visibleProducts = block.querySelectorAll('.col-product[style="display: block;"], .col-product:not([style*="display: none"])');
            if (visibleProducts.length === 0 && query !== '') {
                block.style.display = 'none';
            } else {
                block.style.display = 'block';
            }
        });
    }
</script>
