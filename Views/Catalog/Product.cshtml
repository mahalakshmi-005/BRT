@model Product
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Name;
    var mp = (MarketPrice?)ViewBag.TodayPrice;
}

<!-- Premium Corporate Fonts & Icons Core -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

<style>
    :root {
        --brt-gold-pure: #B38F43;
        --brt-gold-dark: #8C6D2D;
        --brt-gold-light: #FBF4E4;
        --brt-dark-navy: #0B0F19;
        --brt-surface-white: #FFFFFF;
        --brt-bg-cream: #FFFDF9;
        --text-main: #1F2937;
        --text-muted: #6B7280;
        --border-refined: rgba(179, 143, 67, 0.18);
        
        /* Dynamic Price Box Colors */
        --price-down-border: #DC2626;
        --price-down-bg: #FEF2F2;
        --price-down-text: #991B1B;
        
        --price-up-border: #059669;
        --price-up-bg: #ECFDF5;
        --price-up-text: #065F46;

        --whatsapp-green: #25D366;
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--brt-bg-cream);
        color: var(--text-main);
        padding-bottom: 90px;
    }

    /* DYNAMIC LANGUAGE CONTROLLER */
    html[lang="en"] .lang-ta, body[lang="en"] .lang-ta { display: none !important; }
    html[lang="ta"] .lang-en, body[lang="ta"] .lang-en { display: none !important; }

    /* APP TOP NAV BAR */
    .app-top-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
    }

    .app-back-btn {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: var(--brt-surface-white);
        border: 1px solid var(--border-refined);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--brt-dark-navy);
        text-decoration: none !important;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
    }

    .corporate-path-capsule {
        display: inline-flex;
        align-items: center;
        background: var(--brt-gold-light);
        border: 1px solid var(--border-refined);
        color: var(--brt-gold-dark);
        padding: 6px 18px;
        border-radius: 100px;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.6px;
        text-transform: uppercase;
    }

    /* LEFT HERO IMAGE SHOWCASE */
    .app-hero-card {
        background: var(--brt-surface-white);
        border: 1px solid var(--border-refined);
        border-radius: 28px;
        padding: 24px;
        box-shadow: 0 10px 30px -10px rgba(11, 15, 25, 0.03);
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 380px;
    }

    .app-product-img {
        max-height: 320px;
        width: 100%;
        object-fit: cover;
        border-radius: 20px;
    }

    /* TYPOGRAPHY */
    .detail-corporate-title {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        font-size: 2.5rem;
        color: var(--brt-dark-navy);
        line-height: 1.1;
        margin: 0 0 8px 0;
    }

    .detail-corporate-title-ta {
        font-size: 2rem;
        font-weight: 800;
        color: var(--brt-dark-navy);
        margin: 0 0 8px 0;
    }

    .premium-grade-badge {
        display: inline-flex;
        align-items: center;
        background: var(--brt-dark-navy);
        color: var(--brt-gold-pure);
        font-weight: 800;
        font-size: 0.68rem;
        padding: 5px 12px;
        border-radius: 6px;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        margin-bottom: 20px;
    }

    /* EXACT FINANCIAL PRICE WIDGET (MATCHING SCREENSHOT) */
    .detail-ticker-panel {
        border-radius: 20px;
        padding: 20px 24px;
        margin: 20px 0;
        border: 1px solid var(--border-refined);
        background: var(--brt-surface-white);
        box-shadow: 0 8px 20px -5px rgba(11, 15, 25, 0.03);
        position: relative;
        overflow: hidden;
    }

    /* RED ACCENT LINE LEFT (PRICE DROP) */
    .detail-ticker-panel.state-down::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 6px;
        height: 100%;
        background: var(--price-down-border);
    }

    /* GREEN ACCENT LINE LEFT (PRICE UP) */
    .detail-ticker-panel.state-up::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 6px;
        height: 100%;
        background: var(--price-up-border);
    }

    .panel-price-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .panel-live-amount {
        font-size: 2.5rem;
        font-weight: 800;
        color: var(--brt-dark-navy);
        letter-spacing: -1px;
    }

    .panel-live-unit {
        font-size: 0.9rem;
        color: var(--text-muted);
        font-weight: 700;
    }

    .panel-status-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.82rem;
        font-weight: 800;
        padding: 6px 14px;
        border-radius: 10px;
    }

    .panel-status-pill.down {
        background: var(--price-down-bg);
        color: var(--price-down-text);
    }

    .panel-status-pill.up {
        background: var(--price-up-bg);
        color: var(--price-up-text);
    }

    .panel-ticker-footer {
        margin-top: 14px;
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--text-muted);
        display: flex;
        justify-content: space-between;
        border-top: 1px solid var(--border-refined);
        padding-top: 12px;
    }

    /* PACKAGING TAGS (CAPSULE CHIPS) */
    .quantum-pack-heading {
        font-size: 0.75rem;
        font-weight: 800;
        color: var(--brt-gold-dark);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 12px;
    }

    .quantum-pack-vault {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 24px;
    }

    .quantum-pack-chip {
        background: var(--brt-gold-light);
        border: 1px solid var(--border-refined);
        color: var(--brt-dark-navy);
        font-size: 0.82rem;
        font-weight: 700;
        padding: 8px 18px;
        border-radius: 12px;
    }

    /* 2x2 DISCLAIMER GRID */
    .cyber-disclaimer-vault {
        background: var(--brt-surface-white);
        border: 1px solid var(--border-refined);
        border-radius: 20px;
        padding: 20px;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .cyber-disclaimer-item {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .cyber-disclaimer-item .icon-wrapper {
        width: 38px;
        height: 38px;
        background: var(--brt-gold-light);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--brt-gold-dark);
        flex-shrink: 0;
    }

    .cyber-text-title {
        font-size: 0.8rem;
        font-weight: 800;
        color: var(--brt-dark-navy);
        display: block;
    }

    .cyber-text-subtitle {
        font-size: 0.72rem;
        color: var(--text-muted);
        display: block;
    }

    /* STICKY FOOTER BAR FOR MOBILE & DESKTOP */
    .app-sticky-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: var(--brt-surface-white);
        border-top: 1px solid var(--border-refined);
        padding: 14px 20px;
        box-shadow: 0 -10px 25px rgba(0,0,0,0.04);
        z-index: 1000;
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .btn-app-action {
        height: 52px;
        border-radius: 14px;
        font-weight: 800;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none !important;
        transition: transform 0.2s ease;
    }

    .btn-app-gold {
        background: var(--brt-dark-navy);
        color: var(--brt-surface-white) !important;
        flex: 3;
    }

    .btn-app-icon {
        width: 52px;
        background: var(--brt-surface-white);
        border: 1px solid var(--border-refined);
        color: var(--brt-dark-navy) !important;
        flex: 0 0 52px;
    }

    .btn-app-whatsapp {
        width: 52px;
        background: rgba(37, 211, 102, 0.12);
        border: 1px solid var(--whatsapp-green);
        color: var(--whatsapp-green) !important;
        flex: 0 0 52px;
    }

    /* RESPONSIVE CSS */
    @@media (min-width: 992px) {
        .app-sticky-bar {
            position: static;
            box-shadow: none;
            background: transparent;
            padding: 0;
            border: none;
        }
        body { padding-bottom: 20px; }
    }

    @@media (max-width: 576px) {
        .cyber-disclaimer-vault { grid-template-columns: 1fr; }
        .detail-corporate-title { font-size: 2rem; }
    }
</style>

<div class="container my-3 my-md-4">

    <!-- Top Navigation Bar -->
    <div class="app-top-nav">
        <a href="javascript:history.back()" class="app-back-btn">
            <span class="material-symbols-outlined">arrow_back</span>
        </a>

        <div class="corporate-path-capsule">
            @Model.SubCategory?.Category?.Name &rarr; @Model.SubCategory?.Name
        </div>

        <button class="app-back-btn" onclick="navigator.share ? navigator.share({title: '@Model.Name', url: window.location.href}) : null">
            <span class="material-symbols-outlined" style="font-size: 20px;">share</span>
        </button>
    </div>

    <div class="row g-4 align-items-center">

        <!-- Showcase Image Section (Left) -->
        <div class="col-lg-6">
            <div class="app-hero-card">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="app-product-img" />
                }
                else
                {
                    <div class="py-5 text-center">
                        <span class="material-symbols-outlined text-muted" style="font-size: 4rem;">eco</span>
                    </div>
                }
            </div>
        </div>

        <!-- Details & Pricing Engine (Right) -->
        <div class="col-lg-6">

            <!-- Titles -->
            <h1 class="detail-corporate-title lang-en">@Model.Name</h1>
            @if (!string.IsNullOrEmpty(Model.NameTamil))
            {
                <h1 class="detail-corporate-title-ta lang-ta">@Model.NameTamil</h1>
            }

            @if (!string.IsNullOrEmpty(Model.Grade))
            {
                <span class="premium-grade-badge">@Model.Grade</span>
            }

            <!-- Screenshot Style Ticker Panel -->
            @if (mp != null)
            {
                var diff = mp.PriceDifference;
                var boxState = diff < 0 ? "state-down" : diff > 0 ? "state-up" : "state-stable";

                <div class="detail-ticker-panel @boxState">
                    <div class="panel-price-row">
                        <div>
                            <span class="panel-live-amount">₹@mp.TodayPrice.ToString("F2")</span>
                            <span class="panel-live-unit">/KG</span>
                        </div>

                        @if (diff < 0)
                        {
                            <!-- Red Drop Badge -->
                            <span class="panel-status-pill down">
                                ↓ ₹@Math.Abs(diff).ToString("F2")
                            </span>
                        }
                        else if (diff > 0)
                        {
                            <!-- Green Up Badge -->
                            <span class="panel-status-pill up">
                                ↑ ₹@Math.Abs(diff).ToString("F2")
                            </span>
                        }
                    </div>

                    <div class="panel-ticker-footer">
                        <span>GST Net Included</span>
                        <span>@mp.UpdatedAt.ToString("dd MMM, hh:mm tt")</span>
                    </div>
                </div>
            }

            <!-- Packaging Sizes -->
            <h6 class="quantum-pack-heading">Available Packings</h6>
            <div class="quantum-pack-vault">
                @foreach (var pt in Model.PackingTypes.Where(x => x.IsActive))
                {
                    <span class="quantum-pack-chip">
                        @pt.PackSize @(pt.IsLoose ? "(Loose)" : "")
                    </span>
                }
            </div>

            <!-- 2x2 Regulatory Vault -->
            <div class="cyber-disclaimer-vault">
                <div class="cyber-disclaimer-item">
                    <div class="icon-wrapper">
                        <span class="material-symbols-outlined">verified</span>
                    </div>
                    <div>
                        <span class="cyber-text-title">Bulk Preferred</span>
                        <span class="cyber-text-subtitle">High volume</span>
                    </div>
                </div>

                <div class="cyber-disclaimer-item">
                    <div class="icon-wrapper">
                        <span class="material-symbols-outlined">receipt_long</span>
                    </div>
                    <div>
                        <span class="cyber-text-title">GST/Taxes Inc.</span>
                        <span class="cyber-text-subtitle">Tax Invoicing</span>
                    </div>
                </div>

                <div class="cyber-disclaimer-item">
                    <div class="icon-wrapper">
                        <span class="material-symbols-outlined">local_shipping</span>
                    </div>
                    <div>
                        <span class="cyber-text-title">Transport Extra</span>
                        <span class="cyber-text-subtitle">Ex-Warehouse</span>
                    </div>
                </div>

                <div class="cyber-disclaimer-item">
                    <div class="icon-wrapper">
                        <span class="material-symbols-outlined">gavel</span>
                    </div>
                    <div>
                        <span class="cyber-text-title">Admin Clearance</span>
                        <span class="cyber-text-subtitle">Verified Order</span>
                    </div>
                </div>
            </div>

            <!-- Sticky Action Buttons -->
            <div class="app-sticky-bar">
                <a asp-controller="Order" asp-action="Request" asp-route-productId="@Model.Id" class="btn-app-action btn-app-gold">
                    <span class="material-symbols-outlined">shopping_cart</span>
                    <span>Request Bulk Order</span>
                </a>
                <a href="tel:9865680694" class="btn-app-action btn-app-icon" title="Call">
                    <span class="material-symbols-outlined">call</span>
                </a>
                <a href="https://api.whatsapp.com/send?phone=919865680694&text=Enquiry%20about%20@Model.Name" class="btn-app-action btn-app-whatsapp" title="WhatsApp">
                    <span class="material-symbols-outlined">chat</span>
                </a>
            </div>

        </div>
    </div>
</div>
