@model Product
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Name;
    var mp = (MarketPrice?)ViewBag.TodayPrice;
}

<!-- Core Fonts & Icons -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cinzel:wght@700;900&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

<style>
    :root {
        --solid-black: #000000;
        --solid-white: #FFFFFF;
        --bg-canvas: #F8FAFC;
        --text-main: #0F172A;
        --text-muted: #64748B;
        --border-color: #E2E8F0;
        
        /* Dynamic Ticker Colors */
        --price-down-red: #EF4444;
        --price-down-bg: #FEF2F2;
        --price-up-green: #10B981;
        --price-up-bg: #ECFDF5;
        --whatsapp-color: #25D366;
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--bg-canvas);
        color: var(--text-main);
        padding-bottom: 90px;
    }

    /* AUTOMATIC DYNAMIC LANGUAGE CONTROLLER */
    html[lang="en"] .lang-ta, body[lang="en"] .lang-ta { display: none !important; }
    html[lang="ta"] .lang-en, body[lang="ta"] .lang-ta { display: none !important; }

    /* FLOATING TOP APP BAR (MOBILE & DESKTOP) */
    .app-top-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        border: 1px solid var(--border-color);
        border-radius: 18px;
        margin-top: 10px;
        margin-bottom: 20px;
    }

    .app-action-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--solid-white);
        border: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--solid-black);
        text-decoration: none !important;
        transition: all 0.2s ease;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .app-action-circle:hover {
        background: var(--solid-black);
        color: var(--solid-white);
        border-color: var(--solid-black);
    }

    .path-capsule-badge {
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.5px;
        color: var(--text-muted);
        text-transform: uppercase;
        background: var(--solid-white);
        padding: 6px 14px;
        border-radius: 20px;
        border: 1px solid var(--border-color);
    }

    /* HERO IMAGE GALLERY CONTAINER */
    .product-hero-card {
        background: var(--solid-white);
        border: 1px solid var(--border-color);
        border-radius: 24px;
        padding: 24px;
        position: relative;
        box-shadow: 0 10px 30px -10px rgba(0,0,0,0.05);
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 380px;
    }

    .product-hero-card img {
        max-height: 320px;
        width: auto;
        object-fit: contain;
        border-radius: 16px;
        transition: transform 0.3s ease;
    }

    .product-hero-card:hover img {
        transform: scale(1.03);
    }

    .hd-zoom-tag {
        position: absolute;
        top: 16px;
        right: 16px;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(8px);
        color: var(--solid-white);
        font-size: 0.65rem;
        font-weight: 800;
        padding: 4px 10px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* PRODUCT TYPOGRAPHY */
    .product-main-title {
        font-family: 'Cinzel', serif;
        font-weight: 900;
        font-size: 2.2rem;
        color: var(--solid-black);
        letter-spacing: -0.5px;
        margin-bottom: 6px;
    }

    .product-main-title-ta {
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--solid-black);
        margin-bottom: 6px;
    }

    .grade-badge-chip {
        display: inline-block;
        background: var(--solid-black);
        color: var(--solid-white);
        font-size: 0.7rem;
        font-weight: 800;
        padding: 4px 12px;
        border-radius: 6px;
        letter-spacing: 1px;
        margin-bottom: 18px;
        text-transform: uppercase;
    }

    /* LIVE TICKER EXCHANGE WIDGET */
    .ticker-exchange-card {
        border-radius: 20px;
        padding: 20px;
        margin: 18px 0;
        border: 1px solid var(--border-color);
        background: var(--solid-white);
        box-shadow: 0 6px 20px rgba(0,0,0,0.02);
        position: relative;
        overflow: hidden;
    }

    .ticker-exchange-card.is-drop {
        background: var(--price-down-bg);
        border-color: rgba(239, 68, 68, 0.3);
    }

    .ticker-exchange-card.is-up {
        background: var(--price-up-bg);
        border-color: rgba(16, 185, 129, 0.3);
    }

    .live-pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 6px;
    }

    .is-drop .live-pulse-dot { background: var(--price-down-red); box-shadow: 0 0 8px var(--price-down-red); }
    .is-up .live-pulse-dot { background: var(--price-up-green); box-shadow: 0 0 8px var(--price-up-green); }

    .price-big-num {
        font-size: 2.4rem;
        font-weight: 900;
        color: var(--solid-black);
        letter-spacing: -1px;
    }

    .diff-status-badge {
        font-size: 0.75rem;
        font-weight: 800;
        padding: 6px 12px;
        border-radius: 8px;
        color: var(--solid-white);
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .diff-status-badge.down { background: var(--price-down-red); }
    .diff-status-badge.up { background: var(--price-up-green); }

    /* PACKAGING GRID CHIPS */
    .pack-chips-wrap {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 12px 0 24px 0;
    }

    .pack-chip-item {
        background: var(--solid-white);
        border: 1px solid var(--border-color);
        padding: 8px 16px;
        border-radius: 12px;
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--solid-black);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .pack-chip-item:hover, .pack-chip-item.active {
        border-color: var(--solid-black);
        background: var(--solid-black);
        color: var(--solid-white);
    }

    .pack-chip-item.is-loose {
        border-style: dashed;
    }

    /* SPECS GRID / DISCLAIMER */
    .specs-grid-box {
        background: var(--solid-white);
        border: 1px solid var(--border-color);
        border-radius: 18px;
        padding: 16px;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        margin-bottom: 24px;
    }

    .spec-item {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .spec-icon-box {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: var(--bg-canvas);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--solid-black);
        flex-shrink: 0;
    }

    /* STICKY BOTTOM ACTION BAR (MOBILE FIRST) */
    .sticky-action-dock {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: var(--solid-white);
        border-top: 1px solid var(--border-color);
        padding: 12px 16px;
        z-index: 1000;
        display: flex;
        gap: 10px;
        box-shadow: 0 -10px 25px rgba(0,0,0,0.05);
    }

    .btn-dock-main {
        flex: 2;
        background: var(--solid-black);
        color: var(--solid-white) !important;
        border: none;
        border-radius: 14px;
        font-weight: 800;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none !important;
        height: 50px;
    }

    .btn-dock-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        border: 1px solid var(--border-color);
        background: var(--bg-canvas);
        color: var(--solid-black) !important;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none !important;
        flex: 0 0 50px;
    }

    .btn-dock-whatsapp {
        background: rgba(37, 211, 102, 0.1);
        border: 1px solid var(--whatsapp-color);
        color: var(--whatsapp-color) !important;
    }

    /* RESPONSIVE LAYOUT ADJUSTMENTS */
    @@media (min-width: 992px) {
        .sticky-action-dock {
            position: static;
            box-shadow: none;
            padding: 0;
            border: none;
            background: transparent;
            margin-top: 20px;
        }
        body { padding-bottom: 20px; }
        .product-main-title { font-size: 2.5rem; }
    }

    @@media (max-width: 576px) {
        .specs-grid-box { grid-template-columns: 1fr; }
        .product-hero-card { min-height: 300px; }
    }
</style>

<div class="container my-2 my-md-4">

    <!-- Top App Navigation Bar -->
    <div class="app-top-nav">
        <a href="javascript:history.back()" class="app-action-circle" title="Back">
            <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <div class="path-capsule-badge">
            @Model.SubCategory?.Category?.Name &bull; @Model.SubCategory?.Name
        </div>
        <button class="app-action-circle" onclick="shareProduct()" title="Share">
            <span class="material-symbols-outlined" style="font-size: 18px;">share</span>
        </button>
    </div>

    <div class="row g-4 align-items-start">

        <!-- Left Column: Hero Image Card -->
        <div class="col-lg-6">
            <div class="product-hero-card">
                <span class="hd-zoom-tag">
                    <span class="material-symbols-outlined" style="font-size: 14px;">center_focus_strong</span>
                    100% ORIGINAL
                </span>

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" id="productHeroImage" loading="lazy" />
                }
                else
                {
                    <div class="text-center py-5">
                        <span class="material-symbols-outlined text-muted" style="font-size: 5rem;">inventory_2</span>
                        <p class="text-muted fw-bold mt-2">No Image Preview</p>
                    </div>
                }
            </div>
        </div>

        <!-- Right Column: Specs Terminal & Ticker -->
        <div class="col-lg-6">

            <!-- Title & Grade -->
            <h1 class="product-main-title lang-en">@Model.Name</h1>
            @if (!string.IsNullOrEmpty(Model.NameTamil))
            {
                <h1 class="product-main-title-ta lang-ta">@Model.NameTamil</h1>
            }

            @if (!string.IsNullOrEmpty(Model.Grade))
            {
                <span class="grade-badge-chip">Grade: @Model.Grade</span>
            }

            <!-- Live Financial Trading Ticker Engine -->
            @if (mp != null)
            {
                var isDrop = mp.PriceDifference < 0;
                var isUp = mp.PriceDifference > 0;
                var tickerClass = isDrop ? "is-drop" : isUp ? "is-up" : "";

                <div class="ticker-exchange-card @tickerClass">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="text-uppercase fw-bold text-muted" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                            <span class="live-pulse-dot"></span>
                            Live Market Rate
                        </span>
                        <span class="text-muted fw-semibold" style="font-size: 0.72rem;">
                            @mp.UpdatedAt.ToString("dd MMM, hh:mm tt")
                        </span>
                    </div>

                    <div class="d-flex align-items-baseline justify-content-between">
                        <div>
                            <span class="price-big-num">₹@mp.TodayPrice.ToString("F2")</span>
                            <span class="fw-bold text-muted" style="font-size: 0.9rem;">/ KG</span>
                        </div>

                        @if (isDrop)
                        {
                            <!-- Red Drop Badge -->
                            <span class="diff-status-badge down">
                                <span class="material-symbols-outlined" style="font-size: 16px;">trending_down</span>
                                PRICE DROP ₹@Math.Abs(mp.PriceDifference).ToString("F2")
                            </span>
                        }
                        else if (isUp)
                        {
                            <!-- Green Increase Badge -->
                            <span class="diff-status-badge up">
                                <span class="material-symbols-outlined" style="font-size: 16px;">trending_up</span>
                                ▲ ₹@Math.Abs(mp.PriceDifference).ToString("F2")
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary" style="font-size: 0.75rem;">STABLE</span>
                        }
                    </div>

                    <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center" style="font-size: 0.72rem; color: var(--text-muted);">
                        <span>GST Included • Net Rate</span>
                        <span class="fw-bold text-dark">Verified Direct Quote</span>
                    </div>
                </div>
            }
            else
            {
                <div class="ticker-exchange-card text-center py-3">
                    <span class="material-symbols-outlined text-muted" style="font-size: 2rem;">request_quote</span>
                    <h6 class="fw-bold text-dark mt-1 mb-0">Custom Bulk Price On Request</h6>
                    <small class="text-muted">Contact directly for large commercial orders</small>
                </div>
            }

            <!-- Product Description -->
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="mb-4">
                    <h6 class="fw-bold text-dark mb-1" style="font-size: 0.85rem;">Overview</h6>
                    <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin: 0;">
                        @Model.Description
                    </p>
                </div>
            }

            <!-- Available Packings -->
            @if (Model.PackingTypes != null && Model.PackingTypes.Any(x => x.IsActive))
            {
                <div>
                    <h6 class="fw-bold text-dark mb-2" style="font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        <span class="lang-en">Available Packings</span>
                        <span class="lang-ta">கிடைக்கும் பேக்கிங் அளவுகள்</span>
                    </h6>
                    <div class="pack-chips-wrap">
                        @foreach (var pt in Model.PackingTypes.Where(x => x.IsActive))
                        {
                            var looseClass = pt.IsLoose ? "is-loose" : "";
                            <div class="pack-chip-item @looseClass" onclick="selectPack(this)">
                                @pt.PackSize
                                @if (pt.IsLoose)
                                {
                                    <small class="lang-en">(Loose)</small>
                                    <small class="lang-ta">(உதிரி)</small>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Regulatory Specs Grid -->
            <div class="specs-grid-box">
                <div class="spec-item">
                    <div class="spec-icon-box">
                        <span class="material-symbols-outlined">verified</span>
                    </div>
                    <div>
                        <strong class="d-block text-dark" style="font-size: 0.78rem;">Grade Assured</strong>
                        <small class="text-muted" style="font-size: 0.7rem;">Quality Tested</small>
                    </div>
                </div>
                <div class="spec-item">
                    <div class="spec-icon-box">
                        <span class="material-symbols-outlined">receipt_long</span>
                    </div>
                    <div>
                        <strong class="d-block text-dark" style="font-size: 0.78rem;">Tax Invoice</strong>
                        <small class="text-muted" style="font-size: 0.7rem;">GST Compliant</small>
                    </div>
                </div>
                <div class="spec-item">
                    <div class="spec-icon-box">
                        <span class="material-symbols-outlined">local_shipping</span>
                    </div>
                    <div>
                        <strong class="d-block text-dark" style="font-size: 0.78rem;">Ex-Warehouse</strong>
                        <small class="text-muted" style="font-size: 0.7rem;">Freight Extra</small>
                    </div>
                </div>
                <div class="spec-item">
                    <div class="spec-icon-box">
                        <span class="material-symbols-outlined">shield</span>
                    </div>
                    <div>
                        <strong class="d-block text-dark" style="font-size: 0.78rem;">Direct Trade</strong>
                        <small class="text-muted" style="font-size: 0.7rem;">Verified Seller</small>
                    </div>
                </div>
            </div>

            <!-- Sticky Action Dock / Desktop Inline Dock -->
            <div class="sticky-action-dock">
                <a asp-controller="Order" asp-action="Request" asp-route-productId="@Model.Id" class="btn-dock-main">
                    <span class="material-symbols-outlined">shopping_cart</span>
                    <span class="lang-en">Order Now</span>
                    <span class="lang-ta">ஆர்டர் செய்ய</span>
                </a>
                <a href="tel:9865680694" class="btn-dock-icon" title="Call Us">
                    <span class="material-symbols-outlined">call</span>
                </a>
                <a href="https://api.whatsapp.com/send?phone=919865680694&text=Enquiry%20regarding%20@Model.Name" class="btn-dock-icon btn-dock-whatsapp" title="WhatsApp">
                    <span class="material-symbols-outlined">chat</span>
                </a>
            </div>

        </div>
    </div>
</div>

<script>
    // Share Handler
    function shareProduct() {
        if (navigator.share) {
            navigator.share({
                title: '@Model.Name',
                text: 'Check out today market price for @Model.Name',
                url: window.location.href
            }).catch(() => {});
        } else {
            navigator.clipboard.writeText(window.location.href);
            alert('Link copied to clipboard!');
        }
    }

    // Selectable Pack Chip Interaction
    function selectPack(element) {
        document.querySelectorAll('.pack-chip-item').forEach(el => el.classList.remove('active'));
        element.classList.add('active');
    }
</script>
