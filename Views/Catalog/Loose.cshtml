@model List<BRT.Models.Product>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Retail Products";

    // Safe Null-Coalescing Cast assignment
    var todaysPrices = ViewBag.TodaysPrices as Dictionary<int, BRT.Models.MarketPrice>
                        ?? new Dictionary<int, BRT.Models.MarketPrice>();
}

<!-- Premium Corporate Fonts & Icons Core -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cinzel:wght@600;700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

<style>
    :root {
        --primary-gold: #D4AF37;
        --primary-gold-dark: #AA820A;
        --bg-dark: #0F172A;
        --bg-body: #F8FAFC;
        --card-bg: #FFFFFF;
        --text-dark: #0F172A;
        --text-muted: #64748B;
        --up-green: #10B981;
        --up-bg: rgba(16, 185, 129, 0.1);
        --down-red: #EF4444;
        --down-bg: rgba(239, 68, 68, 0.1);
        --border-color: #E2E8F0;
        --app-shadow: 0 12px 28px rgba(15, 23, 42, 0.06);
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--bg-body);
        color: var(--text-dark);
        padding-bottom: 90px;
    }

    /* DYNAMIC LANGUAGE CONTROLLER */
    html[lang="en"] .lang-ta-text, body[lang="en"] .lang-ta-text { display: none !important; }
    html[lang="ta"] .lang-en-text, body[lang="ta"] .lang-en-text { display: none !important; }

    /* NATIVE HERO HEADER */
    .app-hero-header {
        background: radial-gradient(100% 100% at 50% 100%, rgba(212, 175, 55, 0.08) 0%, transparent 100%), #0F172A;
        color: #FFFFFF;
        padding: 40px 20px 55px 20px;
        border-radius: 0 0 28px 28px;
        border-bottom: 2px solid var(--primary-gold);
    }

    .app-hero-header .brand-title {
        font-family: 'Cinzel', serif;
        font-size: 2.2rem;
        font-weight: 900;
        color: #FFFFFF;
        margin: 0;
        letter-spacing: -0.5px;
    }

    /* STICKY CONTROL DOCK */
    .app-control-dock {
        margin-top: -30px;
        z-index: 100;
        position: sticky;
        top: 10px;
    }

    .dock-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 20px;
        padding: 10px 14px;
        box-shadow: var(--app-shadow);
    }

    .search-input-group {
        position: relative;
        flex: 1;
    }

    .search-input-group input {
        border: none;
        background: #F1F5F9;
        border-radius: 12px;
        padding: 10px 14px 10px 42px;
        font-size: 0.9rem;
        width: 100%;
        outline: none;
        transition: all 0.3s;
    }

    .search-input-group input:focus {
        background: #FFFFFF;
        box-shadow: 0 0 0 2px #000000;
    }

    .search-input-group .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
    }

    /* PRODUCT CARD STRUCTURE */
    .product-app-card {
        background: var(--card-bg);
        border-radius: 20px;
        border: 1px solid var(--border-color);
        padding: 16px;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
    }

    .product-app-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 28px rgba(0,0,0,0.08);
        border-color: #000000;
    }

    .card-media-wrapper {
        width: 100%;
        height: 180px;
        border-radius: 14px;
        overflow: hidden;
        background: #F8FAFC;
        position: relative;
    }

    .card-media-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .product-app-card:hover .card-media-wrapper img {
        transform: scale(1.06);
    }

    .hot-deal-tag {
        position: absolute;
        top: 8px;
        left: 8px;
        background: var(--down-red);
        color: #FFFFFF;
        font-size: 0.65rem;
        font-weight: 800;
        padding: 2px 6px;
        border-radius: 6px;
        text-transform: uppercase;
        box-shadow: 0 2px 6px rgba(239, 68, 68, 0.4);
    }

    .share-quick-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        background: rgba(255, 255, 255, 0.9);
        border: none;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: var(--text-dark);
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }

    .fallback-media-icon {
        font-size: 3.5rem;
        color: #CBD5E1;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
    }

    .product-title {
        font-size: 1.05rem;
        font-weight: 800;
        color: var(--text-dark);
        margin: 12px 0 4px 0;
        line-height: 1.3;
    }

    .grade-chip {
        display: inline-block;
        background: rgba(212, 175, 55, 0.15);
        color: var(--primary-gold-dark);
        font-size: 0.68rem;
        font-weight: 800;
        padding: 2px 8px;
        border-radius: 6px;
        text-transform: uppercase;
    }

    .price-ticker-box {
        background: #F8FAFC;
        border-radius: 12px;
        padding: 10px 12px;
        margin: 12px 0;
        border: 1px solid var(--border-color);
    }

    .price-value {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--text-dark);
    }

    .price-unit {
        font-size: 0.75rem;
        color: var(--text-muted);
        font-weight: 600;
    }

    .price-badge {
        display: inline-flex;
        align-items: center;
        gap: 2px;
        font-size: 0.72rem;
        font-weight: 800;
        padding: 3px 6px;
        border-radius: 6px;
    }

    .price-badge.up { background: var(--up-bg); color: var(--up-green); }
    .price-badge.down { background: var(--down-bg); color: var(--down-red); }
    .price-badge.stable { background: #E2E8F0; color: var(--text-muted); }

    /* PACKAGING CHIPS */
    .pack-chips-vault {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 12px;
    }

    .pack-mini-chip {
        background: #FFFFFF;
        border: 1px solid var(--border-color);
        color: #475569;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 6px;
    }

    /* ACTION BUTTONS */
    .action-btn-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .btn-app {
        border: none;
        padding: 10px 12px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        text-decoration: none !important;
        transition: all 0.2s ease;
    }

    .btn-app-outline { background: #F1F5F9; color: var(--text-dark); }
    .btn-app-outline:hover { background: #E2E8F0; }

    .btn-app-primary { background: #000000; color: #FFFFFF !important; }
    .btn-app-primary:hover { background: var(--primary-gold-dark); }

    /* MOBILE NAVIGATION */
    .mobile-bottom-nav {
        display: none;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: #FFFFFF;
        border-top: 1px solid var(--border-color);
        padding: 8px 16px;
        box-shadow: 0 -5px 20px rgba(0,0,0,0.05);
        z-index: 1000;
    }

    .mobile-nav-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        color: var(--text-muted);
        text-decoration: none !important;
        font-size: 0.7rem;
        font-weight: 600;
    }

    .mobile-nav-item.active { color: #000000; }

    @@media (max-width: 767.98px) {
        .mobile-bottom-nav { display: flex; justify-content: space-around; }
        .app-hero-header { padding: 30px 16px 45px 16px; }
    }
</style>

<!-- Hero Section Header -->
<header class="app-hero-header text-center">
    <div class="container">
        <h1 class="brand-title lang-en-text">Retail Packs</h1>
        <h1 class="brand-title lang-ta-text">சில்லறை விற்பனை</h1>
        <p class="mb-0 text-muted small fw-semibold lang-en-text">Small retail packs — 50g / 100g / 250g / 500g / 1Kg</p>
        <p class="mb-0 text-muted small fw-semibold lang-ta-text">சிறிய சில்லறைப் பொட்டலங்கள் — 50கி / 100கி / 250கி / 500கி / 1கிலோ</p>
    </div>
</header>

<!-- Sticky Control Dock -->
<div class="container app-control-dock">
    <div class="dock-card">
        <!-- Search Field -->
        <div class="search-input-group">
            <span class="material-symbols-outlined search-icon">search</span>
            <input type="text" id="retailSearchInput" placeholder="Search retail products / பொருளைத் தேடுக..." onkeyup="filterRetailProducts()">
        </div>
    </div>
</div>

<!-- Main Retail Products Grid -->
<main class="container my-4">
    @if (Model != null && Model.Any())
    {
        <div class="row g-3" id="retailProductsGrid">
            @foreach (var p in Model)
            {
                var hasPrice = todaysPrices.ContainsKey(p.Id);
                var mp = hasPrice ? todaysPrices[p.Id] : null;

                <div class="col-lg-4 col-md-6 col-6 col-product" data-product-name="@p.Name @p.NameTamil">
                    <div class="product-app-card">
                        <div>
                            <!-- Media Frame -->
                            <div class="card-media-wrapper">
                                @if (!string.IsNullOrEmpty(p.ImageUrl))
                                {
                                    <img src="@p.ImageUrl" alt="@p.Name" loading="lazy" />
                                }
                                else
                                {
                                    <span class="material-symbols-outlined fallback-media-icon">inventory_2</span>
                                }

                                @if (mp != null && mp.PriceDifference < 0)
                                {
                                    <span class="hot-deal-tag">Offer</span>
                                }

                                <button class="share-quick-btn" onclick="shareProduct('@p.Name', '@(mp != null ? mp.TodayPrice.ToString("F2") : "N/A")')" title="Share">
                                    <span class="material-symbols-outlined" style="font-size: 16px;">share</span>
                                </button>
                            </div>

                            <!-- Product Titles -->
                            <h3 class="product-title lang-en-text">@p.Name</h3>
                            <h3 class="product-title lang-ta-text">@(!string.IsNullOrEmpty(p.NameTamil) ? p.NameTamil : p.Name)</h3>

                            @if (!string.IsNullOrEmpty(p.Grade))
                            {
                                <span class="grade-chip">@p.Grade</span>
                            }

                            <!-- Price Ticker Box -->
                            @if (mp != null)
                            {
                                var diff = mp.PriceDifference;
                                var diffClass = diff > 0 ? "up" : diff < 0 ? "down" : "stable";
                                var diffIcon = diff > 0 ? "north_east" : diff < 0 ? "south_east" : "remove";

                                <div class="price-ticker-box">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="price-value">₹@mp.TodayPrice.ToString("F2")</span>
                                            <span class="price-unit">/ KG</span>
                                        </div>
                                        <div class="price-badge @diffClass">
                                            <span class="material-symbols-outlined" style="font-size: 12px;">@diffIcon</span>
                                            <span>₹@Math.Abs(diff).ToString("F2")</span>
                                        </div>
                                    </div>
                                    <div class="text-muted" style="font-size: 0.68rem; margin-top: 4px;">
                                        <span class="lang-en-text">GST Inc. • @mp.UpdatedAt.ToString("dd-MMM HH:mm")</span>
                                        <span class="lang-ta-text">GST உட்பட • @mp.UpdatedAt.ToString("dd-MMM HH:mm")</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="price-ticker-box text-center py-2">
                                    <span class="text-muted small fw-bold lang-en-text">Price on Request</span>
                                    <span class="text-muted small fw-bold lang-ta-text">கேட்கப்படும் போது வழங்கப்படும்</span>
                                </div>
                            }

                            <!-- Loose / Pack Chips -->
                            @if (p.PackingTypes != null && p.PackingTypes.Any(x => x.IsActive && x.IsLoose))
                            {
                                <div class="pack-chips-vault">
                                    @foreach (var pt in p.PackingTypes.Where(x => x.IsActive && x.IsLoose))
                                    {
                                        <span class="pack-mini-chip">@pt.PackSize</span>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Action Buttons Grid -->
                        <div class="action-btn-grid mt-2">
                            <a asp-controller="Catalog" asp-action="Product" asp-route-slug="@p.Slug" class="btn-app btn-app-outline">
                                <span class="material-symbols-outlined" style="font-size: 15px;">visibility</span>
                                <span class="lang-en-text">View</span>
                                <span class="lang-ta-text">விவரம்</span>
                            </a>
                            <a asp-controller="Order" asp-action="Request" asp-route-productId="@p.Id" class="btn-app btn-app-primary">
                                <span class="material-symbols-outlined" style="font-size: 15px;">shopping_bag</span>
                                <span class="lang-en-text">Order</span>
                                <span class="lang-ta-text">ஆர்டர்</span>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <span class="material-symbols-outlined text-muted mb-2" style="font-size: 3.5rem;">remove_shopping_cart</span>
            <p class="lang-en-text text-muted fw-bold">No active retail products available at the moment.</p>
            <p class="lang-ta-text text-muted fw-bold">தற்போது சில்லறை விற்பனை தயாரிப்புகள் எதுவும் இல்லை.</p>
        </div>
    }
</main>

<!-- Mobile Bottom Navigation -->
<nav class="mobile-bottom-nav">
    <a href="#" class="mobile-nav-item active">
        <span class="material-symbols-outlined">storefront</span>
        <span>Market</span>
    </a>
    <a href="#" class="mobile-nav-item">
        <span class="material-symbols-outlined">trending_up</span>
        <span>Live Rates</span>
    </a>
    <a href="#" class="mobile-nav-item">
        <span class="material-symbols-outlined">shopping_cart</span>
        <span>Orders</span>
    </a>
    <a href="#" class="mobile-nav-item">
        <span class="material-symbols-outlined">person</span>
        <span>Account</span>
    </a>
</nav>

<script>
    function filterRetailProducts() {
        const query = document.getElementById('retailSearchInput').value.toLowerCase().trim();
        const productCols = document.querySelectorAll('.col-product');

        productCols.forEach(col => {
            const name = col.getAttribute('data-product-name').toLowerCase();
            if (name.includes(query)) {
                col.style.display = 'block';
            } else {
                col.style.display = 'none';
            }
        });
    }

    function shareProduct(name, price) {
        const shareText = `*${name}*\nToday's Retail Rate: ₹${price}/KG\nCheck details: ${window.location.href}`;
        if (navigator.share) {
            navigator.share({ title: name, text: shareText, url: window.location.href }).catch(() => {});
        } else {
            window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(shareText)}`, '_blank');
        }
    }
</script>
