@model List<BRT.Models.Product>
@{
    Layout = "_Layout";

    var todaysPrices = ViewBag.TodaysPrices as Dictionary<int, BRT.Models.MarketPrice>
                        ?? new Dictionary<int, BRT.Models.MarketPrice>();
}

<!-- Premium Corporate Fonts & Icons Core -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

<style>
    :root {
        --brt-gold-pure: #B38F43;
        --brt-gold-dark: #8C6D2D;
        --brt-gold-light: #FBF4E4;
        --brt-dark-navy: #0B0F19;
        --brt-surface-white: #FFFFFF;
        --brt-bg-cream: #FFFDF9;
        --text-main: #1F2937;
        --text-muted: #6B7280;
        --border-refined: rgba(179, 143, 67, 0.18);
        --price-bg: rgba(179, 143, 67, 0.08);
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--brt-bg-cream);
        color: var(--text-main);
    }

    /* AUTOMATIC DYNAMIC LANGUAGE CONTROLLER */
    html[lang="en"] .lang-en, body[lang="en"] .lang-en {
        display: inline-block !important;
    }

    html[lang="en"] .lang-ta, body[lang="en"] .lang-ta {
        display: none !important;
    }

    html[lang="ta"] .lang-en, body[lang="ta"] .lang-en {
        display: none !important;
    }

    html[lang="ta"] .lang-ta, body[lang="ta"] .lang-ta {
        display: inline-block !important;
    }

    /* HERO SECTION (LIGHT/CREAM CORPORATE THEME) */
    .page-hero {
        background: var(--brt-surface-white);
        border-bottom: 1px solid var(--border-refined);
        padding: 40px 20px;
        margin-bottom: 30px;
        text-align: center;
        box-shadow: 0 4px 15px rgba(11, 15, 25, 0.02);
    }

    .page-hero h1 {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        font-size: 2.2rem;
        color: var(--brt-dark-navy) !important;
        margin-bottom: 8px;
    }

    .page-hero p {
        color: var(--text-muted) !important;
        font-size: 0.95rem;
        max-width: 650px;
        margin: 0 auto;
        font-weight: 500;
        line-height: 1.5;
    }

    /* EQUAL HEIGHT RETAIL CARD STRUCTURE */
    .brt-retail-card {
        background: var(--brt-surface-white);
        border: 1px solid var(--border-refined);
        border-radius: 20px;
        padding: 20px;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 10px 25px -5px rgba(11, 15, 25, 0.03);
        transition: all 0.3s ease;
    }

    .brt-retail-card:hover {
        border-color: var(--brt-gold-pure);
        transform: translateY(-3px);
        box-shadow: 0 15px 35px -10px rgba(11, 15, 25, 0.08);
    }

    /* CARD BODY WRAPPER */
    .card-body-content {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    /* MEDIA CONTAINER ALIGNMENT */
    .product-media-frame {
        width: 100%;
        height: 200px;
        background-color: var(--brt-bg-cream);
        border: 1px solid var(--border-refined);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin-bottom: 16px;
        position: relative;
    }

    .product-media-frame img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 10px;
        transition: transform 0.3s ease;
    }

    .brt-retail-card:hover .product-media-frame img {
        transform: scale(1.04);
    }

    .detail-fallback-frame {
        font-size: 3rem;
        color: var(--brt-gold-pure);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* TYPOGRAPHY */
    .product-title-text {
        font-family: 'Playfair Display', serif;
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--brt-dark-navy);
        margin-bottom: 12px;
        letter-spacing: -0.2px;
        min-height: 2.6rem;
        display: flex;
        align-items: center;
    }

    /* PRICE INSIGHT BOX */
    .price-insight-box {
        background-color: var(--brt-gold-light);
        border: 1px dashed var(--brt-gold-pure);
        border-radius: 12px;
        padding: 12px;
        text-align: center;
        margin-bottom: 16px;
    }

    .price-insight-box .price-label {
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        color: var(--brt-gold-dark);
        letter-spacing: 0.8px;
        margin-bottom: 2px;
    }

    .price-insight-box .live-price-value {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--brt-dark-navy);
    }

    /* PACK TILES / BADGES */
    .pack-chips-wrapper {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 20px;
        min-height: 32px;
        align-items: flex-start;
    }

    .pack-chip-tile {
        background-color: var(--brt-surface-white);
        border: 1px solid var(--border-refined);
        border-radius: 6px;
        padding: 3px 10px;
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--brt-dark-navy);
    }

    /* DUAL BUTTON ACTION MATRIX */
    .card-action-matrix {
        display: flex;
        gap: 10px;
        margin-top: auto;
        width: 100%;
    }

    .btn-brt-secondary {
        flex: 1;
        background-color: var(--brt-surface-white);
        border: 1px solid var(--border-refined);
        color: var(--brt-dark-navy);
        font-weight: 700;
        font-size: 0.85rem;
        padding: 10px 12px;
        border-radius: 10px;
        text-align: center;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .btn-brt-secondary:hover {
        background-color: var(--brt-gold-light);
        border-color: var(--brt-gold-pure);
        color: var(--brt-dark-navy);
    }

    .btn-brt-primary-dark {
        flex: 1;
        background-color: var(--brt-dark-navy);
        border: 1px solid var(--brt-gold-pure);
        color: var(--brt-surface-white) !important;
        font-weight: 700;
        font-size: 0.85rem;
        padding: 10px 12px;
        border-radius: 10px;
        text-align: center;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: opacity 0.2s ease;
    }

    .btn-brt-primary-dark:hover {
        opacity: 0.9;
    }

    /* MOBILE OPTIMIZATION (Razor Safe @@media) */
    @@media (max-width: 576px) {
        .page-hero {
            padding: 25px 15px;
            margin-bottom: 20px;
        }

        .page-hero h1 {
            font-size: 1.6rem;
        }

        .product-media-frame {
            height: 160px;
        }

        .card-action-matrix {
            flex-direction: column;
            gap: 8px;
        }

        .btn-brt-secondary, .btn-brt-primary-dark {
            height: 46px;
            font-size: 0.9rem;
        }

        .product-title-text {
            min-height: auto;
            font-size: 1.15rem;
        }
    }
</style>

<!-- Retail Clean Hero Section -->
<section class="page-hero">
    <div class="container">
        <h1 class="lang-en">Retail Products</h1>
        <h1 class="lang-ta">சில்லறை விற்பனை தயாரிப்புகள்</h1>

        <p class="lang-en">Small retail packs — 50g / 100g / 250g / 500g / 1Kg. Retail pack availability depends on stock.</p>
        <p class="lang-ta">சிறிய சில்லறைப் பொட்டலங்கள் — 50கி / 100கி / 250கி / 500கி / 1கிலோ. சில்லறைப் பொட்டலங்கள் இருப்பு நிலவரத்திற்கு உட்பட்டவை.</p>
    </div>
</section>

<!-- Main Inventory Grid Layout -->
<div class="container my-4">
    <div class="row g-3 g-md-4 d-flex align-items-stretch">
        @if (Model != null && Model.Any())
        {
            @foreach (var p in Model)
            {
                var hasPrice = todaysPrices.ContainsKey(p.Id);
                var mp = hasPrice ? todaysPrices[p.Id] : null;

                <div class="col-lg-4 col-md-6 col-sm-12 d-flex">
                    <div class="brt-retail-card">
                        <div class="card-body-content">
                            <!-- Product Media Container Framework -->
                            <div class="product-media-frame">
                                @if (!string.IsNullOrEmpty(p.ImageUrl))
                                {
                                    <img src="@p.ImageUrl" alt="@p.Name" loading="lazy" />
                                }
                                else
                                {
                                    <div class="detail-fallback-frame">
                                        <span class="material-symbols-outlined">eco</span>
                                    </div>
                                }
                            </div>

                            <!-- Dynamic Identity Text Frame -->
                            <h3 class="product-title-text">
                                <span class="lang-en">@p.Name</span>
                                @if (!string.IsNullOrEmpty(p.NameTamil))
                                {
                                    <span class="lang-ta">@p.NameTamil</span>
                                }
                            </h3>

                            <!-- Price Insight Box Context -->
                            <div class="price-insight-box">
                                <div class="price-label">
                                    <span class="lang-en">Today's Retail Price</span>
                                    <span class="lang-ta">இன்றைய சில்லறை விலை</span>
                                </div>
                                <div class="live-price-value">
                                    @if (mp != null)
                                    {
                                        <span>₹@mp.TodayPrice.ToString("F2")</span>
                                    }
                                    else
                                    {
                                        <span style="font-size:1rem; color:var(--text-muted);">—</span>
                                    }
                                </div>
                            </div>

                            <!-- Dynamic Small Packing Types Tag Chips Layout -->
                            <div class="pack-chips-wrapper">
                                @if (p.PackingTypes != null)
                                {
                                    @foreach (var pt in p.PackingTypes.Where(x => x.IsActive && x.IsLoose))
                                    {
                                        <span class="pack-chip-tile">@pt.PackSize</span>
                                    }
                                }
                            </div>
                        </div>

                        <!-- Fixed Action Buttons Routing Matrix -->
                        <div class="card-action-matrix">
                            <a asp-controller="Catalog" asp-action="Product" asp-route-slug="@p.Slug" class="btn-brt-secondary">
                                <span class="lang-en">Specifications</span>
                                <span class="lang-ta">விவரங்கள்</span>
                            </a>
                            <a asp-controller="Order" asp-action="Request" asp-route-productId="@p.Id" class="btn-brt-primary-dark">
                                <span class="lang-en">Order Now</span>
                                <span class="lang-ta">ஆர்டர் செய்க</span>
                            </a>
                        </div>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center my-5">
                <p class="text-muted lang-en">No active retail products found available at the moment.</p>
                <p class="text-muted lang-ta">தற்போது சில்லறை விற்பனை தயாரிப்புகள் எதுவும் இல்லை.</p>
            </div>
        }
    </div>
</div> 
