@model List<BRT.Models.Product>
@{
    Layout = "_Layout";

    var todaysPrices = ViewBag.TodaysPrices as Dictionary<int, BRT.Models.MarketPrice>
                        ?? new Dictionary<int, BRT.Models.MarketPrice>();
}

<!-- Google Fonts & Material Symbols -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

<style>
    :root {
        --brt-gold-pure: #B38F43;
        --brt-gold-dark: #8C6D2D;
        --brt-gold-light: #FDF9F0;
        --brt-dark-navy: #0B0F19;
        --brt-surface-white: #FFFFFF;
        --brt-bg-main: #F8F9FA;
        --text-main: #1F2937;
        --text-muted: #6B7280;
        --border-light: rgba(0, 0, 0, 0.08);
        --card-shadow: 0 4px 12px rgba(0, 0, 0, 0.04);
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--brt-bg-main);
        color: var(--text-main);
    }

    /* LANGUAGE CONTROLLER */
    html[lang="en"] .lang-en, body[lang="en"] .lang-en { display: inline-block !important; }
    html[lang="en"] .lang-ta, body[lang="en"] .lang-ta { display: none !important; }
    html[lang="ta"] .lang-en, body[lang="ta"] .lang-en { display: none !important; }
    html[lang="ta"] .lang-ta, body[lang="ta"] .lang-ta { display: inline-block !important; }

    /* COMPACT APP-LIKE HERO BANNER */
    .app-hero-banner {
        background: var(--brt-surface-white);
        padding: 20px 16px;
        border-bottom: 1px solid var(--border-light);
        margin-bottom: 16px;
    }

    .app-hero-banner h1 {
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--brt-dark-navy);
        margin: 0 0 4px 0;
    }

    .app-hero-banner p {
        font-size: 0.825rem;
        color: var(--text-muted);
        margin: 0;
        line-height: 1.4;
    }

    /* APP-LIKE GRID CONTAINER */
    .app-product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 16px;
        padding: 0 12px 30px 12px;
    }

    /* PRODUCT CARD APP VIEW */
    .app-card {
        background: var(--brt-surface-white);
        border: 1px solid var(--border-light);
        border-radius: 16px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: var(--card-shadow);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .app-card:active {
        transform: scale(0.98);
    }

    .app-card-body {
        padding: 12px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    /* SQUARE IMAGE CONTAINER */
    .app-media-frame {
        width: 100%;
        aspect-ratio: 1 / 1;
        background-color: var(--brt-bg-main);
        border-radius: 12px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 10px;
        position: relative;
    }

    .app-media-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .app-media-fallback {
        font-size: 2.5rem;
        color: var(--brt-gold-pure);
    }

    /* TITLE */
    .app-product-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--brt-dark-navy);
        margin: 0 0 8px 0;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.6rem;
    }

    /* APP PRICE BADGE */
    .app-price-box {
        background-color: var(--brt-gold-light);
        border-radius: 8px;
        padding: 6px 10px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
    }

    .app-price-label {
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--brt-gold-dark);
        text-transform: uppercase;
    }

    .app-price-value {
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--brt-dark-navy);
    }

    /* PACK CHIPS */
    .app-chips-container {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-bottom: 12px;
        min-height: 24px;
    }

    .app-chip {
        background: var(--brt-bg-main);
        border: 1px solid var(--border-light);
        border-radius: 6px;
        padding: 2px 6px;
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--text-main);
    }

    /* MOBILE ACTION BUTTONS */
    .app-card-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        padding: 0 12px 12px 12px;
    }

    .app-btn-sec {
        background: var(--brt-bg-main);
        color: var(--brt-dark-navy);
        border: 1px solid var(--border-light);
        border-radius: 10px;
        padding: 10px 0;
        font-size: 0.8rem;
        font-weight: 700;
        text-align: center;
        text-decoration: none !important;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .app-btn-pri {
        background: var(--brt-dark-navy);
        color: var(--brt-surface-white) !important;
        border: none;
        border-radius: 10px;
        padding: 10px 0;
        font-size: 0.8rem;
        font-weight: 700;
        text-align: center;
        text-decoration: none !important;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 6px rgba(11, 15, 25, 0.2);
    }

    /* MOBILE SPECIFIC GRID (2 COLUMNS FOR MOBILE APP FEEL) */
    @@media (max-width: 576px) {
        .app-product-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            padding: 0 8px 20px 8px;
        }

        .app-card-body {
            padding: 8px;
        }

        .app-card-actions {
            grid-template-columns: 1fr;
            gap: 6px;
            padding: 0 8px 8px 8px;
        }

        .app-product-title {
            font-size: 0.875rem;
            min-height: 2.3rem;
        }

        .app-price-value {
            font-size: 0.95rem;
        }

        .app-btn-sec, .app-btn-pri {
            padding: 8px 0;
            font-size: 0.75rem;
            border-radius: 8px;
        }
    }
</style>

<!-- Compact Header -->
<div class="app-hero-banner">
    <div class="container p-0">
        <h1 class="lang-en">Retail Products</h1>
        <h1 class="lang-ta">சில்லறை விற்பனை</h1>
        <p class="lang-en">Small packs (50g - 1Kg) for everyday use.</p>
        <p class="lang-ta">தினசரி பயன்பாட்டிற்கான சிறிய பொட்டலங்கள்.</p>
    </div>
</div>

<!-- Product Grid Layout -->
<div class="container p-0">
    @if (Model != null && Model.Any())
    {
        <div class="app-product-grid">
            @foreach (var p in Model)
            {
                var hasPrice = todaysPrices.ContainsKey(p.Id);
                var mp = hasPrice ? todaysPrices[p.Id] : null;

                <div class="app-card">
                    <div class="app-card-body">
                        <!-- Square Aspect-Ratio Image -->
                        <div class="app-media-frame">
                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                            {
                                <img src="@p.ImageUrl" alt="@p.Name" loading="lazy" />
                            }
                            else
                            {
                                <span class="material-symbols-outlined app-media-fallback">inventory_2</span>
                            }
                        </div>

                        <!-- Product Title -->
                        <h2 class="app-product-title">
                            <span class="lang-en">@p.Name</span>
                            @if (!string.IsNullOrEmpty(p.NameTamil))
                            {
                                <span class="lang-ta">@p.NameTamil</span>
                            }
                        </h2>

                        <!-- Price Tag -->
                        <div class="app-price-box">
                            <span class="app-price-label lang-en">Price</span>
                            <span class="app-price-label lang-ta">விலை</span>
                            <span class="app-price-value">
                                @if (mp != null)
                                {
                                    <span>₹@mp.TodayPrice.ToString("N0")</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </span>
                        </div>

                        <!-- Available Pack Sizes -->
                        <div class="app-chips-container">
                            @if (p.PackingTypes != null)
                            {
                                @foreach (var pt in p.PackingTypes.Where(x => x.IsActive && x.IsLoose).Take(3))
                                {
                                    <span class="app-chip">@pt.PackSize</span>
                                }
                            }
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="app-card-actions">
                        <a asp-controller="Catalog" asp-action="Product" asp-route-slug="@p.Slug" class="app-btn-sec">
                            <span class="lang-en">Details</span>
                            <span class="lang-ta">விவரம்</span>
                        </a>
                        <a asp-controller="Order" asp-action="Request" asp-route-productId="@p.Id" class="app-btn-pri">
                            <span class="lang-en">Order</span>
                            <span class="lang-ta">ஆர்டர்</span>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center my-5 py-4">
            <span class="material-symbols-outlined text-muted" style="font-size: 3rem;">remove_shopping_cart</span>
            <p class="text-muted mt-2 lang-en">No retail products available.</p>
            <p class="text-muted mt-2 lang-ta">தயாரிப்புகள் எதுவும் கிடைக்கவில்லை.</p>
        </div>
    }
</div>
