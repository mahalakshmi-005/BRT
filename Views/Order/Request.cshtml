@model BRT.ViewModels.OrderRequestViewModel
@{
    ViewData["Title"] = "Request to Order";
    var products = (List<Product>)ViewBag.Products;
    var summaryDisplay = ViewData.ModelState.IsValid ? "none" : "block";
}

<!-- Premium Corporate Fonts & Google Icons Core -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

<style>
    :root {
        --brt-gold-pure: #B38F43;
        --brt-gold-dark: #8C6D2D;
        --brt-gold-light: #FBF4E4;
        --brt-dark-navy: #0B0F19;
        --brt-surface-white: #FFFFFF;
        --brt-bg-cream: #FFFDF9;
        --text-main: #1F2937;
        --text-muted: #6B7280;
        --border-refined: rgba(179, 143, 67, 0.22);
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--brt-bg-cream);
        color: var(--text-main);
    }

    /* Dynamic Language Controller */
    html[lang="en"] .lang-ta-text, body[lang="en"] .lang-ta-text { display: none !important; }
    html[lang="ta"] .lang-en-text, body[lang="ta"] .lang-en-text { display: none !important; }

    /* APP TOP HEADER & STEPPER */
    .app-header-shell {
        text-align: center;
        padding: 30px 0 20px 0;
    }

    .app-b2b-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 16px;
        background: var(--brt-gold-light);
        border: 1px solid var(--border-refined);
        color: var(--brt-gold-dark);
        border-radius: 100px;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    .app-page-title {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        font-size: 2.2rem;
        color: var(--brt-dark-navy);
        margin-bottom: 6px;
    }

    .app-page-subtitle {
        color: var(--text-muted);
        font-size: 0.92rem;
        max-width: 580px;
        margin: 0 auto 20px auto;
        line-height: 1.5;
    }

    /* STEP TRACKER BAR */
    .app-step-tracker {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-bottom: 24px;
    }

    .step-node {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--text-muted);
    }

    .step-node.active {
        color: var(--brt-dark-navy);
    }

    .step-node .number {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #E5E7EB;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
    }

    .step-node.active .number {
        background: var(--brt-dark-navy);
        color: #FFF;
    }

    .step-divider {
        width: 30px;
        height: 2px;
        background: #E5E7EB;
    }

    /* FORM MAIN CARD */
    .app-form-card {
        background: var(--brt-surface-white);
        border: 1px solid var(--border-refined);
        border-radius: 24px;
        padding: 32px;
        box-shadow: 0 10px 30px -10px rgba(11, 15, 25, 0.05);
    }

    .section-headline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--brt-dark-navy);
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    }

    .section-headline-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .section-headline .material-symbols-outlined {
        color: var(--brt-gold-pure);
    }

    .item-count-badge {
        font-size: 0.75rem;
        font-weight: 700;
        background: var(--brt-gold-light);
        color: var(--brt-gold-dark);
        padding: 4px 12px;
        border-radius: 20px;
        border: 1px solid var(--border-refined);
    }

    /* FLOATING FORM INPUTS */
    .form-group-app {
        margin-bottom: 16px;
    }

    .form-group-app .form-label {
        font-size: 0.78rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-main);
        margin-bottom: 6px;
        display: block;
    }

    .form-control-app {
        width: 100%;
        background: #FAFAFA;
        border: 1px solid #E5E7EB;
        border-radius: 12px;
        padding: 12px 16px;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--brt-dark-navy);
        transition: all 0.25s ease;
    }

    .form-control-app:focus {
        background: #FFFFFF;
        border-color: var(--brt-dark-navy);
        box-shadow: 0 0 0 4px rgba(11, 15, 25, 0.06);
        outline: none;
    }

    /* PRODUCT BUILDER MANIFEST */
    .app-manifest-box {
        background: #F9FAFB;
        border: 1px solid #E5E7EB;
        border-radius: 16px;
        padding: 16px;
        margin-bottom: 12px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        animation: fadeIn 0.3s ease-in-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .app-manifest-box:focus-within, .app-manifest-box:hover {
        background: #FFFFFF;
        border-color: var(--brt-gold-pure);
        box-shadow: 0 4px 14px rgba(179, 143, 67, 0.12);
    }

    .unit-tag {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--brt-gold-dark);
        background: var(--brt-gold-light);
        padding: 6px 10px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        height: 100%;
    }

    /* ADD & REMOVE BUTTONS */
    .btn-add-product {
        width: 100%;
        background: #F3F4F6;
        border: 2px dashed #D1D5DB;
        color: var(--brt-dark-navy);
        font-weight: 700;
        font-size: 0.9rem;
        padding: 14px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-bottom: 24px;
    }

    .btn-add-product:hover {
        background: var(--brt-gold-light);
        border-color: var(--brt-gold-pure);
        color: var(--brt-gold-dark);
    }

    .btn-remove-row {
        background: #FEE2E2;
        color: #DC2626;
        border: none;
        border-radius: 10px;
        width: 40px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-remove-row:hover {
        background: #DC2626;
        color: #FFFFFF;
    }

    /* SUBMIT BUTTON */
    .btn-app-submit {
        background: var(--brt-dark-navy);
        color: #FFFFFF !important;
        font-weight: 800;
        font-size: 1rem;
        letter-spacing: 0.5px;
        padding: 16px;
        border-radius: 14px;
        border: none;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        box-shadow: 0 8px 20px rgba(11, 15, 25, 0.15);
        transition: all 0.25s ease;
        cursor: pointer;
    }

    .btn-app-submit:hover {
        background: #1F2937;
        transform: translateY(-2px);
        box-shadow: 0 12px 24px rgba(11, 15, 25, 0.2);
    }

    /* TRUST STRIP */
    .app-trust-strip {
        background: var(--brt-dark-navy);
        border-radius: 18px;
        padding: 18px 24px;
        display: flex;
        justify-content: space-around;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-top: 30px;
    }

    .trust-item {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #E5E7EB;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .trust-item .material-symbols-outlined {
        color: var(--brt-gold-pure);
        font-size: 1.2rem;
    }

    @@media (max-width: 576px) {
        .app-form-card { padding: 20px 16px; border-radius: 18px; }
        .app-page-title { font-size: 1.75rem; }
        .app-trust-strip { flex-direction: column; align-items: flex-start; gap: 12px; }
    }
</style>

<!-- ===================================================
     1. HERO & STEPPER HEADER
     =================================================== -->
<section class="app-header-shell">
    <div class="container">
        <div class="app-b2b-pill">
            <span class="material-symbols-outlined" style="font-size: 16px;">verified</span>
            <span class="lang-en-text">B2B Wholesale Portal</span>
            <span class="lang-ta-text">B2B மொத்த விற்பனை தளம்</span>
        </div>
        
        <!-- NEW TITLE HERE -->
        <h1 class="app-page-title">
            <span class="lang-en-text">Request to Order</span>
            <span class="lang-ta-text">ஆர்டர் கோரிக்கை</span>
        </h1>
        
        <p class="app-page-subtitle">
            <span class="lang-en-text">Select your products, add quantities, and send your requirements directly to our allocation team.</span>
            <span class="lang-ta-text">உங்களுக்குத் தேவையான பொருட்களைத் தேர்ந்தெடுத்து அளவுகளை உள்ளிட்டு நேரடியாக ஆர்டர் கோரிக்கையை அனுப்பவும்.</span>
        </p>

        <!-- Stepper Indicator -->
        <div class="app-step-tracker">
            <div class="step-node active">
                <span class="number">1</span>
                <span class="lang-en-text">Business Info</span>
                <span class="lang-ta-text">வணிக விவரம்</span>
            </div>
            <div class="step-divider"></div>
            <div class="step-node active">
                <span class="number">2</span>
                <span class="lang-en-text">Product List</span>
                <span class="lang-ta-text">பொருட்கள் பட்டியல்</span>
            </div>
        </div>
    </div>
</section>

<!-- ===================================================
     2. FORM CONTROLLER SECTION
     =================================================== -->
<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="app-form-card">
                
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" style="display:@summaryDisplay; font-size:0.88rem;"></div>

                <form asp-action="Request" method="post">
                    @Html.AntiForgeryToken()
                    
                    <!-- SECTION 1: BUSINESS & BUYER DETAILS -->
                    <div class="section-headline">
                        <div class="section-headline-title">
                            <span class="material-symbols-outlined">badge</span>
                            <span class="lang-en-text">Business & Buyer Details</span>
                            <span class="lang-ta-text">வணிகம் மற்றும் வாடிக்கையாளர் விவரங்கள்</span>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 form-group-app">
                            <label class="form-label">
                                <span class="lang-en-text">Your Name</span>
                                <span class="lang-ta-text">உங்கள் பெயர்</span>
                            </label>
                            <input asp-for="BuyerName" class="form-control-app" placeholder="e.g. Rahul Sharma" required />
                        </div>

                        <div class="col-md-6 form-group-app">
                            <label class="form-label">
                                <span class="lang-en-text">Business Name</span>
                                <span class="lang-ta-text">வணிக பெயர்</span>
                            </label>
                            <input asp-for="BusinessName" class="form-control-app" placeholder="e.g. BRT Traders" required />
                        </div>

                        <div class="col-md-6 form-group-app">
                            <label class="form-label">
                                <span class="lang-en-text">Phone Number</span>
                                <span class="lang-ta-text">தொலைபேசி எண்</span>
                            </label>
                            <input asp-for="PhoneNumber" type="tel" class="form-control-app" placeholder="10-digit mobile number" required />
                        </div>

                        <div class="col-md-6 form-group-app">
                            <label class="form-label">
                                <span class="lang-en-text">City / Town</span>
                                <span class="lang-ta-text">நகரம்</span>
                            </label>
                            <input asp-for="City" class="form-control-app" placeholder="e.g. Madurai, Chennai" />
                        </div>

                        <div class="col-12 form-group-app">
                            <label class="form-label">
                                <span class="lang-en-text">Delivery Address</span>
                                <span class="lang-ta-text">டெலிவரி முகவரி</span>
                            </label>
                            <input asp-for="BuyerAddress" class="form-control-app" placeholder="Complete destination address for transport" />
                        </div>
                    </div>

                    <!-- SECTION 2: REQUIRED PRODUCTS LIST (DYNAMIC ENGINE) -->
                    <div class="section-headline mt-4">
                        <div class="section-headline-title">
                            <span class="material-symbols-outlined">inventory_2</span>
                            <span class="lang-en-text">Select Required Products</span>
                            <span class="lang-ta-text">தேவையான பொருட்கள்</span>
                        </div>
                        <span class="item-count-badge" id="productCountBadge">1 Item Added</span>
                    </div>

                    <!-- DYNAMIC PRODUCT CONTAINER -->
                    <div id="productRowsContainer">
                        <!-- Default First Row -->
                        <div class="app-manifest-box product-row" data-index="0">
                            <div class="row g-2 align-items-center">
                                <!-- Product Selection Dropdown -->
                                <div class="col-md-5 col-12">
                                    <select name="Items[0].ProductId" class="form-select form-control-app product-select" required>
                                        <option value="">-- Choose Product --</option>
                                        @foreach (var p in products)
                                        {
                                            <option value="@p.Id">@p.Name</option>
                                        }
                                    </select>
                                </div>

                                <!-- Quantity Input -->
                                <div class="col-md-3 col-6">
                                    <input name="Items[0].Quantity" type="number" step="0.01" min="0.1" class="form-control-app" placeholder="Qty" required />
                                </div>

                                <!-- Unit Tag -->
                                <div class="col-md-3 col-4">
                                    <div class="unit-tag">
                                        <span class="material-symbols-outlined" style="font-size:14px;">info</span>
                                        <span class="lang-en-text">Bags / KGs</span>
                                        <span class="lang-ta-text">பைகள் / KG</span>
                                    </div>
                                </div>

                                <!-- Action (Delete Button Hidden for first row) -->
                                <div class="col-md-1 col-2 text-end">
                                    <button type="button" class="btn-remove-row d-none" onclick="removeProductRow(this)" title="Remove Item">
                                        <span class="material-symbols-outlined" style="font-size: 18px;">delete</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- INNOVATIVE "ADD PRODUCT" BUTTON -->
                    <button type="button" class="btn-add-product" onclick="addProductRow()">
                        <span class="material-symbols-outlined">add_circle</span>
                        <span class="lang-en-text">Add Another Product</span>
                        <span class="lang-ta-text">மற்றொரு பொருளைச் சேர்க்க</span>
                    </button>

                    <!-- SUBMIT BUTTON -->
                    <button type="submit" class="btn-app-submit">
                        <span class="material-symbols-outlined">send</span>
                        <span class="lang-en-text">Submit Request to Order</span>
                        <span class="lang-ta-text">ஆர்டர் கோரிக்கையை சமர்ப்பிக்க</span>
                    </button>
                </form>

            </div>

            <!-- 3. COMPLIANCE TRUST STRIP -->
            <div class="app-trust-strip">
                <div class="trust-item">
                    <span class="material-symbols-outlined">payments</span>
                    <span class="lang-en-text">Best Wholesale Rates</span>
                    <span class="lang-ta-text">சிறந்த மொத்த விலை</span>
                </div>
                <div class="trust-item">
                    <span class="material-symbols-outlined">high_quality</span>
                    <span class="lang-en-text">Graded Quality</span>
                    <span class="lang-ta-text">உயர்தர சோதனை</span>
                </div>
                <div class="trust-item">
                    <span class="material-symbols-outlined">local_shipping</span>
                    <span class="lang-en-text">Direct Transport</span>
                    <span class="lang-ta-text">நேரடி லாஜிஸ்டிக்ஸ்</span>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ===================================================
     DYNAMIC JAVASCRIPT ENGINE FOR ADD/REMOVE ROWS
     =================================================== -->
<script>
    // Hidden Options Template for JS Dynamic Inject
    const productOptionsHtml = `@foreach (var p in products) { <option value="@p.Id">@p.Name</option> }`;

    function updateBadgeCount() {
        const rows = document.querySelectorAll('.product-row');
        const badge = document.getElementById('productCountBadge');
        if (badge) {
            badge.textContent = `${rows.length} ${rows.length === 1 ? 'Item Added' : 'Items Added'}`;
        }
    }

    function addProductRow() {
        const container = document.getElementById('productRowsContainer');
        const currentRows = container.querySelectorAll('.product-row');
        const newIndex = currentRows.length;

        const newRow = document.createElement('div');
        newRow.className = 'app-manifest-box product-row';
        newRow.setAttribute('data-index', newIndex);

        newRow.innerHTML = `
            <div class="row g-2 align-items-center">
                <div class="col-md-5 col-12">
                    <select name="Items[${newIndex}].ProductId" class="form-select form-control-app product-select" required>
                        <option value="">-- Choose Product --</option>
                        ${productOptionsHtml}
                    </select>
                </div>
                <div class="col-md-3 col-6">
                    <input name="Items[${newIndex}].Quantity" type="number" step="0.01" min="0.1" class="form-control-app" placeholder="Qty" required />
                </div>
                <div class="col-md-3 col-4">
                    <div class="unit-tag">
                        <span class="material-symbols-outlined" style="font-size:14px;">info</span>
                        <span class="lang-en-text">Bags / KGs</span>
                        <span class="lang-ta-text">பைகள் / KG</span>
                    </div>
                </div>
                <div class="col-md-1 col-2 text-end">
                    <button type="button" class="btn-remove-row" onclick="removeProductRow(this)" title="Remove Item">
                        <span class="material-symbols-outlined" style="font-size: 18px;">delete</span>
                    </button>
                </div>
            </div>
        `;

        container.appendChild(newRow);
        updateBadgeCount();
        
        // Show delete button on first row if items count > 1
        if (container.querySelectorAll('.product-row').length > 1) {
            const firstRowDeleteBtn = container.querySelector('.product-row .btn-remove-row');
            if (firstRowDeleteBtn) firstRowDeleteBtn.classList.remove('d-none');
        }
    }

    function removeProductRow(btn) {
        const row = btn.closest('.product-row');
        row.remove();
        reindexRows();
        updateBadgeCount();
    }

    function reindexRows() {
        const container = document.getElementById('productRowsContainer');
        const rows = container.querySelectorAll('.product-row');

        rows.forEach((row, index) => {
            row.setAttribute('data-index', index);
            const select = row.querySelector('select');
            const input = row.querySelector('input[type="number"]');

            if (select) select.name = `Items[${index}].ProductId`;
            if (input) input.name = `Items[${index}].Quantity`;
        });

        // Hide delete button if only 1 row remains
        if (rows.length === 1) {
            const firstRowDeleteBtn = rows[0].querySelector('.btn-remove-row');
            if (firstRowDeleteBtn) firstRowDeleteBtn.classList.add('d-none');
        }
    }
</script>
