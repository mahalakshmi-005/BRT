<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>@ViewData["Title"] - B Raj Traders</title>

    <!-- Premium Global Frameworks & Typography -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        :root {
            --brt-bg-cream: #FFFDF9;
            --brt-dark-navy: #0B0F19;
            --brt-gold-pure: #B38F43;
            --brt-gold-bg: #FBF4E4;
            --nav-text-white: rgba(255, 255, 255, 0.85);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--brt-bg-cream);
            overflow-x: hidden;
            -webkit-tap-highlight-color: transparent;
        }

        /* Language Toggle Visibility Logic */
        .lang-ta-text { display: none !important; }
        .lang-en-text { display: inline-block; }

        body.lang-ta .lang-en-text { display: none !important; }
        body.lang-ta .lang-ta-text { display: inline-block !important; }

        /* ===================================================
           1. FLOATING APP HEADER (DESKTOP & MOBILE)
           =================================================== */
        .nav-wrapper-holder {
            position: sticky;
            top: 0;
            z-index: 1030;
            padding: 10px 0;
            background: rgba(255, 253, 249, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        .site-nav-premium {
            background-color: var(--brt-dark-navy) !important;
            padding: 8px 18px !important;
            border: 1px solid rgba(179, 143, 67, 0.3);
            border-radius: 50px;
            box-shadow: 0 8px 25px rgba(11, 15, 25, 0.15);
        }

        .brt-brand-logo-wrap {
            display: inline-block;
        }

        .nav-logo-graphic {
            max-height: 38px;
            width: auto;
            border-radius: 50px;
            border: 1px solid rgba(179, 143, 67, 0.2);
        }

        /* NAVIGATION INTERFACE LINKS */
        .site-nav-premium .nav-link {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--nav-text-white) !important;
            padding: 8px 16px !important;
            border-radius: 30px;
            transition: all 0.25s ease;
        }

        .site-nav-premium .nav-link:hover {
            color: #FFFFFF !important;
            background: rgba(255, 255, 255, 0.08);
        }

        /* DYNAMIC ON/OFF LANGUAGE TOGGLE SLIDER */
        .lang-switch-container {
            display: inline-flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(179, 143, 67, 0.4);
            padding: 2px;
            border-radius: 50px;
            position: relative;
            cursor: pointer;
            user-select: none;
            width: 96px;
            height: 34px;
            overflow: hidden;
        }

        .lang-option {
            font-size: 0.75rem;
            font-weight: 700;
            width: 50%;
            text-align: center;
            color: rgba(255, 255, 255, 0.8) !important;
            z-index: 2;
            line-height: 30px;
        }

        .lang-switch-container .active-slider {
            position: absolute;
            top: 2px;
            bottom: 2px;
            left: 2px;
            width: 45px;
            background: var(--brt-gold-pure);
            border-radius: 50px;
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            z-index: 1;
        }

        body.lang-ta .active-slider {
            transform: translateX(46px);
        }

        .lang-option.active {
            color: #0B0F19 !important;
        }

        /* ===================================================
           2. MOBILE APP BOTTOM NAVIGATION BAR (APP EXPERIENCE)
           =================================================== */
        .mobile-app-bottom-bar {
            display: none;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 64px;
            background: rgba(11, 15, 25, 0.95);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-top: 1px solid rgba(179, 143, 67, 0.3);
            z-index: 1040;
            padding: 0 10px;
            justify-content: space-around;
            align-items: center;
            box-shadow: 0 -10px 25px rgba(0,0,0,0.2);
        }

        .mobile-bar-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #9CA3AF;
            text-decoration: none;
            font-size: 0.68rem;
            font-weight: 600;
            gap: 2px;
            transition: color 0.2s ease;
        }

        .mobile-bar-item .material-symbols-outlined {
            font-size: 1.35rem;
        }

        .mobile-bar-item.active, .mobile-bar-item:hover {
            color: var(--brt-gold-pure);
        }

        /* ===================================================
           3. NATIVE MOBILE APP UX RESPONSIVE OVERRIDES
           =================================================== */
        @media (max-width: 991.98px) {
            body {
                padding-bottom: 70px; /* Space for Mobile Bottom Bar */
            }

            .mobile-app-bottom-bar {
                display: flex;
            }

            .site-nav-premium {
                border-radius: 20px !important;
                padding: 10px 16px !important;
            }

            .navbar-collapse {
                background: #0B0F19;
                border-radius: 16px;
                padding: 16px;
                margin-top: 10px;
                border: 1px solid rgba(179, 143, 67, 0.2);
            }

            .site-nav-premium .nav-link {
                padding: 10px 14px !important;
                border-radius: 10px;
            }

            /* Fix Mobile Layout & Prevent Cluttering / Overlapping */
            main .container {
                padding-left: 16px !important;
                padding-right: 16px !important;
            }

            /* Clean Card Spacing in Mobile App View */
            .card, .coverage-badge-pill, [class*="col-"] {
                margin-bottom: 12px;
            }

            /* Mobile Heading Optimization */
            h1, .h1 { font-size: 1.85rem !important; line-height: 1.25 !important; }
            h2, .h2 { font-size: 1.5rem !important; line-height: 1.3 !important; }
            h3, .h3 { font-size: 1.25rem !important; }
            p { font-size: 0.9rem !important; }

            /* Mobile App Grid Padding Cleanups */
            .row {
                --bs-gutter-x: 1rem;
                --bs-gutter-y: 1rem;
            }
        }

        /* ===================================================
           4. ARCHITECTURAL WAVE FOOTER
           =================================================== */
        .footer-wave-wrapper {
            position: relative;
            background-color: transparent;
            margin-top: 50px;
            line-height: 0;
        }

        .footer-wave-wrapper svg {
            position: relative;
            display: block;
            width: 100%;
            height: 50px;
        }

        .site-footer-premium {
            background-color: var(--brt-dark-navy);
            color: #F3F4F6;
            padding: 40px 0 30px 0;
        }

        .footer-heading-premium {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--brt-gold-pure);
            margin-bottom: 20px;
        }

        .footer-contact-item {
            display: flex;
            gap: 12px;
            font-size: 0.88rem;
            color: #9CA3AF;
            line-height: 1.5;
            margin-bottom: 14px;
        }

        .footer-contact-item span.icon {
            color: var(--brt-gold-pure);
            font-size: 1.1rem;
            flex-shrink: 0;
        }

        .footer-links-matrix a {
            font-size: 0.88rem;
            color: #9CA3AF;
            text-decoration: none;
            margin-bottom: 10px;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
        }

        .footer-links-matrix a:hover {
            color: #FFFFFF;
        }

        .coverage-badge-pill {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: 16px;
            font-size: 0.85rem;
            color: #9CA3AF;
            line-height: 1.5;
        }

        .footer-divider-thin {
            border-top: 1px solid rgba(255, 255, 255, 0.06);
            margin: 30px 0 20px 0;
        }

        .footer-logo-graphic {
            max-width: 140px;
            height: auto;
            border-radius: 8px;
            border: 1px solid rgba(179, 143, 67, 0.2);
        }
    </style>
</head>
<body>

    <!-- ===================================================
         1. HEADER ZONE (FLOATING CAPSULE NAVBAR)
         =================================================== -->
    <div class="nav-wrapper-holder">
        <div class="container">
            <nav class="navbar navbar-expand-lg navbar-dark site-nav-premium">
                <a class="brt-brand-logo-wrap" asp-controller="Home" asp-action="Index">
                    <img src="~/images/brt-logo.jpeg" alt="B Raj Traders Logo" class="nav-logo-graphic" />
                </a>

                <div class="d-flex align-items-center gap-2 ms-auto d-lg-none">
                    <!-- Mobile View Direct Language Switcher -->
                    <div class="lang-switch-container" onclick="toggleLanguage()">
                        <div class="active-slider"></div>
                        <div class="lang-option active" id="optENMobile">EN</div>
                        <div class="lang-option" id="optTNMobile">தமிழ்</div>
                    </div>

                    <button class="navbar-toggler border-0 p-1" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                        <span class="material-symbols-outlined text-white" style="font-size: 1.8rem;">menu</span>
                    </button>
                </div>

                <div class="collapse navbar-collapse" id="navMain">
                    <ul class="navbar-nav ms-auto align-items-start align-items-lg-center gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <span class="lang-en-text">Home</span>
                                <span class="lang-ta-text">முகப்பு</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">
                                <span class="lang-en-text">About Us</span>
                                <span class="lang-ta-text">எங்களைப் பற்றி</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="WhyChooseUs">
                                <span class="lang-en-text">Why Choose Us</span>
                                <span class="lang-ta-text">ஏன் எங்களை தேர்வு செய்ய வேண்டும்</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Catalog" asp-action="Index">
                                <span class="lang-en-text">Wholesale Products</span>
                                <span class="lang-ta-text">மொத்த விற்பனை பொருட்கள்</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Catalog" asp-action="Loose">
                                <span class="lang-en-text">Retail Products</span>
                                <span class="lang-ta-text">சில்லறை விற்பனை பொருட்கள்</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Contact" asp-action="Index">
                                <span class="lang-en-text">Contact</span>
                                <span class="lang-ta-text">தொடர்பு கொள்ள</span>
                            </a>
                        </li>

                        <!-- Desktop Language Switcher -->
                        <li class="nav-item d-none d-lg-block">
                            <div class="lang-switch-container" onclick="toggleLanguage()">
                                <div class="active-slider"></div>
                                <div class="lang-option active" id="optEN">EN</div>
                                <div class="lang-option" id="optTN">தமிழ்</div>
                            </div>
                        </li>
                    </ul>
                </div>
            </nav>
        </div>
    </div>

    <!-- ===================================================
         2. CORE MAIN PAGE CONTENT
         =================================================== -->
    <main>
        @RenderBody()
    </main>

    <!-- ===================================================
         3. MOBILE APP BOTTOM NAVIGATION BAR
         =================================================== -->
    <div class="mobile-app-bottom-bar">
        <a asp-controller="Home" asp-action="Index" class="mobile-bar-item active">
            <span class="material-symbols-outlined">home</span>
            <span class="lang-en-text">Home</span>
            <span class="lang-ta-text">முகப்பு</span>
        </a>
        <a asp-controller="Catalog" asp-action="Index" class="mobile-bar-item">
            <span class="material-symbols-outlined">inventory_2</span>
            <span class="lang-en-text">Wholesale</span>
            <span class="lang-ta-text">மொத்தவிற்பனை</span>
        </a>
        <a asp-controller="Catalog" asp-action="Loose" class="mobile-bar-item">
            <span class="material-symbols-outlined">shopping_bag</span>
            <span class="lang-en-text">Retail</span>
            <span class="lang-ta-text">சில்லறை</span>
        </a>
        <a asp-controller="Order" asp-action="Request" class="mobile-bar-item" style="color: var(--brt-gold-pure);">
            <span class="material-symbols-outlined">add_shopping_cart</span>
            <span class="lang-en-text">Order</span>
            <span class="lang-ta-text">ஆர்டர்</span>
        </a>
        <a asp-controller="Contact" asp-action="Index" class="mobile-bar-item">
            <span class="material-symbols-outlined">call</span>
            <span class="lang-en-text">Contact</span>
            <span class="lang-ta-text">தொடர்பு</span>
        </a>
    </div>

    <!-- ===================================================
         4. FOOTER ZONE
         =================================================== -->
    <div class="footer-wave-wrapper">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 100" preserveAspectRatio="none">
            <path fill="#0B0F19" fill-opacity="1" d="M0,64L60,58.7C120,53,240,43,360,48C480,53,600,75,720,74.7C840,75,960,53,1080,42.7C1200,32,1320,32,1380,32L1440,32L1440,100L1380,100C1320,100,1200,100,1080,100C960,100,840,100,720,100C240,100,120,100,60,100L0,100Z"></path>
        </svg>
    </div>

    <footer class="site-footer-premium">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-3 col-md-4 text-center text-md-start">
                    <div class="mb-3">
                        <a asp-controller="Home" asp-action="Index" class="d-inline-block">
                            <img src="~/images/brt-logo.jpeg" alt="B Raj Traders Logo" class="footer-logo-graphic" />
                        </a>
                    </div>
                    <p style="font-size:0.82rem; color:#6B7280; line-height:1.6;" class="mt-2">
                        <span class="lang-en-text">Your trusted supply and trading partner providing quality commodities since 2000.</span>
                        <span class="lang-ta-text">2000 ஆம் ஆண்டு முதல் உயர்தர பொருட்களை வழங்கும் உங்கள் நம்பிக்கையான வணிக பங்குதாரர்.</span>
                    </p>
                </div>

                <div class="col-lg-3 col-md-4">
                    <h6 class="footer-heading-premium">
                        <span class="lang-en-text">Contact Info</span>
                        <span class="lang-ta-text">தொடர்பு விவரங்கள்</span>
                    </h6>
                    <div class="footer-contact-item">
                        <span class="material-symbols-outlined icon">location_on</span>
                        <span>B Raj Traders, TCA complex, Periyakulam road, Vadugapatti, Tamil Nadu 625603</span>
                    </div>
                    <div class="footer-contact-item">
                        <span class="material-symbols-outlined icon">call</span>
                        <span>+91 98656 80694</span>
                    </div>
                    <div class="footer-contact-item mb-0">
                        <span class="material-symbols-outlined icon">mail</span>
                        <span style="word-break: break-all;">brajtraders2000@gmail.com</span>
                    </div>
                </div>

                <div class="col-lg-3 col-md-4">
                    <h6 class="footer-heading-premium">
                        <span class="lang-en-text">Quick Links</span>
                        <span class="lang-ta-text">விரைவு இணைப்புகள்</span>
                    </h6>
                    <div class="d-flex flex-column footer-links-matrix">
                        <a asp-controller="Home" asp-action="About">
                            <span class="lang-en-text">About Us</span>
                            <span class="lang-ta-text">எங்களைப் பற்றி</span>
                        </a>
                        <a asp-controller="Catalog" asp-action="Index">
                            <span class="lang-en-text">Wholesale Products</span>
                            <span class="lang-ta-text">மொத்த விற்பனை பொருட்கள்</span>
                        </a>
                        <a asp-controller="Catalog" asp-action="Loose">
                            <span class="lang-en-text">Retail Products</span>
                            <span class="lang-ta-text">சில்லறை விற்பனை பொருட்கள்</span>
                        </a>
                        <a asp-controller="Contact" asp-action="Index">
                            <span class="lang-en-text">Contact Us</span>
                            <span class="lang-ta-text">தொடர்பு கொள்ள</span>
                        </a>
                    </div>
                </div>

                <div class="col-lg-3 col-md-12">
                    <h6 class="footer-heading-premium">
                        <span class="lang-en-text">Service Coverage</span>
                        <span class="lang-ta-text">சேவை பகுதிகள்</span>
                    </h6>
                    <div class="coverage-badge-pill">
                        <div class="d-flex align-items-center gap-2 mb-2" style="color: #FFFFFF; font-weight:600; font-size:0.82rem;">
                            <span class="material-symbols-outlined" style="color:var(--brt-gold-pure); font-size:1rem;">local_shipping</span>
                            <span class="lang-en-text">PAN INDIA LOGISTICS</span>
                            <span class="lang-ta-text">இந்தியா முழுவதும் விநியோகம்</span>
                        </div>
                        <span class="lang-en-text">Daily dispatch routes covering Pondicherry and over 15+ primary districts across Tamil Nadu.</span>
                        <span class="lang-ta-text">புதுச்சேரி மற்றும் தமிழ்நாட்டின் 15+ மாவட்டங்கள் உட்பட தினமும் பொருட்கள் அனுப்பி வைக்கப்படுகின்றன.</span>
                    </div>
                </div>
            </div>

            <div class="footer-divider-thin"></div>
            <div class="text-center">
                <div style="font-size: 0.72rem; color: #4B5563; font-weight: 500;">
                    &copy; @DateTime.Now.Year B Raj Traders. All Rights Reserved.
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap Core Script -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Global Language Switcher Script -->
    <script>
        function toggleLanguage() {
            document.body.classList.toggle('lang-ta');
            const isTamil = document.body.classList.contains('lang-ta');
            localStorage.setItem('brt_lang', isTamil ? 'ta' : 'en');
            updateToggleActiveState(isTamil);
        }

        function updateToggleActiveState(isTamil) {
            const optEN = document.getElementById('optEN');
            const optTN = document.getElementById('optTN');
            const optENMobile = document.getElementById('optENMobile');
            const optTNMobile = document.getElementById('optTNMobile');

            if (isTamil) {
                if (optEN) optEN.classList.remove('active');
                if (optTN) optTN.classList.add('active');
                if (optENMobile) optENMobile.classList.remove('active');
                if (optTNMobile) optTNMobile.classList.add('active');
            } else {
                if (optTN) optTN.classList.remove('active');
                if (optEN) optEN.classList.add('active');
                if (optTNMobile) optTNMobile.classList.remove('active');
                if (optENMobile) optENMobile.classList.add('active');
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const savedLang = localStorage.getItem('brt_lang');
            if (savedLang === 'ta') {
                document.body.classList.add('lang-ta');
                updateToggleActiveState(true);
            } else {
                updateToggleActiveState(false);
            }
        });
    </script>
</body>
</html>
