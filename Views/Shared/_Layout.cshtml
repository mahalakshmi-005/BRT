<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
    <title>@ViewData["Title"] - B Raj Traders</title>

    <!-- Premium Frameworks & App Typography -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        :root {
            --brt-bg-cream: #FFFDF9;
            --brt-dark-navy: #0D131F;
            --brt-navy-card: #141C2B;
            --brt-gold-pure: #D4AF37;
            --brt-gold-glow: rgba(212, 175, 55, 0.25);
            --nav-text-white: rgba(255, 255, 255, 0.9);
            --app-bottom-nav-height: 65px;
        }

        /* App Base Styles */
        html, body {
            width: 100%;
            max-width: 100%;
            overflow-x: hidden;
            background-color: var(--brt-bg-cream);
            font-family: 'Plus Jakarta Sans', sans-serif;
            -webkit-tap-highlight-color: transparent;
            touch-action: manipulation;
        }

        /* Padding bottom for Native Bottom Bar fit */
        body {
            padding-bottom: calc(var(--app-bottom-nav-height) + 15px);
        }

        /* Multi-language Logic */
        .lang-ta-text { display: none !important; }
        .lang-en-text { display: inline-block; }
        body.lang-ta .lang-en-text { display: none !important; }
        body.lang-ta .lang-ta-text { display: inline-block !important; }

        /* ===================================================
           1. MODERN APP TOP HEADER (Glassmorphic Floating Bar)
           =================================================== */
        .app-top-header-wrapper {
            position: sticky;
            top: 0;
            z-index: 1040;
            padding: 10px 12px;
            background: rgba(255, 253, 249, 0.85);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid rgba(13, 19, 31, 0.05);
        }

        .app-nav-container {
            background-color: var(--brt-dark-navy) !important;
            padding: 8px 16px !important;
            border-radius: 28px;
            box-shadow: 0 10px 30px rgba(13, 19, 31, 0.25), 0 0 15px rgba(212, 175, 55, 0.15);
            border: 1px solid rgba(212, 175, 55, 0.3);
        }

        .brt-brand-logo-wrap {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .nav-logo-graphic {
            max-height: 38px;
            width: auto;
            border-radius: 12px;
            border: 1px solid rgba(212, 175, 55, 0.3);
            object-fit: cover;
        }

        .brand-text-badge {
            color: #FFFFFF;
            font-weight: 800;
            font-size: 0.95rem;
            letter-spacing: -0.2px;
            line-height: 1.1;
        }
        .brand-text-badge span {
            color: var(--brt-gold-pure);
            font-size: 0.75rem;
            display: block;
            font-weight: 600;
        }

        /* NAV LINKS FOR MENU EXPAND */
        .app-nav-container .nav-link {
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--nav-text-white) !important;
            padding: 10px 16px !important;
            border-radius: 18px;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .app-nav-container .nav-link:hover, 
        .app-nav-container .nav-link:active {
            color: #FFFFFF !important;
            background: rgba(212, 175, 55, 0.15);
            transform: translateX(4px);
        }

        /* APP LANGUAGE TOGGLE SWITCH */
        .lang-switch-container {
            display: inline-flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(212, 175, 55, 0.4);
            padding: 2px;
            border-radius: 50px;
            position: relative;
            cursor: pointer;
            user-select: none;
            width: 90px;
            height: 34px;
            overflow: hidden;
        }

        .lang-option {
            font-size: 0.72rem;
            font-weight: 700;
            width: 50%;
            text-align: center;
            color: rgba(255, 255, 255, 0.75) !important;
            border-radius: 50px;
            transition: color 0.3s ease;
            z-index: 2;
            line-height: 30px;
        }

        .lang-switch-container .active-slider {
            position: absolute;
            top: 2px;
            bottom: 2px;
            left: 2px;
            width: 43px;
            background: var(--brt-gold-pure);
            border-radius: 50px;
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            z-index: 1;
        }

        body.lang-ta .active-slider {
            transform: translateX(43px);
        }

        .lang-option.active {
            color: #0D131F !important;
        }

        /* ===================================================
           2. MOBILE APP BOTTOM NAVIGATION BAR (App Feel)
           =================================================== */
        .app-bottom-nav {
            position: fixed;
            bottom: 10px;
            left: 50%;
            transform: translateX(-50%);
            width: calc(100% - 24px);
            max-width: 480px;
            height: var(--app-bottom-nav-height);
            background: rgba(13, 19, 31, 0.92);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-radius: 35px;
            border: 1px solid rgba(212, 175, 55, 0.35);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35), 0 0 20px var(--brt-gold-glow);
            z-index: 1050;
            display: flex;
            align-items: center;
            justify-content: space-around;
            padding: 0 8px;
        }

        .app-bottom-nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: rgba(255, 255, 255, 0.65);
            text-decoration: none;
            font-size: 0.68rem;
            font-weight: 600;
            transition: all 0.2s ease;
            width: 20%;
            text-align: center;
        }

        .app-bottom-nav-item span.material-symbols-outlined {
            font-size: 1.35rem;
            margin-bottom: 2px;
            transition: transform 0.2s ease;
        }

        .app-bottom-nav-item:active,
        .app-bottom-nav-item:hover {
            color: var(--brt-gold-pure);
        }

        .app-bottom-nav-item:active span.material-symbols-outlined {
            transform: scale(1.15);
        }

        /* Action Badge Callout Button */
        .app-bottom-cta {
            background: linear-gradient(135deg, #D4AF37 0%, #C59B27 100%);
            color: #0D131F !important;
            padding: 8px;
            border-radius: 50%;
            margin-top: -20px;
            box-shadow: 0 6px 16px rgba(212, 175, 55, 0.4);
            border: 3px solid var(--brt-dark-navy);
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .app-bottom-cta span.material-symbols-outlined {
            font-size: 1.5rem !important;
            margin-bottom: 0 !important;
            color: #0D131F !important;
        }

        /* ===================================================
           3. FOOTER UI REDESIGN (App Card Aesthetic)
           =================================================== */
        .app-footer-card {
            background-color: var(--brt-dark-navy);
            color: #F3F4F6;
            border-radius: 30px;
            padding: 30px 20px 25px 20px;
            margin: 40px 12px 15px 12px;
            border: 1px solid rgba(212, 175, 55, 0.2);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
        }

        .footer-heading-premium {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: var(--brt-gold-pure);
            margin-bottom: 16px;
        }

        .footer-contact-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            font-size: 0.85rem;
            color: #9CA3AF;
            line-height: 1.5;
            margin-bottom: 14px;
        }

        .footer-contact-item span.icon {
            color: var(--brt-gold-pure);
            font-size: 1.1rem;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .footer-links-matrix a {
            font-size: 0.88rem;
            color: #9CA3AF;
            text-decoration: none;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s ease;
        }

        .footer-links-matrix a:active,
        .footer-links-matrix a:hover {
            color: #FFFFFF;
            transform: translateX(4px);
        }

        .coverage-badge-pill {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 16px;
            font-size: 0.82rem;
            color: #9CA3AF;
            line-height: 1.5;
        }

        .footer-logo-graphic {
            max-width: 130px;
            height: auto;
            border-radius: 12px;
            border: 1px solid rgba(212, 175, 55, 0.3);
        }

        /* Desktop Adjustments */
        @media (min-width: 992px) {
            .app-bottom-nav {
                display: none; /* Hide bottom navigation bar on big desktop views */
            }
            body {
                padding-bottom: 0px;
            }
            .app-footer-card {
                margin: 60px auto 30px auto;
                max-width: 1280px;
                padding: 45px;
            }
        }
    </style>
</head>
<body>

    <!-- ===================================================
         1. TOP HEADER (Floating App Bar)
         =================================================== -->
    <header class="app-top-header-wrapper">
        <div class="container-fluid max-w-xl p-0">
            <nav class="navbar navbar-expand-lg navbar-dark app-nav-container">
                <div class="container-fluid p-0 d-flex align-items-center justify-content-between">
                    
                    <!-- App Logo & Title Area -->
                    <a class="brt-brand-logo-wrap" asp-controller="Home" asp-action="Index">
                        <img src="~/images/brt-logo.jpeg" alt="B Raj Traders Logo" class="nav-logo-graphic" />
