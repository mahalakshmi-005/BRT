                                    <span class="lang-en-text">About Us</span>
                                    <span class="lang-ta-text">எங்களைப் பற்றி</span>
                                </a>
                            </li>
                            <li class="nav-item w-100 w-lg-auto">
                                <a class="nav-link" asp-controller="Home" asp-action="WhyChooseUs">
                                    <span class="material-symbols-outlined fs-5 text-gold d-lg-none">verified</span>
                                    <span class="lang-en-text">Why Choose Us</span>
                                    <span class="lang-ta-text">ஏன் எங்களை தேர்வு செய்ய வேண்டும்</span>
                                </a>
                            </li>
                            <li class="nav-item w-100 w-lg-auto">
                                <a class="nav-link" asp-controller="Catalog" asp-action="Index">
                                    <span class="material-symbols-outlined fs-5 text-gold d-lg-none">storefront</span>
                                    <span class="lang-en-text">Wholesale Products</span>
                                    <span class="lang-ta-text">மொத்த விற்பனை பொருட்கள்</span>
                                </a>
                            </li>
                            <li class="nav-item w-100 w-lg-auto">
                                <a class="nav-link" asp-controller="Catalog" asp-action="Loose">
                                    <span class="material-symbols-outlined fs-5 text-gold d-lg-none">inventory_2</span>
                                    <span class="lang-en-text">Retail Products</span>
                                    <span class="lang-ta-text">சில்லறை விற்பனை பொருட்கள்</span>
                                </a>
                            </li>
                            <li class="nav-item w-100 w-lg-auto">
                                <a class="nav-link" asp-controller="Contact" asp-action="Index">
                                    <span class="material-symbols-outlined fs-5 text-gold d-lg-none">call</span>
                                    <span class="lang-en-text">Contact</span>
                                    <span class="lang-ta-text">தொடர்பு கொள்ள</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                </div>
            </nav>
        </div>
    </header>

    <!-- ===================================================
         2. MAIN BODY CONTENT ROUTER
         =================================================== -->
    <main role="main" class="pb-2">
        @RenderBody()
    </main>

    <!-- ===================================================
         3. MOBILE APP BOTTOM NAVIGATION BAR
         =================================================== -->
    <div class="app-bottom-nav">
        <a asp-controller="Home" asp-action="Index" class="app-bottom-nav-item">
            <span class="material-symbols-outlined">home</span>
            <span class="lang-en-text">Home</span>
            <span class="lang-ta-text">முகப்பு</span>
        </a>
        <a asp-controller="Catalog" asp-action="Index" class="app-bottom-nav-item">
