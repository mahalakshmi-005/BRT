            <!-- Section A: Identity Space -->
            <div class="col-12 col-md-3 text-center text-md-start">
                <div class="mb-2">
                    <a asp-controller="Home" asp-action="Index" class="d-inline-block">
                        <img src="~/images/brt-logo.jpeg" alt="B Raj Traders Logo" class="footer-logo-graphic" />
                    </a>
                </div>
                <p style="font-size:0.82rem; color:#9CA3AF; line-height:1.5;" class="mt-2 mb-0">
                    <span class="lang-en-text">Your trusted supply and trading partner providing quality commodities since 2000.</span>
                    <span class="lang-ta-text">2000 ஆம் ஆண்டு முதல் உயர்தர பொருட்களை வழங்கும் உங்கள் நம்பிக்கையான வணிக பங்குதாரர்.</span>
                </p>
            </div>

            <!-- Section B: Direct Infrastructure -->
            <div class="col-12 col-md-3">
                <h6 class="footer-heading-premium">
                    <span class="lang-en-text">Contact Infrastructure</span>
                    <span class="lang-ta-text">தொடர்பு விவரங்கள்</span>
                </h6>
                <div class="footer-contact-item">
                    <span class="material-symbols-outlined icon">location_on</span>
                    <span>B Raj Traders, TCA complex, Periyakulam road, Vadugapatti, Tamil Nadu 625603</span>
                </div>
                <div class="footer-contact-item">
                    <span class="material-symbols-outlined icon">call</span>
                    <span>+91 98656 80694</span>
                </div>
                <div class="footer-contact-item mb-0">
                    <span class="material-symbols-outlined icon">mail</span>
                    <span style="word-break: break-all;">brajtraders2000@gmail.com</span>
                </div>
            </div>

            <!-- Section C: Quick Navigation Links -->
            <div class="col-12 col-md-3">
                <h6 class="footer-heading-premium">
                    <span class="lang-en-text">Quick Actions</span>
                    <span class="lang-ta-text">விரைவு இணைப்புகள்</span>
                </h6>
                <div class="footer-links-matrix">
                    <a asp-controller="Home" asp-action="About">
                        <span class="material-symbols-outlined fs-6">chevron_right</span>
                        <span class="lang-en-text">About Us</span>
                        <span class="lang-ta-text">எங்களைப் பற்றி</span>
                    </a>
                    <a asp-controller="Home" asp-action="WhyChooseUs">
                        <span class="material-symbols-outlined fs-6">chevron_right</span>
                        <span class="lang-en-text">Why Choose Us</span>
                        <span class="lang-ta-text">ஏன் எங்களை தேர்வு செய்ய வேண்டும்</span>
                    </a>
                    <a asp-controller="Catalog" asp-action="Index">
                        <span class="material-symbols-outlined fs-6">chevron_right</span>
                        <span class="lang-en-text">Wholesale Products</span>
                        <span class="lang-ta-text">மொத்த விற்பனை பொருட்கள்</span>
                    </a>
                    <a asp-controller="Catalog" asp-action="Loose">
                        <span class="material-symbols-outlined fs-6">chevron_right</span>
                        <span class="lang-en-text">Retail Products</span>
                        <span class="lang-ta-text">சில்லறை விற்பனை பொருட்கள்</span>
                    </a>
                    <a asp-controller="Order" asp-action="Request" style="color: var(--brt-gold-pure); font-weight:700;">
                        <span class="material-symbols-outlined fs-6">shopping_bag</span>
                        <span class="lang-en-text">Request Bulk Order</span>
                        <span class="lang-ta-text">மொத்த ஆர்டர் செய்ய</span>
                    </a>
                    <a asp-controller="Contact" asp-action="Index">
                        <span class="material-symbols-outlined fs-6">chevron_right</span>
                        <span class="lang-en-text">Contact Us</span>
                        <span class="lang-ta-text">தொடர்பு கொள்ள</span>
                    </a>
                </div>
            </div>

            <!-- Section D: Coverage Area Badge -->
            <div class="col-12 col-md-3">
                <h6 class="footer-heading-premium">
                    <span class="lang-en-text">Service Coverage Map</span>
                    <span class="lang-ta-text">சேவை பகுதிகள்</span>
                </h6>
                <div class="coverage-badge-pill">
                    <div class="d-flex align-items-center gap-2 mb-2" style="color: #FFFFFF; font-weight:700; font-size:0.82rem;">
                        <span class="material-symbols-outlined" style="color:var(--brt-gold-pure); font-size:1.1rem;">local_shipping</span>
                        <span class="lang-en-text">PAN INDIA LOGISTICS</span>
                        <span class="lang-ta-text">இந்தியா முழுவதும் விநியோகம்</span>
                    </div>
                    <span class="lang-en-text">Supplying across mainland India, with highly optimized daily dispatch routes covering Pondicherry and over 15+ primary districts across Tamil Nadu.</span>
                    <span class="lang-ta-text">புதுச்சேரி மற்றும் தமிழ்நாட்டின் 15+ மாவட்டங்கள் உட்பட இந்தியா முழுவதும் தினமும் பொருட்கள் அனுப்பி வைக்கப்படுகின்றன.</span>
                </div>
            </div>

        </div>

        <hr class="my-4" style="border-color: rgba(255, 255, 255, 0.1);" />
        
        <div class="text-center" style="font-size: 0.72rem; color: #6B7280; font-weight: 500;">
            &copy; @DateTime.Now.Year B Raj Traders. All Rights Preserved.
        </div>
    </footer>

    <!-- Bootstrap Core Script Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Global Language Toggle Mechanism Script -->
    <script>
        function toggleLanguage() {
            document.body.classList.toggle('lang-ta');
            const isTamil = document.body.classList.contains('lang-ta');
            localStorage.setItem('brt_lang', isTamil ? 'ta' : 'en');
            updateToggleActiveState(isTamil);
        }

        function updateToggleActiveState(isTamil) {
            const optEN = document.getElementById('optEN');
            const optTN = document.getElementById('optTN');
            if (isTamil) {
                optEN.classList.remove('active');
                optTN.classList.add('active');
            } else {
                optTN.classList.remove('active');
                optEN.classList.add('active');
            }
        }

        // On Page Load - Restore Selected Language
        document.addEventListener('DOMContentLoaded', () => {
            const savedLang = localStorage.getItem('brt_lang');
            if (savedLang === 'ta') {
                document.body.classList.add('lang-ta');
                updateToggleActiveState(true);
            } else {
                updateToggleActiveState(false);
            }
        });
    </script>
</body>
</html>
