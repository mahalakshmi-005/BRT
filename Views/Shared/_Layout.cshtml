                        </button>
                    </div>

                    <!-- Collapsible Full Menu -->
                    <div class="collapse navbar-collapse mt-3 mt-lg-0" id="navMain">
                        <ul class="navbar-nav ms-auto align-items-start align-items-lg-center gap-1 pt-2 pt-lg-0 border-top border-secondary border-opacity-25 border-lg-0">
                            <li class="nav-item w-100 w-lg-auto">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">
                                    <span class="material-symbols-outlined fs-5 text-gold d-lg-none">home</span>
                                    <span class="lang-en-text">Home</span>
                                    <span class="lang-ta-text">முகப்பு</span>
